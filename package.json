{
  "name": "ds-hd",
  "version": "0.1.0",
  "private": true,
  "description": "CRM DATTASOFT reconstruido con arquitectura MVC + SOLID (Node + Express + TypeScript)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:assets",
    "build:assets": "node scripts/build-assets.mjs",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:roles": "tsx scripts/seed/seed-roles.ts",
    "seed:demo": "tsx scripts/seed/seed-demo.ts",
    "migrate": "tsx scripts/migrate/run-all.ts",
    "migrate:verify": "tsx scripts/migrate/99-verify-migration.ts",
    "docs": "tsx scripts/docs/generate-readme.ts",
    "docs:check": "tsx scripts/docs/generate-readme.ts --check",
    "healthcheck": "node dist/scripts/healthcheck.js"
  },
  "dependencies": {
    "alpinejs": "^3.14.9",
    "awilix": "^12.0.5",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "htmx.org": "^2.0.4",
    "marked": "^15.0.7",
    "nodemailer": "^6.10.0",
    "nunjucks": "^3.2.4",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/compression": "^1.8.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/nunjucks": "^3.2.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.30.0",
    "globals": "^16.2.0",
    "pino-pretty": "^13.0.0",
    "playwright-core": "^1.49.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true
  }
}
