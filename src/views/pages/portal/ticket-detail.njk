{% extends "layouts/portal.njk" %}
{% import "components/tickets.njk" as tk %}
{% block title %}Ticket #{{ ticket.numero }}{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>#{{ ticket.numero }} — {{ ticket.asunto }}</h1>
    <a class="btn btn--sm btn--ghost" href="/portal/tickets">← Mis tickets</a>
  </div>

  <p>
    <span class="{{ ticket.estado | estadoClase }}">{{ ticket.estado }}</span>
    <span class="muted">Prioridad</span> <span class="{{ ticket.prioridad | prioridadClase }}">{{ ticket.prioridad }}</span>
  </p>

  {# Conversación tipo chat: lo tuyo a la derecha, el equipo de soporte a la izquierda. #}
  <div class="card chat">
    <p class="chat__titulo"><strong>💬 Conversación</strong></p>
    <div class="chat__hilo" data-chat-hilo>
      <div class="chat__msg chat__msg--equipo">
        <div class="chat__meta"><span class="chat__autor">Tú</span> <span class="badge">tu solicitud</span></div>
        <div class="chat__cuerpo">{{ descripcionHtml | safe }}</div>
        <div class="chat__hora">{{ (ticket.abiertoEn or ticket.createdAt) | fechahora }}</div>
      </div>
      {% for n in notas %}
        {% set mio = n.autorUid == user.uid or n.correoDe %}
        <div class="chat__msg {{ 'chat__msg--equipo' if mio else 'chat__msg--cliente' }}">
          <div class="chat__meta"><span class="chat__autor">{{ 'Tú' if mio else n.autorNombre }}</span></div>
          <div class="chat__cuerpo">{{ n.cuerpo }}</div>
          <div class="chat__hora">{{ n.createdAt | fechahora }}</div>
        </div>
      {% else %}
        <p class="muted chat__vacio">Aún no hay respuestas. El equipo de soporte te contactará pronto.</p>
      {% endfor %}
    </div>

    {% if not ticket.esCerrado %}
      {% if errores.cuerpo %}<p class="alert alert--error">{{ errores.cuerpo }}</p>{% endif %}
      <form method="post" action="/portal/tickets/{{ ticket.id }}/responder" class="form chat__escribir">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <textarea name="cuerpo" rows="3" required placeholder="Escribe una respuesta…"></textarea>
        <div class="chat__acciones"><span></span><button class="btn btn--sm" type="submit">Enviar ➤</button></div>
      </form>
    {% else %}
      <p class="muted">Este ticket está cerrado. Si necesitas más ayuda, crea uno nuevo.</p>
    {% endif %}
  </div>

  {{ tk.adjuntosTicket(adjuntos, '/portal/tickets/' + ticket.id, csrfToken, not ticket.esCerrado) }}

  {% if eventos | length %}
    <div class="card">
      <p><strong>Seguimiento</strong></p>
      <ul class="timeline">
        {% for e in eventos %}<li><span class="muted">{{ e.at | fechahora }}</span> — {{ e.resumen }}</li>{% endfor %}
      </ul>
    </div>
  {% endif %}
{% endblock %}
