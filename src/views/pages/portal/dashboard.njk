{% extends "layouts/portal.njk" %}
{% block title %}Portal{% endblock %}
{% block content %}
  <h1>Bienvenido, {{ user.nombre }}</h1>
  <p class="muted">Desde aquí podrás crear y dar seguimiento a tus tickets de soporte (Fase 3).</p>
  <div class="card">
    <ul>
      {% for item in nav %}
        <li><a href="{{ item.href }}">{{ item.icono }} {{ item.etiqueta }}</a></li>
      {% endfor %}
    </ul>
  </div>
{% endblock %}
