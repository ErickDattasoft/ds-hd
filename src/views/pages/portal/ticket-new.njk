{% extends "layouts/portal.njk" %}
{% block title %}Nuevo ticket{% endblock %}
{% block content %}
  <h1>Nuevo ticket</h1>
  {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}
  <form method="post" action="/portal/tickets" class="form">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    {% if empresas and empresas.length > 1 %}
      <label class="field"><span>¿Para qué empresa es?</span>
        <select name="empresaId" required>
          {% for e in empresas %}<option value="{{ e.id }}"{{ ' selected' if e.id == valores.empresaId }}>{{ e.nombre }}</option>{% endfor %}
        </select>
        {% if errores.empresaId %}<em class="field__error">{{ errores.empresaId }}</em>{% endif %}
      </label>
    {% endif %}
    <label class="field"><span>Asunto</span>
      <input name="asunto" value="{{ valores.asunto }}" required />
      {% if errores.asunto %}<em class="field__error">{{ errores.asunto }}</em>{% endif %}
    </label>
    <label class="field"><span>¿Qué está pasando?</span>
      <textarea name="descripcion" rows="10" required>{{ valores.descripcion }}</textarea>
      {% if errores.descripcion %}<em class="field__error">{{ errores.descripcion }}</em>{% endif %}
    </label>
    <label class="field"><span>Prioridad</span>
      <select name="prioridad">{% for p in prioridades %}<option {{ 'selected' if valores.prioridad == p }}>{{ p }}</option>{% endfor %}</select>
    </label>

    <details class="disclosure"{{ ' open' if valores.tipo or valores.sistema }}>
      <summary class="disclosure__summary">Más detalles <span class="disclosure__hint">— nos ayuda a atenderte más rápido</span></summary>
      <div class="disclosure__body form">
        <label class="field"><span>Tipo</span>
          <select name="tipo">{% for t in tipos %}<option {{ 'selected' if valores.tipo == t }}>{{ t }}</option>{% endfor %}</select>
        </label>
        <label class="field"><span>Sistema</span>
          <select name="sistema"><option value="">—</option>{% for s in sistemas %}<option {{ 'selected' if valores.sistema == s }}>{{ s }}</option>{% endfor %}</select>
        </label>
      </div>
    </details>

    <div class="page-head__actions">
      <button class="btn" type="submit">Enviar ticket</button>
      <a class="btn btn--ghost" href="/portal/tickets">Cancelar</a>
    </div>
  </form>
{% endblock %}
