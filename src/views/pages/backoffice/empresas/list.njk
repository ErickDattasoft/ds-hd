{% extends "layouts/backoffice.njk" %}
{% block title %}Empresas{% endblock %}
{% block content %}
  {% set qs %}?q={{ q }}&sistema={{ sistema }}{{ '&favoritas=1' if soloFavoritas }}{{ '&pendientes=1' if soloPendientes }}{{ '&archivadas=1' if incluirArchivadas }}{% endset %}
  <div class="page-head">
    <h1>Empresas</h1>
    <div class="page-head__actions">
      {% if can('empresas:leer') %}<a class="btn btn--ghost btn--sm" href="/app/empresas/exportar{{ '?q=' + q if q }}">Exportar Excel</a>{% endif %}
      {% if can('empresas:crear') %}<a class="btn btn--ghost btn--sm" href="/app/empresas/importar">Importar Excel</a>{% endif %}
      {% if can('empresas:crear') %}<a class="btn btn--sm" href="/app/empresas/nueva">Nueva empresa</a>{% endif %}
    </div>
  </div>
  <form method="get" class="filterbar">
    <input type="search" name="q" value="{{ q }}" placeholder="Buscar por nombre o RFC…" autocomplete="off" spellcheck="false" />
    <select name="sistema" aria-label="Sistema">
      <option value="">Cualquier sistema</option>
      {% for s in sistemasDisponibles %}<option value="{{ s }}" {{ 'selected' if sistema == s }}>{{ s }}</option>{% endfor %}
    </select>
    <label class="field--check"><input type="checkbox" name="favoritas" value="1" {{ 'checked' if soloFavoritas }} /> ⭐ solo favoritas</label>
    <label class="field--check"><input type="checkbox" name="archivadas" value="1" {{ 'checked' if incluirArchivadas }} /> incluir archivadas</label>
    <label class="field--check"><input type="checkbox" name="pendientes" value="1" {{ 'checked' if soloPendientes }} /> solo con pendientes (licencia o versión)</label>
    <button class="btn btn--sm" type="submit">Buscar</button>
  </form>

  {% if error %}<div class="alert alert--error" role="alert">{{ error }}</div>{% endif %}

  <div class="chips">
    {% for f in filtrosGuardados %}
      <span class="chip">
        <a href="/app/empresas?{{ f.query }}">{{ f.nombre }}</a>
        <button type="submit" form="delfiltro-{{ f.id }}" class="chip__x" title="Borrar filtro guardado" aria-label="Borrar {{ f.nombre }}">×</button>
      </span>
      <form id="delfiltro-{{ f.id }}" method="post" action="/app/filtros/{{ f.id }}/eliminar" hidden>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <input type="hidden" name="volver" value="/app/empresas{{ qs }}" />
      </form>
    {% endfor %}
    <form method="post" action="/app/filtros" class="chips__save">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <input type="hidden" name="modulo" value="empresas" />
      <input type="hidden" name="query" value="{{ qs }}" />
      <input type="hidden" name="volver" value="/app/empresas{{ qs }}" />
      <input type="text" name="nombre" placeholder="Guardar esta búsqueda como…" maxlength="40" />
      <button class="btn btn--sm btn--ghost" type="submit">Guardar filtro</button>
    </form>
  </div>

  {# Las acciones van ARRIBA de la tabla: operan sobre las casillas de las filas, y escritas
     después de la tabla quedaban a un scroll entero de las casillas que hay que marcar. El
     formulario sigue siendo el mismo (las casillas lo referencian por form="avisar-form", que
     funciona esté donde esté en la página). #}
  {% if can('empresas:editar') and filas | length %}
    <form id="avisar-form" method="post" action="/app/empresas/avisar" class="acciones-lote">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <span class="muted">Marca empresas en la lista y avísales:</span>
      <button class="btn btn--sm btn--secondary" type="submit" name="accion" value="versiones-correo">Avisar versiones (correo)</button>
      <button class="btn btn--sm btn--secondary" type="submit" name="accion" value="licencias-correo">Avisar licencias (correo)</button>
      <button class="btn btn--sm btn--ghost" type="submit" name="accion" value="versiones-whatsapp">Avisar versiones (WhatsApp)</button>
      <button class="btn btn--sm btn--ghost" type="submit" name="accion" value="licencias-whatsapp">Avisar licencias (WhatsApp)</button>
      {# Cuántas hay con algo pendiente, como en el CRM viejo: se ve si vale la pena abrirlos
         sin tener que filtrar primero, y cada uno lleva al listado ya filtrado. #}
      <span class="acciones-lote__conteos">
        <a href="/app/empresas?pendientes=1" class="badge {{ 'badge--danger' if conLicencias else '' }}">{{ conLicencias }} con licencias por vencer o vencidas</a>
        <a href="/app/empresas?pendientes=1" class="badge {{ 'badge--warning' if conVersiones else '' }}">{{ conVersiones }} con sistemas desactualizados</a>
      </span>
    </form>
  {% elif can('empresas:editar') %}
    <form id="avisar-form" method="post" action="/app/empresas/avisar" hidden>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    </form>
  {% endif %}

  <table class="data-table">
    <thead>
      <tr>
        {% if can('empresas:editar') %}<th></th><th aria-label="Favorita"></th>{% endif %}
        <th>Nombre</th><th>Contacto principal</th><th>Correo</th><th>RFC</th><th>Teléfono</th><th>Sistemas</th><th>Licencias</th><th>Versiones</th><th>Estado</th>
      </tr>
    </thead>
    <tbody>
      {% for fila in filas %}
        {% set e = fila.empresa %}
        <tr class="{{ 'tr-danger' if fila.vencidas }}" data-orden="{{ fila.orden }}" data-favorita="{{ 'true' if e.favorita else 'false' }}">
          {% if can('empresas:editar') %}
            <td><input type="checkbox" form="avisar-form" name="empresaIds" value="{{ e.id }}" aria-label="Seleccionar {{ e.nombre }}" /></td>
            <td>
              <button type="submit" form="fav-{{ e.id }}" class="star-btn" title="{{ 'Quitar de favoritas' if e.favorita else 'Marcar como favorita' }}"
                      aria-pressed="{{ 'true' if e.favorita else 'false' }}">{{ '⭐' if e.favorita else '☆' }}</button>
            </td>
          {% endif %}
          <td><a href="/app/empresas/{{ e.id }}">{{ e.nombre }}</a></td>
          <td>{{ fila.contactoPrincipal.nombre if fila.contactoPrincipal else '—' }}</td>
          <td>
            {% set correo = e.email or (fila.contactoPrincipal.email if fila.contactoPrincipal) %}
            {% if correo %}<a href="mailto:{{ correo }}" title="Escribir a {{ correo }}">{{ correo }}</a>{% else %}<span class="muted">—</span>{% endif %}
          </td>
          <td>{{ e.rfc or '—' }}</td>
          <td>{{ e.telefono or '—' }}</td>
          <td>{{ e.sistemasContratados | length }}</td>
          <td{% if fila.detalleLicencias %} title="{{ fila.detalleLicencias }}"{% endif %}>
            {% if fila.vencidas %}<span class="badge badge--danger">{{ fila.vencidas }} vencida{{ 's' if fila.vencidas != 1 }}</span>{% endif %}
            {% if fila.porVencer %}<span class="badge badge--warning">{{ fila.porVencer }} por vencer</span>{% endif %}
            {% if not fila.vencidas and not fila.porVencer %}<span class="muted">—</span>{% endif %}
          </td>
          <td>
            {% if fila.desactualizadas %}<span class="badge badge--warning">{{ fila.desactualizadas }} desactualizada{{ 's' if fila.desactualizadas != 1 }}</span>{% else %}<span class="muted">—</span>{% endif %}
          </td>
          <td style="white-space:nowrap">
            {{ 'Activa' if e.activa else 'Archivada' }}
            {% if can('empresas:eliminar') %}
              <button type="submit" form="arch-{{ e.id }}" class="star-btn"
                      aria-label="{{ 'Restaurar' if not e.activa else 'Archivar' }}"
                      title="{{ 'Restaurar esta empresa' if not e.activa else 'Archivar: deja de salir en la lista y en los avisos, y se puede restaurar' }}">{{ '♻️' if not e.activa else '🗄️' }}</button>
            {% endif %}
          </td>
        </tr>
      {% else %}<tr><td colspan="11" class="muted">📭 Sin empresas que coincidan.{% if can('empresas:crear') %} Ajusta la búsqueda o <a href="/app/empresas/nueva">crea una nueva</a>.{% endif %}</td></tr>{% endfor %}
    </tbody>
  </table>

  {% if can('empresas:editar') %}
    {% for fila in filas %}
      <form id="fav-{{ fila.empresa.id }}" method="post" action="/app/empresas/{{ fila.empresa.id }}/favorita" hx-boost="false" hidden>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <input type="hidden" name="favorita" value="{{ 'false' if fila.empresa.favorita else 'true' }}" />
        <input type="hidden" name="volver" value="/app/empresas{{ qs }}" />
      </form>
      {% if can('empresas:eliminar') %}
        {# Archivar sí recarga (a diferencia de favoritas): la empresa sale o entra en la lista
           según el filtro activo, así que la tabla tiene que volver a pintarse igual. #}
        <form id="arch-{{ fila.empresa.id }}" method="post" action="/app/empresas/{{ fila.empresa.id }}/archivar" hidden
              data-confirm="{{ '¿Restaurar ' + fila.empresa.nombre + '?' if not fila.empresa.activa else '¿Archivar ' + fila.empresa.nombre + '? Deja de salir en la lista y en los avisos. Se puede restaurar.' }}">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <input type="hidden" name="archivar" value="{{ 'false' if not fila.empresa.activa else 'true' }}" />
          <input type="hidden" name="volver" value="/app/empresas{{ qs }}" />
        </form>
      {% endif %}
    {% endfor %}
  {% endif %}
{% endblock %}
