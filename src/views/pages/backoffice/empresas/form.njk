{% extends "layouts/backoffice.njk" %}
{% block title %}{{ titulo }}{% endblock %}
{% block content %}
  <h1>{{ titulo }}</h1>
  {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}
  <form method="post" action="{{ '/app/empresas' if modo == 'crear' else '/app/empresas/' + empresa.id }}" class="form form--wide">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    <label class="field"><span>Nombre</span><input name="nombre" value="{{ valores.nombre }}" required />
      {% if errores.nombre %}<em class="field__error">{{ errores.nombre }}</em>{% endif %}</label>
    <label class="field"><span>Teléfono</span><input type="tel" inputmode="tel" name="telefono" value="{{ valores.telefono }}" /></label>
    <label class="field"><span>Correo</span><input type="email" name="email" autocomplete="email" value="{{ valores.email }}" /></label>

    <details class="disclosure"{{ ' open' if valores.rfc or valores.razonSocial or valores.direccion }}>
      <summary class="disclosure__summary">Datos fiscales</summary>
      <div class="disclosure__body form">
        <label class="field"><span>RFC</span><input name="rfc" value="{{ valores.rfc }}" /></label>
        <label class="field"><span>Razón social</span><input name="razonSocial" value="{{ valores.razonSocial }}" /></label>
        <label class="field"><span>Dirección</span><input name="direccion" value="{{ valores.direccion }}" /></label>
      </div>
    </details>

    <details class="disclosure"{{ ' open' if valores.sistemasContratados or valores.notas }}>
      <summary class="disclosure__summary">Sistemas y notas</summary>
      <div class="disclosure__body form">
        <label class="field"><span>Sistemas contratados (uno por línea)</span>
          <textarea name="sistemasContratados" rows="4" data-sistemas-textarea>{{ valores.sistemasContratados }}</textarea>
        </label>
        <label class="field"><span>Notas</span><textarea name="notas" rows="3">{{ valores.notas }}</textarea></label>
      </div>
    </details>

    <details class="disclosure" open>
      <summary class="disclosure__summary">Licencias y versiones por sistema <span class="disclosure__hint">— vencimiento y versión instalada de cada uno</span></summary>
      <div class="disclosure__body">
        <p class="muted">Se llena solo con los sistemas de arriba. Deja vacío lo que no aplique.</p>
        <table class="data-table" data-licencias-tabla
          data-vigencias='{{ (empresa.vigencias if empresa else {}) | dump }}'
          data-versiones='{{ (empresa.versionesInstaladas if empresa else {}) | dump }}'>
          <thead><tr><th data-no-ordenar>Sistema</th><th data-no-ordenar>Vence</th><th data-no-ordenar>Versión instalada</th></tr></thead>
          <tbody>
            {% for s in (empresa.sistemasContratados if empresa else []) %}
              <tr data-sistema="{{ s }}">
                <td>{{ s }}</td>
                <td><input type="date" name="vigencia:{{ s }}" value="{{ empresa.vigencias[s] or '' }}" /></td>
                <td><input type="text" name="version:{{ s }}" value="{{ empresa.versionesInstaladas[s] or '' }}" placeholder="ej. 16.3.1 SP2" /></td>
              </tr>
            {% else %}
              <tr><td colspan="3" class="muted">Agrega sistemas arriba.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </details>

    <details class="disclosure"{{ ' open' if (empresa.camposExtra | length) }}>
      <summary class="disclosure__summary">⚙️ Campos extra <span class="disclosure__hint">— datos personalizados de esta empresa</span></summary>
      <div class="disclosure__body" data-campos-extra>
        <table class="data-table">
          <thead><tr><th data-no-ordenar>Etiqueta</th><th data-no-ordenar>Valor</th><th data-no-ordenar></th></tr></thead>
          <tbody data-campos-extra-body>
            {% for c in (empresa.camposExtra if empresa else []) %}
              <tr>
                <td><input name="campoExtraEtiqueta" value="{{ c.etiqueta }}" placeholder="Ej: Contrato" /></td>
                <td><input name="campoExtraValor" value="{{ c.valor }}" /></td>
                <td><button type="button" class="btn btn--ghost btn--sm" data-quitar-fila>✕</button></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        <button type="button" class="btn btn--ghost btn--sm" data-agregar-campo-extra>➕ Añadir campo</button>
      </div>
    </details>

    <div class="page-head__actions">
      <button class="btn" type="submit">Guardar</button>
      <a class="btn btn--ghost" href="/app/empresas">Cancelar</a>
    </div>
  </form>
{% endblock %}
