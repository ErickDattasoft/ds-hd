{% extends "layouts/backoffice.njk" %}
{% block title %}{{ titulo }}{% endblock %}
{% block content %}
  <h1>{{ titulo }}</h1>
  {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}
  <form method="post" action="{{ '/app/empresas' if modo == 'crear' else '/app/empresas/' + empresa.id }}" class="form form--wide">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    <label class="field"><span>Nombre</span><input name="nombre" value="{{ valores.nombre }}" required />
      {% if errores.nombre %}<em class="field__error">{{ errores.nombre }}</em>{% endif %}</label>
    <label class="field"><span>RFC</span><input name="rfc" value="{{ valores.rfc }}" /></label>
    <label class="field"><span>Razón social</span><input name="razonSocial" value="{{ valores.razonSocial }}" /></label>
    <label class="field"><span>Dirección</span><input name="direccion" value="{{ valores.direccion }}" /></label>
    <label class="field"><span>Teléfono</span><input name="telefono" value="{{ valores.telefono }}" /></label>
    <label class="field"><span>Correo</span><input type="email" name="email" value="{{ valores.email }}" /></label>
    <label class="field"><span>Sistemas contratados (uno por línea)</span><textarea name="sistemasContratados" rows="4">{{ valores.sistemasContratados }}</textarea></label>
    <label class="field"><span>Notas</span><textarea name="notas" rows="3">{{ valores.notas }}</textarea></label>
    <button class="btn" type="submit">Guardar</button>
    <a class="btn btn--ghost" href="/app/empresas">Cancelar</a>
  </form>
{% endblock %}
