{% extends "layouts/backoffice.njk" %}
{% block title %}{{ empresa.nombre }}{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>{{ empresa.nombre }} {% if not empresa.activa %}<span class="badge">archivada</span>{% endif %}</h1>
    <div class="page-head__actions">
      {% if can('empresas:editar') %}<a class="btn btn--sm" href="/app/empresas/{{ empresa.id }}/editar">Editar</a>{% endif %}
      {% if can('contactos:crear') %}<a class="btn btn--sm btn--secondary" href="/app/contactos/nuevo?empresa={{ empresa.id }}">Agregar contacto</a>{% endif %}
    </div>
  </div>

  <div class="card">
    <p><strong>RFC:</strong> {{ empresa.rfc or '—' }} · <strong>Tel:</strong> {{ empresa.telefono or '—' }} · <strong>Correo:</strong> {{ empresa.email or '—' }}</p>
    {% if empresa.direccion %}<p>{{ empresa.direccion }}</p>{% endif %}
    {% if empresa.sistemasContratados | length %}<p><strong>Sistemas:</strong> {{ empresa.sistemasContratados | join(', ') }}</p>{% endif %}
    {% if empresa.notas %}<p class="muted">{{ empresa.notas }}</p>{% endif %}
  </div>

  {% if can('empresas:eliminar') %}
    <details class="disclosure">
      <summary class="disclosure__summary">Administración</summary>
      <form method="post" action="/app/empresas/{{ empresa.id }}/archivar" class="disclosure__body" data-confirm="¿{{ 'Restaurar' if not empresa.activa else 'Archivar' }} esta empresa?">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <input type="hidden" name="archivar" value="{{ 'false' if not empresa.activa else 'true' }}" />
        <button class="btn btn--sm {{ 'btn--secondary' if not empresa.activa else 'btn--danger' }}" type="submit">{{ 'Restaurar empresa' if not empresa.activa else 'Archivar empresa' }}</button>
      </form>
    </details>
  {% endif %}

  <h2>Contactos ({{ contactos | length }})</h2>
  <table class="data-table">
    <thead><tr><th>Nombre</th><th>Puesto</th><th>Correo</th><th>Teléfono</th><th>Portal</th></tr></thead>
    <tbody>
      {% for c in contactos %}
        <tr>
          <td><a href="/app/contactos/{{ c.id }}/editar">{{ c.nombre }}</a></td>
          <td>{{ c.puesto or '—' }}</td>
          <td>{{ c.email or '—' }}</td>
          <td>{{ c.telefono or '—' }}</td>
          <td>{{ 'Sí' if c.esPortal else 'No' }}</td>
        </tr>
      {% else %}<tr><td colspan="5" class="muted">Sin contactos.</td></tr>{% endfor %}
    </tbody>
  </table>

  <h2>Tickets recientes</h2>
  <table class="data-table">
    <thead><tr><th>#</th><th>Asunto</th><th>Estado</th></tr></thead>
    <tbody>
      {% for t in tickets %}
        <tr><td><a href="/app/tickets/{{ t.id }}">#{{ t.numero }}</a></td><td>{{ t.asunto }}</td><td>{{ t.estado }}</td></tr>
      {% else %}<tr><td colspan="3" class="muted">Sin tickets.</td></tr>{% endfor %}
    </tbody>
  </table>

  {% if can('seguimiento:leer') %}
    <h2>Seguimiento comercial</h2>
    {% if can('seguimiento:gestionar') %}
      <form method="post" action="/app/interacciones" class="form">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <input type="hidden" name="empresaId" value="{{ empresa.id }}" />
        <div class="filterbar">
          <select name="tipo">
            {% for tp in ['llamada','correo','reunion','whatsapp','nota'] %}<option>{{ tp }}</option>{% endfor %}
          </select>
          <input type="date" name="fecha" />
          <input name="resumen" placeholder="Resumen de la interacción" required style="flex:1" />
          <button class="btn btn--sm" type="submit">Registrar</button>
        </div>
      </form>
    {% endif %}
    <ul class="timeline">
      {% for i in interacciones %}
        <li><span class="muted">{{ i.fecha | fecha }}</span> · <strong>{{ i.tipo }}</strong> — {{ i.resumen }} <span class="muted">({{ i.creadoPorNombre }})</span></li>
      {% else %}<li class="muted">Sin interacciones registradas.</li>{% endfor %}
    </ul>
  {% endif %}
{% endblock %}
