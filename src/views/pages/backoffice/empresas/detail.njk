{% extends "layouts/backoffice.njk" %}
{% block title %}{{ empresa.nombre }}{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>
      {% if can('empresas:editar') %}
        <button type="submit" form="fav-empresa" class="star-btn" title="{{ 'Quitar de favoritas' if empresa.favorita else 'Marcar como favorita' }}"
                aria-pressed="{{ 'true' if empresa.favorita else 'false' }}">{{ '⭐' if empresa.favorita else '☆' }}</button>
      {% elif empresa.favorita %}⭐{% endif %}
      {{ empresa.nombre }} {% if not empresa.activa %}<span class="badge">archivada</span>{% endif %}
    </h1>
    <div class="page-head__actions">
      {% if can('empresas:editar') %}<a class="btn btn--sm" href="/app/empresas/{{ empresa.id }}/editar">Editar</a>{% endif %}
      {% if can('contactos:crear') %}<a class="btn btn--sm btn--secondary" href="/app/contactos/nuevo?empresa={{ empresa.id }}">Agregar contacto</a>{% endif %}
    </div>
  </div>
  {% if can('empresas:editar') %}
    <form id="fav-empresa" method="post" action="/app/empresas/{{ empresa.id }}/favorita" hidden>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <input type="hidden" name="favorita" value="{{ 'false' if empresa.favorita else 'true' }}" />
      <input type="hidden" name="volver" value="/app/empresas/{{ empresa.id }}" />
    </form>
  {% endif %}

  <div class="card">
    <p><strong>RFC:</strong> {{ empresa.rfc or '—' }} · <strong>Tel:</strong> {{ empresa.telefono or '—' }} · <strong>Correo:</strong> {{ empresa.email or '—' }}</p>
    {% if empresa.direccion %}<p>{{ empresa.direccion }}</p>{% endif %}
    {% if empresa.notas %}<p class="muted">{{ empresa.notas }}</p>{% endif %}
  </div>

  {% if sistemas | length %}
    <h2>Sistemas, licencias y versiones</h2>
    <table class="data-table">
      <thead><tr><th>Sistema</th><th>Licencia</th><th>Vence</th><th>Instalada</th><th>Oficial</th><th>Versión</th></tr></thead>
      <tbody>
        {% for s in sistemas %}
          <tr>
            <td>{{ s.sistema }}</td>
            <td>
              {% if s.estadoVigencia == 'vencida' %}<span class="badge badge--danger">Vencida</span>
              {% elif s.estadoVigencia == 'por_vencer' %}<span class="badge badge--warning">Por vencer</span>
              {% elif s.estadoVigencia == 'vigente' %}<span class="badge badge--ok">Vigente</span>
              {% else %}<span class="badge">Sin dato</span>{% endif %}
            </td>
            <td>{{ s.vigencia | fecha if s.vigencia else '—' }}</td>
            <td>{{ s.instalada or '—' }}</td>
            <td>{{ s.oficial or '—' }}</td>
            <td>
              {% if s.estadoVersion == 'desactualizada' %}<span class="badge badge--warning">Desactualizada</span>
              {% elif s.estadoVersion == 'actualizada' %}<span class="badge badge--ok">Al día</span>
              {% elif s.estadoVersion == 'sin_oficial' %}<span class="muted">—</span>
              {% else %}<span class="badge">Sin dato</span>{% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="muted">
      Último aviso de versiones: {{ empresa.ultimoAvisoVersionesEn | fechahora if empresa.ultimoAvisoVersionesEn else 'nunca' }}
      · Último aviso de licencias: {{ empresa.ultimoAvisoLicenciasEn | fechahora if empresa.ultimoAvisoLicenciasEn else 'nunca' }}
    </p>
  {% endif %}

  {% if can('empresas:eliminar') %}
    <details class="disclosure">
      <summary class="disclosure__summary">Administración</summary>
      <form method="post" action="/app/empresas/{{ empresa.id }}/archivar" class="disclosure__body" data-confirm="¿{{ 'Restaurar' if not empresa.activa else 'Archivar' }} esta empresa?">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <input type="hidden" name="archivar" value="{{ 'false' if not empresa.activa else 'true' }}" />
        <button class="btn btn--sm {{ 'btn--secondary' if not empresa.activa else 'btn--danger' }}" type="submit">{{ 'Restaurar empresa' if not empresa.activa else 'Archivar empresa' }}</button>
      </form>
    </details>
  {% endif %}

  {% if empresa.camposExtra | length %}
    <h2>Campos extra</h2>
    <table class="data-table">
      <tbody>{% for c in empresa.camposExtra %}<tr><th>{{ c.etiqueta }}</th><td>{{ c.valor }}</td></tr>{% endfor %}</tbody>
    </table>
  {% endif %}

  <h2>Contactos ({{ contactos | length }})</h2>
  <table class="data-table">
    <thead><tr><th>Nombre</th><th>Puesto</th><th>Correo</th><th>Teléfono</th><th data-no-ordenar>WhatsApp</th><th>Portal</th></tr></thead>
    <tbody>
      {% for c in contactos %}
        <tr>
          <td><a href="/app/contactos/{{ c.id }}/editar">{{ c.nombre }}</a></td>
          <td>{{ c.puesto or '—' }}</td>
          <td>{{ c.email or '—' }}</td>
          <td>{{ c.telefono or c.celular or '—' }}</td>
          <td>
            {% set tel = (c.celular or c.telefono) | replace(' ', '') | replace('-', '') | replace('(', '') | replace(')', '') | replace('+', '') %}
            {% if tel %}<a class="btn btn--ghost btn--sm" target="_blank" rel="noopener" href="https://wa.me/{{ '52' if tel|length == 10 else '' }}{{ tel }}">💬 WhatsApp</a>{% else %}—{% endif %}
          </td>
          <td>{{ 'Sí' if c.esPortal else 'No' }}</td>
        </tr>
      {% else %}<tr><td colspan="6" class="muted">Sin contactos.</td></tr>{% endfor %}
    </tbody>
  </table>

  <h2>Tickets recientes</h2>
  <table class="data-table">
    <thead><tr><th>#</th><th>Asunto</th><th>Estado</th></tr></thead>
    <tbody>
      {% for t in tickets %}
        <tr><td><a href="/app/tickets/{{ t.id }}">#{{ t.numero }}</a></td><td>{{ t.asunto }}</td><td>{{ t.estado }}</td></tr>
      {% else %}<tr><td colspan="3" class="muted">Sin tickets.</td></tr>{% endfor %}
    </tbody>
  </table>

  {% if can('seguimiento:leer') %}
    <h2 id="tareas">Tareas ({{ tareas | length }})</h2>
    <ul class="timeline">
      {% for t in tareas %}
        <li>
          {% if can('seguimiento:gestionar') %}
            <form method="post" action="/app/tareas/{{ t.id }}/marcar" class="inline">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <input type="hidden" name="completada" value="true" />
              <input type="hidden" name="volverA" value="/app/empresas/{{ empresa.id }}#tareas" />
              <button class="btn btn--ghost btn--sm" type="submit" title="Marcar como hecha">✓</button>
            </form>
          {% endif %}
          {{ t.titulo }}
          {% if t.urgencia == 'vencida' %}<span class="badge badge--danger">{{ t.vence }}</span>
          {% elif t.urgencia == 'hoy' %}<span class="badge badge--warning">Hoy</span>
          {% elif t.urgencia == 'proxima' %}<span class="badge badge--ok">{{ t.vence }}</span>{% endif %}
          <span class="muted">({{ t.asignadoANombre or t.asignadoAUid }})</span>
        </li>
      {% else %}<li class="muted">Sin tareas pendientes para esta empresa.</li>{% endfor %}
    </ul>
    {% if can('seguimiento:gestionar') %}
      <details class="disclosure">
        <summary class="disclosure__summary">➕ Nueva tarea</summary>
        <form method="post" action="/app/tareas" class="form disclosure__body">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <input type="hidden" name="empresaId" value="{{ empresa.id }}" />
          <input type="hidden" name="volverA" value="/app/empresas/{{ empresa.id }}#tareas" />
          <div class="filterbar">
            <input name="titulo" placeholder="Título de la tarea" required style="flex:1" />
            <input type="date" name="vence" />
            <button class="btn btn--sm" type="submit">Crear</button>
          </div>
        </form>
      </details>
    {% endif %}

    <h2 id="historial">Historial ({{ historial | length }})</h2>
    <form method="get" action="/app/empresas/{{ empresa.id }}" class="filterbar">
      <input type="date" name="hDesde" value="{{ filtroHistorial.desde }}" />
      <input type="date" name="hHasta" value="{{ filtroHistorial.hasta }}" />
      <select name="hTipo">
        <option value="">Todos los tipos</option>
        {% for tp in ['llamada','correo','reunion','whatsapp','nota','ticket'] %}
          <option value="{{ tp }}" {{ 'selected' if filtroHistorial.tipo == tp }}>{{ tp }}</option>
        {% endfor %}
      </select>
      <button class="btn btn--sm btn--secondary" type="submit">Filtrar</button>
      {% if filtroHistorial.desde or filtroHistorial.hasta or filtroHistorial.tipo %}
        <a class="btn btn--sm btn--ghost" href="/app/empresas/{{ empresa.id }}#historial">Limpiar</a>
      {% endif %}
    </form>
    {% if resumenTickets %}
      <p class="muted">🎫 {{ historial | length }} ticket{{ '' if historial | length == 1 else 's' }} en este rango —
        {% for r in resumenTickets %}{{ r.cantidad }} {{ r.estado }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
    {% endif %}
    <ul class="timeline">
      {% for i in historial %}
        <li>
          <span class="muted">{{ i.fecha | fecha }}</span> ·
          {% if i.tipo == 'ticket' %}
            🎫 <a href="/app/tickets/{{ i.ticketId }}">{{ i.texto }}</a>
          {% else %}
            <strong>{{ i.tipo }}</strong> — {{ i.texto }} <span class="muted">({{ i.usuario }})</span>
          {% endif %}
        </li>
      {% else %}
        <li class="muted">{{ 'Sin resultados con ese filtro.' if (filtroHistorial.desde or filtroHistorial.hasta or filtroHistorial.tipo) else 'Sin interacciones registradas.' }}</li>
      {% endfor %}
    </ul>
    {% if can('seguimiento:gestionar') %}
      <form method="post" action="/app/interacciones" class="form">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <input type="hidden" name="empresaId" value="{{ empresa.id }}" />
        <div class="filterbar">
          <select name="tipo">
            {% for tp in ['llamada','correo','reunion','whatsapp','nota'] %}<option>{{ tp }}</option>{% endfor %}
          </select>
          <input type="date" name="fecha" />
          <input name="resumen" placeholder="Resumen de la interacción" required style="flex:1" />
          <button class="btn btn--sm" type="submit">Registrar</button>
        </div>
      </form>
    {% endif %}
  {% endif %}
{% endblock %}
