{% extends "layouts/backoffice.njk" %}
{% import "components/configuracion.njk" as cfgnav %}
{% block title %}Integraciones{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>Integraciones</h1>
    <div class="page-head__actions">{{ cfgnav.nav('integraciones') }}</div>
  </div>
  {% if guardado %}<p class="alert alert--ok">Configuración guardada.</p>{% endif %}
  {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}

  <form method="post" action="/app/configuracion/integraciones" class="form form--wide">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

    <details class="disclosure" open>
      <summary class="disclosure__summary">🔗 Webhooks n8n</summary>
      <div class="disclosure__body form">
        <label class="field"><span>Webhook de tickets</span>
          <input type="url" name="n8nWebhookTickets" value="{{ config.n8nWebhookTickets }}" placeholder="https://..." data-n8n-url="tickets" />
          {% if errores.n8nWebhookTickets %}<em class="field__error">{{ errores.n8nWebhookTickets }}</em>{% endif %}
        </label>
        <button type="button" class="btn btn--ghost btn--sm" data-probar-webhook="tickets">Probar conexión</button>
        <span class="muted" data-resultado-webhook="tickets"></span>

        <label class="field"><span>Webhook de cotizaciones</span>
          <input type="url" name="n8nWebhookCotizaciones" value="{{ config.n8nWebhookCotizaciones }}" placeholder="https://..." data-n8n-url="cotizaciones" />
          {% if errores.n8nWebhookCotizaciones %}<em class="field__error">{{ errores.n8nWebhookCotizaciones }}</em>{% endif %}
        </label>
        <button type="button" class="btn btn--ghost btn--sm" data-probar-webhook="cotizaciones">Probar conexión</button>
        <span class="muted" data-resultado-webhook="cotizaciones"></span>
        <p class="muted">Si se deja vacío, se usa la variable de entorno del servidor como respaldo (compatibilidad).</p>

        <label class="field"><span>Webhook de empresas (avisos por WhatsApp)</span>
          <input type="url" name="n8nWebhookEmpresas" value="{{ config.n8nWebhookEmpresas }}" placeholder="https://..." data-n8n-url="empresas" />
          {% if errores.n8nWebhookEmpresas %}<em class="field__error">{{ errores.n8nWebhookEmpresas }}</em>{% endif %}
        </label>
        <button type="button" class="btn btn--ghost btn--sm" data-probar-webhook="empresas">Probar conexión</button>
        <span class="muted" data-resultado-webhook="empresas"></span>
        <p class="muted">Lo usa el botón "Avisar por WhatsApp" de Empresas. CallMeBot (abajo) no sirve para avisar a
          clientes — solo manda al número propio dado de alta. Este evento (<code>empresa.avisar_whatsapp</code>,
          con teléfono y mensaje) se manda tal cual a n8n; de ese lado se debe enrutar a un proveedor real de
          WhatsApp Business.</p>
      </div>
    </details>

    <details class="disclosure">
      <summary class="disclosure__summary">💬 WhatsApp (CallMeBot)</summary>
      <div class="disclosure__body form">
        <label class="field--check">
          <input type="checkbox" name="whatsappHabilitado" {{ 'checked' if config.whatsappHabilitado }} />
          Habilitado
        </label>
        <label class="field"><span>Teléfono (con lada de país, sin espacios)</span>
          <input name="whatsappTelefono" value="{{ config.whatsappTelefono }}" placeholder="+521234567890" data-whatsapp-tel />
        </label>
        <label class="field"><span>API key de CallMeBot</span>
          <input name="whatsappApiKey" value="{{ config.whatsappApiKey }}" data-whatsapp-key />
        </label>
        <button type="button" class="btn btn--ghost btn--sm" data-probar-whatsapp>Probar conexión</button>
        <span class="muted" data-resultado-whatsapp></span>
        <label class="field"><span>Otras personas que reciben los avisos</span>
          <textarea name="whatsappOtros" rows="4" data-whatsapp-otros placeholder="Nombre, +521234567890, APIKEY">{{ whatsappOtrosTexto }}</textarea>
          <em class="field__hint">Una por línea: <code>Nombre, teléfono, API key</code>. Cada persona activa su propio número en CallMeBot y usa su propia API key.</em>
        </label>
        <button type="button" class="btn btn--ghost btn--sm" data-probar-whatsapp-otros>🧪 Probar a estas personas</button>
        <ul class="muted" data-resultado-whatsapp-otros></ul>
        <p class="muted">
          Requiere haber activado el número en <a href="https://www.callmebot.com/blog/free-api-whatsapp-messages/" target="_blank" rel="noopener">CallMeBot</a> (envía "I allow callmebot to send me messages" al número oficial y guarda el API key que te respondan).
        </p>
      </div>
    </details>

    <details class="disclosure"{{ ' open' if wa.proveedor == 'meta' or wa.proveedor == 'twilio' }}>
      <summary class="disclosure__summary">📲 WhatsApp a clientes (avisos de versiones y licencias)</summary>
      <div class="disclosure__body form">
        <p class="muted">CallMeBot (arriba) solo sirve para avisos internos a tu equipo. Para escribirle a clientes elige cómo:</p>
        <label class="field"><span>Envío</span>
          <select name="waProveedor" data-wa-proveedor>
            <option value="manual" {{ 'selected' if wa.proveedor == 'manual' }}>Manual — abre WhatsApp Web con el mensaje listo</option>
            <option value="n8n" {{ 'selected' if wa.proveedor == 'n8n' }}>n8n — manda al webhook de Empresas (si no hay, manual)</option>
            <option value="meta" {{ 'selected' if wa.proveedor == 'meta' }}>Meta — API oficial de WhatsApp Business</option>
            <option value="twilio" {{ 'selected' if wa.proveedor == 'twilio' }}>Twilio</option>
          </select>
        </label>
        <fieldset class="field" data-wa-panel="meta" {{ 'hidden' if wa.proveedor != 'meta' }}>
          <legend>Meta (WhatsApp Cloud API)</legend>
          <label class="field"><span>Token de acceso (usuario del sistema)</span>
            <input type="password" name="waMetaToken" autocomplete="off" placeholder="{{ '•••••••• guardado — déjalo vacío para conservarlo' if wa.metaToken else 'EAAG…' }}" />
          </label>
          <label class="field"><span>Phone number ID</span><input name="waMetaPhoneNumberId" value="{{ wa.metaPhoneNumberId }}" /></label>
          <div class="form-grid">
            <label class="field"><span>Nombre de la plantilla aprobada</span><input name="waMetaPlantilla" value="{{ wa.metaPlantilla }}" placeholder="aviso_dattasoft" /></label>
            <label class="field"><span>Idioma de la plantilla</span><input name="waMetaIdioma" value="{{ wa.metaIdioma }}" placeholder="es_MX" /></label>
          </div>
          <p class="field__hint">Meta solo deja que la empresa inicie la conversación con una <strong>plantilla aprobada</strong>. Crea en WhatsApp Manager una plantilla de tipo "Utilidad" con una sola variable, por ejemplo: <code>Aviso de DATTASOFT: {{ '{{1}}' }}</code>. El mensaje de tus plantillas del CRM va completo en esa variable (en una sola línea).</p>
        </fieldset>
        <fieldset class="field" data-wa-panel="twilio" {{ 'hidden' if wa.proveedor != 'twilio' }}>
          <legend>Twilio</legend>
          <div class="form-grid">
            <label class="field"><span>Account SID</span><input name="waTwilioAccountSid" value="{{ wa.twilioAccountSid }}" placeholder="AC…" /></label>
            <label class="field"><span>Auth Token</span>
              <input type="password" name="waTwilioAuthToken" autocomplete="off" placeholder="{{ '•••••••• guardado — vacío para conservarlo' if wa.twilioAuthToken else '' }}" />
            </label>
            <label class="field"><span>Número remitente</span><input name="waTwilioFrom" value="{{ wa.twilioFrom }}" placeholder="+14155238886" /></label>
            <label class="field"><span>Content SID de la plantilla</span><input name="waTwilioContentSid" value="{{ wa.twilioContentSid }}" placeholder="HX…" /></label>
          </div>
          <p class="field__hint">Igual que con Meta, para iniciar la conversación Twilio pide una plantilla aprobada (Content SID) con la variable <code>{{ '{{1}}' }}</code>. Sin ella, el mensaje solo llega si el cliente te escribió en las últimas 24 h.</p>
        </fieldset>
        <div data-wa-panel="meta twilio" {{ 'hidden' if wa.proveedor != 'meta' and wa.proveedor != 'twilio' }}>
          <label class="field"><span>Probar (guarda primero)</span>
            <input name="waPruebaTelefono" placeholder="10 dígitos" data-wa-prueba-tel />
          </label>
          <button type="button" class="btn btn--ghost btn--sm" data-probar-wa-clientes>🧪 Enviar prueba</button>
          <span class="muted" data-resultado-wa-clientes></span>
          <p class="field__hint">Si un envío falla, el aviso no se pierde: aparece el botón "Abrir WhatsApp" para mandarlo a mano.</p>
        </div>
      </div>
    </details>

    <details class="disclosure">
      <summary class="disclosure__summary">📤 Correo saliente</summary>
      <div class="disclosure__body form">
        {% if infoCorreo.modo == 'log' %}
          <p class="alert alert--warn">
            El servidor no tiene <code>BREVO_API_KEY</code> ni SMTP configurado: los correos
            <strong>solo se registran en el log</strong>, no se envían.
          </p>
        {% else %}
          <p class="muted">
            Enviando vía <strong>{{ 'Brevo' if infoCorreo.modo == 'brevo' else 'SMTP' }}</strong>,
            remitente <strong>{{ infoCorreo.remitente }}</strong>.
          </p>
        {% endif %}
        <label class="field"><span>Enviar un correo de prueba a</span>
          <input type="email" placeholder="destinatario@correo.com" data-correo-prueba />
        </label>
        <button type="button" class="btn btn--ghost btn--sm" data-probar-correo>Enviar prueba</button>
        <span class="muted" data-resultado-correo></span>
      </div>
    </details>

    <details class="disclosure">
      <summary class="disclosure__summary">🗂️ Matriz de reglas por evento</summary>
      <div class="disclosure__body">
        <table class="data-table">
          <thead>
            <tr><th>Evento</th><th>Webhook</th><th>WhatsApp</th></tr>
          </thead>
          <tbody>
            {% for evento, etiqueta in eventosEtiquetas %}
              <tr>
                <td>{{ etiqueta }}</td>
                <td><input type="checkbox" name="regla_{{ evento }}_webhook" {{ 'checked' if config.reglas[evento].webhook }} /></td>
                <td><input type="checkbox" name="regla_{{ evento }}_whatsapp" {{ 'checked' if config.reglas[evento].whatsapp }} /></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </details>

    <button class="btn" type="submit">Guardar</button>
  </form>
{% endblock %}
