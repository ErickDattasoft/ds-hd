{% extends "layouts/backoffice.njk" %}
{% import "components/configuracion.njk" as cfgnav %}
{% block title %}Configuración de cotizaciones{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>Configuración de cotizaciones</h1>
    <div class="page-head__actions">{{ cfgnav.nav('cotizaciones') }}</div>
  </div>
  {% if guardado %}<p class="alert alert--ok">Configuración guardada.</p>{% endif %}
  {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}

  <form method="post" action="/app/configuracion/cotizaciones" class="form form--wide">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

    <label class="field"><span>Condiciones / términos por defecto</span>
      <textarea name="condicionesPorDefecto" rows="4">{{ config.condicionesPorDefecto }}</textarea>
      <em class="field__hint">Se precargan al crear una cotización. El usuario puede editarlas en cada una.</em>
    </label>

    <fieldset class="field">
      <legend>Emisor por defecto (quien cotiza)</legend>
      <em class="field__hint">El nombre y el correo se toman de la cuenta del usuario. Aquí defines el cargo y el teléfono sugeridos.</em>
      <label class="field"><span>Cargo</span>
        <input name="emisorCargoPorDefecto" value="{{ config.emisorCargoPorDefecto }}" placeholder="Ej: Ejecutivo de Ventas" />
      </label>
      <label class="field"><span>Teléfono</span>
        <input name="emisorTelefonoPorDefecto" value="{{ config.emisorTelefonoPorDefecto }}" placeholder="Ej: 9991234567" />
      </label>
    </fieldset>

    <h2>⚡ Catálogo de conceptos <span class="disclosure__hint">— para no volver a escribirlos en cada cotización</span></h2>
    <table class="data-table">
      <thead><tr><th data-no-ordenar>Descripción</th><th data-no-ordenar>Precio unitario</th><th data-no-ordenar>Dto. % por defecto</th><th data-no-ordenar></th></tr></thead>
      <tbody data-catalogo-conceptos-body>
        {% for c in config.catalogoConceptos %}
          <tr>
            <td><input name="catDescripcion" value="{{ c.descripcion }}" style="width:100%" /></td>
            <td><input name="catPrecio" type="number" min="0" step="0.01" value="{{ c.precioUnitario }}" /></td>
            <td><input name="catDescuento" type="number" min="0" max="100" step="1" value="{{ c.descuentoPorDefecto }}" /></td>
            <td><button type="button" class="btn btn--ghost btn--sm" data-quitar-fila>✕</button></td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    <button type="button" class="btn btn--ghost btn--sm" data-agregar-catalogo-concepto>➕ Añadir concepto</button>

    <div class="page-head__actions">
      <button class="btn" type="submit">Guardar</button>
    </div>
  </form>
{% endblock %}
