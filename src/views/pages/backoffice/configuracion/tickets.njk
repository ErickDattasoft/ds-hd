{% extends "layouts/backoffice.njk" %}
{% import "components/configuracion.njk" as cfgnav %}
{% block title %}Configuración de tickets{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>Configuración de tickets</h1>
    <div class="page-head__actions">{{ cfgnav.nav('tickets') }}</div>
  </div>
  {% if guardado %}<p class="alert alert--ok">Configuración guardada.</p>{% endif %}
  {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}

  <form method="post" action="/app/configuracion/tickets" class="form form--wide">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    <p class="muted">Un valor por línea.</p>

    <details class="disclosure" open>
      <summary class="disclosure__summary">Catálogos</summary>
      <div class="disclosure__body form">
        <label class="field"><span>Tipos</span><textarea name="tipos" rows="6">{{ config.tipos | join('\n') }}</textarea></label>
        <label class="field"><span>Sistemas</span><textarea name="sistemas" rows="6">{{ config.sistemas | join('\n') }}</textarea></label>
        <label class="field"><span>Grupos</span><textarea name="grupos" rows="4">{{ config.grupos | join('\n') }}</textarea></label>
      </div>
    </details>

    <details class="disclosure"{{ ' open' if errores.estados or errores.estadoInicial }}>
      <summary class="disclosure__summary">Flujo de estados</summary>
      <div class="disclosure__body form">
        <label class="field"><span>Estados (en orden del flujo)</span><textarea name="estados" rows="5">{{ config.estados | join('\n') }}</textarea>
          {% if errores.estados %}<em class="field__error">{{ errores.estados }}</em>{% endif %}
        </label>
        <label class="field"><span>Estado inicial</span><input name="estadoInicial" value="{{ config.estadoInicial }}" />
          {% if errores.estadoInicial %}<em class="field__error">{{ errores.estadoInicial }}</em>{% endif %}
        </label>
        <label class="field"><span>Prioridades</span><textarea name="prioridades" rows="4">{{ config.prioridades | join('\n') }}</textarea></label>
      </div>
    </details>

    <details class="disclosure">
      <summary class="disclosure__summary">SLA por prioridad</summary>
      <fieldset class="field disclosure__body">
        <legend>Horas de SLA por prioridad</legend>
        {% for p in config.prioridades %}
          <label class="field">{{ p }}
            <input type="number" name="sla_{{ p }}" min="1" value="{{ config.slaHoras[p] or 24 }}" />
          </label>
        {% endfor %}
      </fieldset>
    </details>

    <details class="disclosure">
      <summary class="disclosure__summary">Facturación y avisos</summary>
      <div class="disclosure__body form">
        <label class="field"><span>Tipos facturables</span><textarea name="tiposFacturables" rows="3">{{ config.tiposFacturables | join('\n') }}</textarea></label>
        <label class="field"><span>Correos de notificación de tickets</span><textarea name="correosNotificacion" rows="3">{{ config.correosNotificacion | join('\n') }}</textarea></label>
        <p class="muted">Uno por línea. Reciben copia de todos los correos de tickets (nuevo del portal, nota pública al cliente, resuelto/cerrado, reenvíos). El primero es la dirección de respuesta.</p>
      </div>
    </details>

    <details class="disclosure">
      <summary class="disclosure__summary">💬 Respuestas guardadas <span class="disclosure__hint">— textos listos para casos repetidos</span></summary>
      <div class="disclosure__body form">
        <label class="field"><span>Respuestas</span>
          <textarea name="respuestas" rows="12" placeholder="### Cómo timbrar&#10;Hola, para timbrar entra a…&#10;&#10;### Actualizar versión&#10;Descarga la versión…">{{ respuestasATexto(config.respuestas) }}</textarea>
          <em class="field__hint">Cada respuesta empieza con una línea <code>### Título</code> y abajo su texto. Se insertan desde el botón 💬 al redactar un ticket o una nota. Puedes usar <code>[fecha]</code>.</em>
        </label>
      </div>
    </details>

    <details class="disclosure" open>
      <summary class="disclosure__summary">⭐ Predeterminados del ticket nuevo</summary>
      <div class="disclosure__body form">
        <p class="muted">Con estos valores nace el formulario de <strong>Crear ticket</strong> para todos. Vacío = sin preselección. Guarda primero si acabas de agregar opciones a un catálogo.</p>
        {% set pred = config.predeterminados or {} %}
        {% macro sel(nombre, etiqueta, lista, actual) %}
          <label class="field"><span>{{ etiqueta }}</span>
            <select name="{{ nombre }}"><option value="">—</option>{% for v in lista %}<option {{ 'selected' if actual == v }}>{{ v }}</option>{% endfor %}</select>
          </label>
        {% endmacro %}
        <div class="form-grid">
          {{ sel('predTipo', 'Tipo', config.tipos, pred.tipo) }}
          {{ sel('predPrioridad', 'Prioridad', config.prioridades, pred.prioridad) }}
          {{ sel('predSistema', 'Sistema', config.sistemas, pred.sistema) }}
          {{ sel('predGrupo', 'Grupo', config.grupos, pred.grupo) }}
          <label class="field"><span>Facturación</span>
            <select name="predFacturacion"><option value="">—</option>{% for ef in estadosFacturacion %}<option value="{{ ef.valor }}" {{ 'selected' if pred.estadoFacturacion == ef.valor }}>{{ ef.etiqueta }}</option>{% endfor %}</select>
          </label>
        </div>
        <label class="field--check"><input type="checkbox" name="predAsignarAlCreador" {{ 'checked' if pred.asignarAlCreador }} /> <span>Agente: asignar el ticket a quien lo crea (técnicos)</span></label>
        <p class="muted">El estado inicial se elige en "Flujo de estados".</p>
      </div>
    </details>

    <button class="btn" type="submit">Guardar</button>
  </form>
{% endblock %}
