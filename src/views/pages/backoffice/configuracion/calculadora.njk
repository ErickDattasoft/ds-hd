{% extends "layouts/backoffice.njk" %}
{% import "components/configuracion.njk" as cfgnav %}
{% block title %}Configuración de la calculadora{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>🧮 Calculadora Compac</h1>
    <div class="page-head__actions">{{ cfgnav.nav('calculadora') }}</div>
  </div>
  {% if guardado %}<p class="alert alert--ok">Configuración guardada.</p>{% endif %}
  {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}
  <p class="muted">
    Catálogos y precios que usa la <a href="/app/cotizaciones/calculadora">calculadora de licenciamiento Compac</a>
    al armar una cotización. Cada equipo cobra el precio del <strong>1er sistema</strong> de su tipo más el
    <strong>adicional</strong> por cada sistema extra; SQL va en un renglón aparte y solo para Servidor.
  </p>
  <form method="post" action="/app/configuracion/calculadora" class="form form--wide">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

    <h2>🧩 Catálogo de sistemas</h2>
    <p class="muted">Sistemas que se pueden marcar al armar un grupo de equipos — cada uno es independiente, incluyendo «Componentes».</p>
    <table class="data-table">
      <thead><tr><th data-no-ordenar>Sistema</th><th data-no-ordenar></th></tr></thead>
      <tbody data-filas="tpl-sistema-compac">
        {% for s in config.catalogoSistemas %}
          <tr>
            <td><input name="sistema" value="{{ s }}" style="width:100%" /></td>
            <td class="nowrap">
              <button type="button" class="btn btn--ghost btn--sm" data-subir-fila title="Subir">↑</button>
              <button type="button" class="btn btn--ghost btn--sm" data-bajar-fila title="Bajar">↓</button>
              <button type="button" class="btn btn--ghost btn--sm" data-quitar-fila title="Quitar">✕</button>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    <template id="tpl-sistema-compac">
      <tr>
        <td><input name="sistema" placeholder="Ej: Xelcron" style="width:100%" /></td>
        <td class="nowrap">
          <button type="button" class="btn btn--ghost btn--sm" data-subir-fila title="Subir">↑</button>
          <button type="button" class="btn btn--ghost btn--sm" data-bajar-fila title="Bajar">↓</button>
          <button type="button" class="btn btn--ghost btn--sm" data-quitar-fila title="Quitar">✕</button>
        </td>
      </tr>
    </template>
    <button type="button" class="btn btn--ghost btn--sm" data-agregar-fila-de="tpl-sistema-compac">➕ Agregar sistema</button>

    <h2>🖥️ Tipos de equipo y precios</h2>
    {% if errores.catalogoEquipos %}<p class="alert alert--error">{{ errores.catalogoEquipos }}</p>{% endif %}
    <table class="data-table">
      <thead><tr><th data-no-ordenar>Tipo de equipo</th><th data-no-ordenar>1er sistema</th><th data-no-ordenar>Adicional</th><th data-no-ordenar></th></tr></thead>
      <tbody data-filas="tpl-equipo-compac">
        {% for e in config.catalogoEquipos %}
          <tr>
            <td><input name="equipoNombre" value="{{ e.nombre }}" /></td>
            <td><input name="equipoPrimer" type="number" min="0" step="0.01" value="{{ e.precioPrimerSistema }}" /></td>
            <td><input name="equipoAdicional" type="number" min="0" step="0.01" value="{{ e.precioAdicional }}" /></td>
            <td><button type="button" class="btn btn--ghost btn--sm" data-quitar-fila title="Quitar">✕</button></td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    <template id="tpl-equipo-compac">
      <tr>
        <td><input name="equipoNombre" placeholder="Ej: Laptop" /></td>
        <td><input name="equipoPrimer" type="number" min="0" step="0.01" value="0" /></td>
        <td><input name="equipoAdicional" type="number" min="0" step="0.01" value="0" /></td>
        <td><button type="button" class="btn btn--ghost btn--sm" data-quitar-fila title="Quitar">✕</button></td>
      </tr>
    </template>
    <button type="button" class="btn btn--ghost btn--sm" data-agregar-fila-de="tpl-equipo-compac">➕ Agregar tipo de equipo</button>

    <label class="field" style="max-width:220px"><span>Precio SQL (solo Servidor)</span>
      <input type="number" min="0" step="0.01" name="precioSQL" value="{{ config.precioSQL }}" />
    </label>

    <div class="page-head__actions">
      <button class="btn" type="submit">💾 Guardar calculadora Compac</button>
    </div>
  </form>
{% endblock %}
