{% extends "layouts/backoffice.njk" %}
{% block title %}{{ titulo }}{% endblock %}
{% block content %}
  <h1>{{ titulo }}</h1>
  {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}
  <form method="post" action="{{ '/app/contactos' if modo == 'crear' else '/app/contactos/' + valores.id }}" class="form form--wide">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    <label class="field"><span>Nombre</span><input name="nombre" value="{{ valores.nombre }}" required />
      {% if errores.nombre %}<em class="field__error">{{ errores.nombre }}</em>{% endif %}</label>
    <label class="field"><span>Empresa</span>
      <select name="empresaId" {{ 'required' if modo == 'editar' }}>
        <option value="">{{ '— selecciona o crea una abajo —' if modo == 'crear' else '— selecciona —' }}</option>
        {% for e in empresas %}<option value="{{ e.id }}" {{ 'selected' if valores.empresaId == e.id }}>{{ e.nombre }}</option>{% endfor %}
      </select>
      {% if errores.empresaId %}<em class="field__error">{{ errores.empresaId }}</em>{% endif %}
    </label>
    {% if modo == 'crear' %}
      <label class="field"><span>🏢 …o crear empresa nueva</span>
        <input name="empresaNueva" value="{{ valores.empresaNueva }}" placeholder="Nombre de la empresa (si no está en la lista)" />
      </label>
    {% endif %}
    <label class="field"><span>Correo</span><input type="email" name="email" autocomplete="email" value="{{ valores.email }}" /></label>
    <label class="field"><span>Correo alternativo</span><input type="email" name="emailAlternativo" autocomplete="off" value="{{ valores.emailAlternativo }}" /></label>
    <div class="form-grid">
      <label class="field"><span>📱 Celular <span class="muted">(WhatsApp)</span></span><input type="tel" inputmode="tel" name="telefono" value="{{ valores.telefono }}" placeholder="Ej: 9991234567" /></label>
      <label class="field"><span>☎️ Tel. oficina</span><input type="tel" inputmode="tel" name="celular" value="{{ valores.celular }}" placeholder="Ej: 9991234567" /></label>
    </div>

    {# Al volver con error llegan cumpleDia/cumpleMes del formulario; al editar, el MM-DD guardado. #}
    {% set cumpleMes = valores.cumpleMes or (valores.cumpleanos.slice(0, 2) | int if valores.cumpleanos) %}
    {% set cumpleDia = valores.cumpleDia or (valores.cumpleanos.slice(3, 5) | int if valores.cumpleanos) %}
    {% set MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'] %}
    <fieldset class="field">
      <legend>🎂 Cumpleaños <span class="muted">(opcional)</span></legend>
      <div style="display:flex;gap:var(--space-2)">
        <select name="cumpleDia" aria-label="Día">
          <option value="">Día</option>
          {% for d in range(1, 32) %}<option value="{{ d }}"{{ ' selected' if cumpleDia == d }}>{{ d }}</option>{% endfor %}
        </select>
        <select name="cumpleMes" aria-label="Mes">
          <option value="">Mes</option>
          {% for m in MESES %}<option value="{{ loop.index }}"{{ ' selected' if cumpleMes == loop.index }}>{{ m }}</option>{% endfor %}
        </select>
      </div>
      {% if errores.cumpleanos %}<em class="field__error">{{ errores.cumpleanos }}</em>{% endif %}
    </fieldset>

    <details class="disclosure"{{ ' open' if valores.puesto or valores.rfc or valores.notas }}>
      <summary class="disclosure__summary">Detalles <span class="disclosure__hint">— puesto, RFC, notas</span></summary>
      <div class="disclosure__body form">
        <label class="field"><span>Puesto</span><input name="puesto" value="{{ valores.puesto }}" /></label>
        <label class="field"><span>RFC</span><input name="rfc" value="{{ valores.rfc }}" placeholder="XAXX010101000" /></label>
        <label class="field"><span>Notas</span><textarea name="notas" rows="3">{{ valores.notas }}</textarea></label>
      </div>
    </details>

    <div class="page-head__actions">
      <button class="btn" type="submit">Guardar</button>
      <a class="btn btn--ghost" href="/app/contactos">Cancelar</a>
    </div>
  </form>
{% endblock %}
