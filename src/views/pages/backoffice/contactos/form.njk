{% extends "layouts/backoffice.njk" %}
{% block title %}{{ titulo }}{% endblock %}
{% block content %}
  <h1>{{ titulo }}</h1>
  {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}
  <form method="post" action="{{ '/app/contactos' if modo == 'crear' else '/app/contactos/' + valores.id }}" class="form form--wide">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    <label class="field"><span>Nombre</span><input name="nombre" value="{{ valores.nombre }}" required />
      {% if errores.nombre %}<em class="field__error">{{ errores.nombre }}</em>{% endif %}</label>
    <label class="field"><span>Empresa</span>
      <select name="empresaId" {{ 'required' if modo == 'editar' }}>
        <option value="">{{ '— selecciona o crea una abajo —' if modo == 'crear' else '— selecciona —' }}</option>
        {% for e in empresas %}<option value="{{ e.id }}" {{ 'selected' if valores.empresaId == e.id }}>{{ e.nombre }}</option>{% endfor %}
      </select>
      {% if errores.empresaId %}<em class="field__error">{{ errores.empresaId }}</em>{% endif %}
    </label>
    {% if modo == 'crear' %}
      <label class="field"><span>🏢 …o crear empresa nueva</span>
        <input name="empresaNueva" value="{{ valores.empresaNueva }}" placeholder="Nombre de la empresa (si no está en la lista)" />
      </label>
    {% endif %}
    <label class="field"><span>Correo</span><input type="email" name="email" autocomplete="email" value="{{ valores.email }}" /></label>

    <details class="disclosure"{{ ' open' if valores.puesto or valores.rfc or valores.telefono or valores.celular or valores.notas }}>
      <summary class="disclosure__summary">Detalles <span class="disclosure__hint">— puesto, RFC, teléfonos, notas</span></summary>
      <div class="disclosure__body form">
        <label class="field"><span>Puesto</span><input name="puesto" value="{{ valores.puesto }}" /></label>
        <label class="field"><span>RFC</span><input name="rfc" value="{{ valores.rfc }}" placeholder="XAXX010101000" /></label>
        <label class="field"><span>Teléfono</span><input type="tel" inputmode="tel" name="telefono" value="{{ valores.telefono }}" /></label>
        <label class="field"><span>Celular</span><input type="tel" inputmode="tel" name="celular" value="{{ valores.celular }}" /></label>
        <label class="field"><span>Notas</span><textarea name="notas" rows="3">{{ valores.notas }}</textarea></label>
      </div>
    </details>

    <div class="page-head__actions">
      <button class="btn" type="submit">Guardar</button>
      <a class="btn btn--ghost" href="/app/contactos">Cancelar</a>
    </div>
  </form>
{% endblock %}
