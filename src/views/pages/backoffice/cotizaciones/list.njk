{% extends "layouts/backoffice.njk" %}
{% block title %}Cotizaciones{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>Cotizaciones</h1>
    <div class="page-head__actions">
      {% if can('cotizaciones:crear') %}<a class="btn btn--sm" href="/app/cotizaciones/nueva">Nueva</a>{% endif %}
      {% if can('cotizaciones:crear') %}<a class="btn btn--sm btn--secondary" href="/app/cotizaciones/calculadora">Calculadora Compac</a>{% endif %}
    </div>
  </div>
  <div class="stat-row">
    <a class="stat stat--top-brand" href="/app/cotizaciones"><span class="stat__num">{{ contadores.total }}</span><span class="stat__lbl">Total cotizaciones</span></a>
    <a class="stat" href="/app/cotizaciones?estado=enviada"><span class="stat__num">{{ contadores.activas }}</span><span class="stat__lbl">Activas</span></a>
    <a class="stat" href="/app/cotizaciones?estado=aceptada"><span class="stat__num">{{ contadores.aceptadas }}</span><span class="stat__lbl">Aceptadas</span></a>
    <a class="stat" href="/app/cotizaciones?estado=vencida"><span class="stat__num">{{ contadores.vencidas }}</span><span class="stat__lbl">Vencidas</span></a>
  </div>
  <form method="get" class="filterbar">
    <input type="search" name="q" value="{{ q }}" placeholder="Folio o empresa" />
    <select name="estado">
      <option value="">Todos</option>
      {% for e in ['borrador','enviada','aceptada','rechazada','vencida'] %}
        <option value="{{ e }}" {{ 'selected' if estado == e }}>{{ e }}</option>
      {% endfor %}
    </select>
    <button class="btn btn--sm" type="submit">Filtrar</button>
  </form>
  <table class="data-table">
    <thead><tr><th>Folio</th><th>Empresa</th><th>Fecha</th><th>Vigencia</th><th>Total</th><th>Estado</th><th data-no-ordenar></th></tr></thead>
    <tbody>
      {% for c in cotizaciones %}
        <tr>
          <td><a href="/app/cotizaciones/{{ c.id }}">{{ c.folio }}</a></td>
          <td>{{ c.empresaNombre or '—' }}</td>
          <td>{{ c.fecha | fecha }}</td>
          <td{% if c.estado == 'vencida' %} class="texto-peligro"{% endif %}>{{ c.venceEl | fecha }}</td>
          <td>{{ c.total | moneda(c.moneda) }}</td>
          <td><span class="{{ c.estado | estadoClase }}">{{ c.estado }}</span></td>
          <td class="col-acciones">
            {% if c.ticketId %}<a class="btn btn--sm btn--ghost" href="/app/tickets/{{ c.ticketId }}" title="Ver ticket">🎫 #{{ c.ticketNumero }}</a>{% endif %}
            {% if can('cotizaciones:editar') and c.estado != 'aceptada' %}<a class="btn btn--sm btn--ghost" href="/app/cotizaciones/{{ c.id }}/editar" title="Editar">✏️</a>{% endif %}
            <a class="btn btn--sm btn--ghost" href="/app/cotizaciones/{{ c.id }}/imprimir?auto=1" target="_blank" rel="noopener" title="PDF">📄</a>
            {% if can('cotizaciones:editar') %}<a class="btn btn--sm btn--ghost" href="/app/cotizaciones/{{ c.id }}#enviar" title="Enviar por correo">✉️</a>{% endif %}
            {% if can('cotizaciones:crear') %}
              <form method="post" action="/app/cotizaciones/{{ c.id }}/duplicar" class="inline" data-confirm="¿Duplicar la cotización {{ c.folio }}?">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <button class="btn btn--sm btn--ghost" type="submit" title="Duplicar">📋</button>
              </form>
            {% endif %}
            {% if can('cotizaciones:editar') %}
              <form method="post" action="/app/cotizaciones/{{ c.id }}/eliminar" class="inline" data-confirm="¿Eliminar definitivamente la cotización {{ c.folio }}?">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <button class="btn btn--sm btn--ghost" type="submit" title="Eliminar">🗑️</button>
              </form>
            {% endif %}
          </td>
        </tr>
      {% else %}<tr><td colspan="7" class="muted">📭 Sin cotizaciones que coincidan.{% if can('cotizaciones:crear') %} <a href="/app/cotizaciones/nueva">Crea la primera</a>.{% endif %}</td></tr>{% endfor %}
    </tbody>
  </table>
{% endblock %}
