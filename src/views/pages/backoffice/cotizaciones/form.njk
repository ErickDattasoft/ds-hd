{% extends "layouts/backoffice.njk" %}
{% block title %}{{ titulo }}{% endblock %}
{% block content %}
  <h1>{{ titulo }}</h1>
  {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}
  {% if errores.conceptos %}<p class="alert alert--error">{{ errores.conceptos }}</p>{% endif %}

  <form method="post" action="{{ '/app/cotizaciones/' + cotizacion.id if modo == 'editar' else '/app/cotizaciones' }}" class="form form--wide">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    {% if valores.origenCalculadora %}<input type="hidden" name="origenCalculadora" value="true" />{% endif %}

    {% if modo != 'editar' %}
      <label class="field"><span>Empresa</span>
        <select name="empresaId" required>
          <option value="">— selecciona —</option>
          {% for e in empresas %}<option value="{{ e.id }}" {{ 'selected' if valores.empresaId == e.id }}>{{ e.nombre }}</option>{% endfor %}
        </select>
        {% if errores.empresaId %}<em class="field__error">{{ errores.empresaId }}</em>{% endif %}
      </label>
    {% else %}
      <p class="muted">{{ cotizacion.folio }} · {{ cotizacion.empresaNombre }}</p>
    {% endif %}

    <details class="disclosure"{{ ' open' if valores.emisorNombre or valores.rfc or valores.contactoNombre }}>
      <summary class="disclosure__summary">Datos generales <span class="disclosure__hint">— emisor y receptor</span></summary>
      <div class="disclosure__body form">
        <fieldset class="field">
          <legend>Emisor (quien cotiza)</legend>
          <label class="field"><span>Nombre</span><input name="emisorNombre" value="{{ valores.emisorNombre }}" /></label>
          <label class="field"><span>Cargo</span><input name="emisorCargo" value="{{ valores.emisorCargo }}" placeholder="Ej: Ejecutivo de Ventas" /></label>
          <label class="field"><span>Teléfono</span><input name="emisorTelefono" value="{{ valores.emisorTelefono }}" /></label>
          <label class="field"><span>Correo</span><input type="email" name="emisorCorreo" value="{{ valores.emisorCorreo }}" /></label>
        </fieldset>
        <fieldset class="field">
          <legend>Receptor</legend>
          <label class="field"><span>RFC</span><input name="rfc" value="{{ valores.rfc }}" placeholder="Ej: XAXX010101000" /></label>
          <label class="field"><span>Contacto</span><input name="contactoNombre" value="{{ valores.contactoNombre }}" /></label>
          <label class="field"><span>Correo del contacto</span><input type="email" name="contactoCorreo" value="{{ valores.contactoCorreo }}" /></label>
          <label class="field"><span>Teléfono del contacto</span><input name="contactoTelefono" value="{{ valores.contactoTelefono }}" /></label>
        </fieldset>
      </div>
    </details>

    <h2>Conceptos</h2>
    <table class="data-table">
      <thead><tr><th>Descripción</th><th>Cantidad</th><th>Precio unitario</th></tr></thead>
      <tbody>
        {% for c in valores.conceptos %}
          <tr>
            <td><input name="concepto_descripcion" value="{{ c.descripcion }}" style="width:100%" /></td>
            <td><input name="concepto_cantidad" type="number" step="1" value="{{ c.cantidad }}" /></td>
            <td><input name="concepto_precio" type="number" step="0.01" value="{{ c.precioUnitario }}" /></td>
          </tr>
        {% endfor %}
        {% for _ in [1,2,3,4,5] %}
          <tr>
            <td><input name="concepto_descripcion" placeholder="Nuevo concepto" style="width:100%" /></td>
            <td><input name="concepto_cantidad" type="number" step="1" value="1" /></td>
            <td><input name="concepto_precio" type="number" step="0.01" /></td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    <details class="disclosure" open>
      <summary class="disclosure__summary">Condiciones y notas <span class="disclosure__hint">— términos, vigencia</span></summary>
      <div class="disclosure__body form">
        {% if modo != 'editar' %}
          <label class="field"><span>Vigencia (días)</span><input type="number" name="vigenciaDias" value="{{ valores.vigenciaDias or 15 }}" min="1" /></label>
        {% endif %}
        <label class="field"><span>Condiciones / términos</span>
          <textarea name="condiciones" rows="4">{{ valores.condiciones }}</textarea>
          <em class="field__hint">Forma de pago, tiempos de entrega, validez… Se muestran en el PDF y el correo.</em>
        </label>
        <label class="field"><span>Notas</span><textarea name="notas" rows="3">{{ valores.notas }}</textarea></label>
      </div>
    </details>

    <div class="page-head__actions">
      <button class="btn" type="submit">Guardar</button>
      <a class="btn btn--ghost" href="/app/cotizaciones">Cancelar</a>
    </div>
  </form>
{% endblock %}
