{% extends "layouts/backoffice.njk" %}
{% block title %}Papelera{% endblock %}

{% macro seccion(tipo, titulo, filas, cols) %}
  <section class="card" id="{{ tipo }}">
    <div class="page-head">
      <h2>{{ titulo }} ({{ filas | length }})</h2>
      {% if filas | length %}
        <form method="post" action="/app/papelera/vaciar" class="inline"
              data-confirm="¿Vaciar la papelera de {{ tipo }}? Se borran definitivamente {{ filas | length }} elemento(s).{{ ' Los folios se conservan como «Ticket eliminado por administrador».' if tipo == 'tickets' }} No se puede deshacer.">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <input type="hidden" name="tipo" value="{{ tipo }}" />
          <button class="btn btn--sm btn--danger" type="submit">Vaciar</button>
        </form>
      {% endif %}
    </div>

    {% if filas | length %}
      {# Botones por fila (↩️ / 🔥, como el viejo): van a este form aparte para no arrastrar las casillas marcadas. #}
      <form id="uno-{{ tipo }}" method="post" hidden>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <input type="hidden" name="tipo" value="{{ tipo }}" />
      </form>
      <form method="post" data-confirm="¿Aplicar la acción a los elementos seleccionados?">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <input type="hidden" name="tipo" value="{{ tipo }}" />
        <table class="data-table">
          <thead>
            <tr>
              <th data-no-ordenar><input type="checkbox" data-seleccionar-todo title="Seleccionar todos" aria-label="Seleccionar todos" /></th>
              {% for c in cols %}<th>{{ c }}</th>{% endfor %}
              <th>En la papelera desde</th>
              <th data-no-ordenar></th>
            </tr>
          </thead>
          <tbody>
            {% for f in filas %}
              <tr>
                <td><input type="checkbox" name="ids" value="{{ f.id }}" /></td>
                {{ caller(f) }}
                <td class="muted">{{ f.updatedAt | fecha }}</td>
                <td>
                  <button class="btn btn--ghost btn--sm" type="submit" form="uno-{{ tipo }}" formaction="/app/papelera/restaurar" name="ids" value="{{ f.id }}" title="Restaurar">↩️</button>
                  <button class="btn btn--ghost btn--sm" type="submit" form="uno-{{ tipo }}" formaction="/app/papelera/eliminar" name="ids" value="{{ f.id }}" title="Eliminar definitivamente"
                          data-confirm="¿Eliminar definitivamente? Esta acción no se puede deshacer.">🔥</button>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        <div class="page-head__actions">
          <button class="btn btn--sm btn--secondary" type="submit" formaction="/app/papelera/restaurar">Restaurar seleccionados</button>
          <button class="btn btn--sm btn--danger" type="submit" formaction="/app/papelera/eliminar"
                  data-confirm="¿Borrar definitivamente los elementos seleccionados?{{ ' Los folios se conservan como «Ticket eliminado por administrador».' if tipo == 'tickets' }} No se puede deshacer.">Eliminar definitivo</button>
        </div>
      </form>
    {% else %}
      <p class="muted">Nada archivado.</p>
    {% endif %}
  </section>
{% endmacro %}

{% block content %}
  <h1>Papelera de reciclaje</h1>
  <p class="muted">Elementos archivados. Restáuralos, bórralos definitivamente o vacía la papelera. Mientras un ticket está aquí, y también después de borrarlo, su folio aparece en la lista como «Ticket eliminado por administrador», para que la numeración siga completa. Al restaurarlo vuelve a su lugar.</p>

  {% if aviso %}<div class="alert alert--ok" role="status">{{ aviso }}</div>{% endif %}

  {% call(e) seccion('empresas', 'Empresas archivadas', empresas, ['Nombre', 'RFC']) %}
    <td>{{ e.nombre }}</td><td class="muted">{{ e.rfc or '—' }}</td>
  {% endcall %}

  {% call(c) seccion('contactos', 'Contactos archivados', contactos, ['Nombre', 'Empresa', 'Correo']) %}
    <td>{{ c.nombre }}</td><td>{{ nombreEmpresa[c.empresaId] or '(empresa eliminada)' }}</td><td class="muted">{{ c.email or '—' }}</td>
  {% endcall %}

  {% call(t) seccion('tickets', 'Tickets archivados', tickets, ['#', 'Asunto']) %}
    <td><a href="/app/tickets/{{ t.id }}">#{{ t.numero }}</a></td><td>{{ t.asunto }}</td>
  {% endcall %}
{% endblock %}
