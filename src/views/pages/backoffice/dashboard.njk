{% extends "layouts/backoffice.njk" %}
{% block title %}Dashboard{% endblock %}
{#
  Gráficas del dashboard. Se dibujan con CSS (ver "Gráficas" en components.css): el servidor
  manda los conteos y aquí solo se traducen a porcentajes, así que no entra ninguna librería
  de charts al worker.
#}

{# Columnas: una serie sobre el tiempo, de una sola tinta — los meses no son identidades
   distintas, así que darle un color a cada uno sería ruido. El eje se redondea a un múltiplo
   de 4 para que las cuatro marcas caigan en números enteros. #}
{% macro columnas(datos) %}
  {% set max = (datos | sort(true, false, 'valor') | first).valor or 0 %}
  {% set tope = (((max / 4) | round(0, 'ceil')) * 4) if max else 4 %}
  <div class="chart chart-cols">
    <div class="chart-cols__y" aria-hidden="true">
      {% for i in [4, 3, 2, 1, 0] %}<span>{{ (tope * i / 4) | round }}</span>{% endfor %}
    </div>
    <div class="chart-cols__plot">
      <span class="chart-cols__rejilla"></span>
      {% for d in datos %}
        <div class="chart-cols__col">
          <span class="chart-cols__medida" style="height: {{ (d.valor / tope * 100) | round(2) }}%">
            <span class="chart-cols__val">{{ d.valor }}</span>
            <span class="chart-cols__bar{{ ' chart-cols__bar--cero' if not d.valor }}"></span>
          </span>
        </div>
      {% endfor %}
    </div>
    <div class="chart-cols__x">
      {% for d in datos %}<span>{{ d.etiqueta }}</span>{% endfor %}
    </div>
  </div>
{% endmacro %}

{# Reparto (parte sobre el total): barra apilada horizontal con leyenda. Se prefiere a una
   dona porque las etiquetas de estado son largas y aquí se leen completas, y porque comparar
   longitudes es más fácil que comparar ángulos. El color va por posición (el servidor manda
   los segmentos ya ordenados) y el valor siempre va escrito, para no depender del tono. #}
{% macro reparto(datos) %}
  {% set total = datos | sum('valor') %}
  {% if total %}
    <div class="chart">
      <div class="chart-stack" role="img"
           aria-label="{% for d in datos %}{{ d.etiqueta }}: {{ d.valor }}. {% endfor %}">
        {% for d in datos %}
          <span class="chart-stack__seg serie-{{ loop.index if loop.index < 7 else 'otros' }}"
                style="width: {{ (d.valor / total * 100) | round(2) }}%"></span>
        {% endfor %}
      </div>
      <div class="chart-legend">
        {% for d in datos %}
          <span class="chart-legend__item">
            <span class="chart-legend__dot serie-{{ loop.index if loop.index < 7 else 'otros' }}"></span>
            {{ d.etiqueta }}
            <span class="chart-legend__val">{{ d.valor }}</span>
            <span class="chart-legend__pct">({{ (d.valor / total * 100) | round }}%)</span>
          </span>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <p class="chart-vacio">Nada que mostrar todavía.</p>
  {% endif %}
{% endmacro %}
{% block content %}
  <div class="page-head">
    <h1>Hola, {{ user.nombre }}</h1>
    <div class="page-head__actions">
      <a class="btn btn--sm btn--secondary" href="/app/calendario">📅 Calendario</a>
      {% if can('seguimiento:gestionar') %}
        <details class="disclosure" style="display:inline-block">
          <summary class="btn btn--sm">➕ Nueva tarea</summary>
          <form method="post" action="/app/tareas" class="form card" style="margin-top:0.5rem;min-width:16rem">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <input type="hidden" name="volverA" value="/app" />
            <label class="field"><span>Título</span><input name="titulo" required /></label>
            <label class="field"><span>Vence</span><input type="date" name="vence" /></label>
            <button class="btn btn--sm" type="submit">Crear</button>
          </form>
        </details>
      {% endif %}
    </div>
  </div>

  {% if m %}

  {% if m.ticketsPublicosPendientes %}
  <div class="alert alert--warn" role="alert">
    <p><strong>{{ m.ticketsPublicosPendientes }}</strong> ticket{{ 's' if m.ticketsPublicosPendientes != 1 }} público{{ 's' if m.ticketsPublicosPendientes != 1 }} esperando revisión.
    <a class="btn btn--secondary btn--sm" href="/app/tickets/buzon">Ir al buzón</a></p>
  </div>
  {% endif %}

  {% if m.licencias and m.licencias.banner | length %}
  {% set firmas = [] %}
  {% for e in m.licencias.banner %}{% set _ = firmas.push(e.empresaId + '|' + e.vencidas + '|' + e.porVencer + '|' + e.diasMin) %}{% endfor %}
  <div class="alert alert--warn" role="alert" id="banner-licencias"
       data-firma-alertas="{{ firmas | sort | join(';') }}">
    <p><strong>Licencias por vencer</strong> — {{ m.licencias.empresasEnRiesgo }}
    empresa{{ 's' if m.licencias.empresasEnRiesgo != 1 }} con
    {{ m.licencias.vencidas }} vencida{{ 's' if m.licencias.vencidas != 1 }} y
    {{ m.licencias.porVencer }} por vencer.</p>
    <ul class="alert__list">
      {% for e in m.licencias.banner %}
        <li>
          <a href="/app/empresas/{{ e.empresaId }}">{{ e.nombre }}</a>
          {% if e.vencidas %}<span class="badge badge--danger">{{ e.vencidas }} vencida{{ 's' if e.vencidas != 1 }}</span>{% endif %}
          {% if e.porVencer %}<span class="badge badge--warning">{{ e.porVencer }} por vencer</span>{% endif %}
          {% if e.diasMin >= 0 %}<span class="muted">en {{ e.diasMin }} d</span>{% else %}<span class="muted">hace {{ 0 - e.diasMin }} d</span>{% endif %}
        </li>
      {% endfor %}
    </ul>
    <div class="page-head__actions">
      <a class="btn btn--secondary btn--sm" href="/app/empresas?pendientes=1">Ver todas y avisar</a>
      <button type="button" class="btn btn--ghost btn--sm" data-descartar-banner="#banner-licencias">✕ Descartar</button>
    </div>
  </div>
  {% endif %}

  <div class="stat-row">
    <a class="stat" href="/app/tickets"><span class="stat__num">{{ m.tickets.abiertos }}</span><span class="stat__lbl">Tickets abiertos</span></a>
    <a class="stat stat--danger" href="/app/tickets?prioridad="><span class="stat__num">{{ m.tickets.vencidos }}</span><span class="stat__lbl">SLA vencido</span></a>
    <a class="stat" href="/app/tickets?sinAsignar=1"><span class="stat__num">{{ m.tickets.sinAsignar }}</span><span class="stat__lbl">Sin asignar</span></a>
    <a class="stat" href="/app/tareas"><span class="stat__num">{{ m.misTareasPendientes }}</span><span class="stat__lbl">Mis tareas</span></a>
    <div class="stat"><span class="stat__num">{{ m.cotizaciones.totalAbiertas }}</span><span class="stat__lbl">Cotizaciones abiertas</span></div>
    {% if m.licencias %}
    <a class="stat{{ ' stat--danger' if m.licencias.avisosPendientes }}" href="/app/empresas?pendientes=1"><span class="stat__num">{{ m.licencias.avisosPendientes }}</span><span class="stat__lbl">Avisos pendientes</span></a>
    <a class="stat" href="/app/empresas"><span class="stat__num">{{ m.licencias.totalEmpresas }}</span><span class="stat__lbl">Empresas</span></a>
    {% endif %}
  </div>

  <div class="dash-grid">
    <div class="card">
      <h2>Tickets por mes <span class="muted">(últimos 6 meses)</span></h2>
      {{ columnas(m.tickets.porMes) }}
    </div>
    <div class="card">
      <h2>Tickets abiertos por estado</h2>
      {{ reparto(m.tickets.porEstado) }}
    </div>
    <div class="card">
      <h2>Tickets abiertos por prioridad</h2>
      {{ reparto(m.tickets.porPrioridad) }}
    </div>
    <div class="card">
      <h2>Cotizaciones por estado</h2>
      {{ reparto(m.cotizaciones.porEstado) }}
    </div>
    <div class="card">
      <h2>Próximos eventos</h2>
      <ul>
        {% for e in m.proximosEventos %}<li><a href="/app/eventos/{{ e.id }}">{{ e.titulo }}</a> <span class="muted">{{ e.fechaHora | fechahora }}</span></li>
        {% else %}<li class="muted">Ninguno programado.</li>{% endfor %}
      </ul>
    </div>
    {% if m.actividadReciente | length %}
    <div class="card" style="grid-column:1/-1">
      <h2>Actividad reciente</h2>
      <ul class="timeline">
        {% for a in m.actividadReciente %}<li><span class="muted">{{ a.at | fechahora }}</span> · <strong>{{ a.modulo }}</strong> — {{ a.resumen }} <span class="muted">{{ a.actorNombre }}</span></li>{% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>
  {% else %}
    <p class="muted">Sin métricas disponibles.</p>
  {% endif %}
{% endblock %}
