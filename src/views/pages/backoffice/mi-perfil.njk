{% extends "layouts/backoffice.njk" %}
{% block title %}Mi perfil{% endblock %}
{% block content %}
  <h1>Mi perfil</h1>
  {% if guardado %}<p class="alert alert--ok">Guardado.</p>{% endif %}
  <form method="post" action="/app/mi-perfil" class="form form--wide">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

    <div class="card">
      <label class="field"><span>Firma</span>
        <textarea name="firma" rows="5" placeholder="Ej. Saludos, Erick Casas — Soporte DATTASOFT">{{ firma }}</textarea>
      </label>
      <p class="muted">Se agrega al final de tus respuestas públicas en tickets, y con el botón 🖊️ Firma al redactar.</p>
    </div>

    <div class="card">
      <label class="field"><span>Encabezado</span>
        <textarea name="encabezado" rows="6" placeholder="Vacío = usar la plantilla por defecto (Fecha / Síntoma / Problema / Solución / Tiempo trabajado)">{{ encabezado }}</textarea>
      </label>
      <p class="muted">Se inserta con el botón 📋 Encabezado al redactar un ticket. Usa <code>[fecha]</code> y se reemplaza por la fecha de hoy.</p>
    </div>

    <button class="btn" type="submit">Guardar</button>
  </form>

  <form method="post" action="/app/mi-perfil/contrasena" class="form form--wide card" id="contrasena" autocomplete="off">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    <h2>🔐 Cambiar mi contraseña</h2>
    {% if passGuardada %}<p class="alert alert--ok">Contraseña actualizada.</p>{% endif %}
    {% if erroresPass.general %}<p class="alert alert--error">{{ erroresPass.general }}</p>{% endif %}
    <label class="field"><span>Contraseña actual</span>
      <input type="password" name="actual" autocomplete="current-password" required />
      {% if erroresPass.actual %}<em class="field__error">{{ erroresPass.actual }}</em>{% endif %}
    </label>
    <label class="field"><span>Contraseña nueva</span>
      <input type="password" name="password" minlength="8" autocomplete="new-password" required />
      {% if erroresPass.password %}<em class="field__error">{{ erroresPass.password }}</em>{% endif %}
    </label>
    <label class="field"><span>Confirmar contraseña nueva</span>
      <input type="password" name="passwordConfirmacion" minlength="8" autocomplete="new-password" required />
      {% if erroresPass.passwordConfirmacion %}<em class="field__error">{{ erroresPass.passwordConfirmacion }}</em>{% endif %}
    </label>
    <button class="btn btn--secondary" type="submit">Cambiar contraseña</button>
  </form>
{% endblock %}
