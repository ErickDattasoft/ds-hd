{% extends "layouts/backoffice.njk" %}
{% import "components/tickets.njk" as tk %}
{% block title %}Ticket #{{ ticket.numero }}{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>#{{ ticket.numero }} — {{ ticket.asunto }}</h1>
    <a class="btn btn--sm btn--ghost" href="/app/tickets">← Volver</a>
  </div>

  <div class="ticket-grid">
    <section>
      <div class="card">
        <p><strong>Descripción</strong></p>
        <p>{{ ticket.descripcion }}</p>
      </div>

      <div class="card">
        <p><strong>Conversación</strong></p>
        {% for n in notas %}
          <div class="nota nota--{{ n.tipo }}">
            <div class="nota__head">
              <span>{{ n.autorNombre }}</span>
              {% if n.tipo == 'interna' %}<span class="badge badge--warning">interna</span>{% endif %}
            </div>
            <p>{{ n.cuerpo }}</p>
          </div>
        {% else %}<p class="muted">Sin notas todavía.</p>{% endfor %}

        {% if permisos.editar %}
          <form method="post" action="/app/tickets/{{ ticket.id }}/nota" class="form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <textarea name="cuerpo" rows="3" required placeholder="Escribe una respuesta…"></textarea>
            <label class="field--check">
              <input type="checkbox" name="tipo" value="interna" {{ 'disabled' if not permisos.notasInternas }} />
              <span>Nota interna (no visible para el cliente)</span>
            </label>
            <button class="btn btn--sm" type="submit">Agregar nota</button>
          </form>
        {% endif %}
      </div>

      <div class="card">
        <p><strong>Línea de tiempo</strong> <span class="muted">— duración por estado</span></p>
        <ul class="tl">
          {% for tr in vm.lineaDeTiempo %}
            <li class="tl__item {{ 'tl__item--cuenta' if tr.cuenta else 'tl__item--espera' }}">
              <span class="tl__dot" aria-hidden="true"></span>
              <span class="tl__estado">{{ tr.estado }}</span>
              <span class="tl__meta muted">{{ tr.desdeIso | fechahora }}</span>
              <span class="tl__dur">{{ '✅' if tr.cuenta else '⏳' }} {{ tr.duracion }}</span>
            </li>
          {% endfor %}
        </ul>
        {% if vm.totalFacturable.visible %}
          <p class="tl__total">
            <strong>Total facturable:</strong>
            <span class="badge badge--{{ 'ok' if vm.totalFacturable.clase == 'consultoria' else 'warning' }}">
              {{ '💼' if vm.totalFacturable.clase == 'consultoria' else 'ℹ️' }} {{ vm.totalFacturable.texto }}
            </span>
            {% if vm.totalFacturable.clase == 'referencia' %}<span class="muted">(referencia, no se factura por hora)</span>{% endif %}
          </p>
        {% endif %}
      </div>

      <details class="disclosure">
        <summary class="disclosure__summary">Historial de actividad</summary>
        <div class="disclosure__body">
          <ul class="timeline">
            {% for e in eventos %}<li><span class="muted">{{ e.at | fechahora }}</span> — {{ e.resumen }}{% if e.actorNombre %} ({{ e.actorNombre }}){% endif %}</li>{% endfor %}
          </ul>
        </div>
      </details>
    </section>

    <aside class="ticket-side">
      <div class="card">
        <p><strong>Estado:</strong> <span class="badge badge--estado">{{ ticket.estado }}</span></p>
        <p><strong>Prioridad:</strong> {{ ticket.prioridad }}</p>
        <p><strong>SLA:</strong> {{ tk.slaBadge(vm) }}</p>
        <p><strong>Tiempo trabajado:</strong> {{ vm.tiempoTrabajado }}
          {% if vm.tiempoEsManual %}<span class="badge" title="Ajustado a mano">✏️</span> <span class="muted">(auto: {{ vm.tiempoTrabajadoAuto }})</span>{% endif %}
        </p>
        <p><strong>Facturación:</strong>
          {% if vm.facturacion.clase %}<span class="badge badge--{{ vm.facturacion.clase }}">{{ vm.facturacion.etiqueta }}</span>{% else %}{{ vm.facturacion.etiqueta }}{% endif %}
        </p>
        <p><strong>Agente:</strong> {{ ticket.agenteAsignadoNombre or 'Sin asignar' }}</p>
        <p><strong>Empresa:</strong> {{ ticket.empresaNombre or '—' }}</p>
        <p><strong>Canal:</strong> {{ ticket.canal }}</p>
        {% if vm.agenda %}
          <p><strong>📅 Programado:</strong>
            <span class="badge badge--{{ 'danger' if vm.agenda.vencida else 'ok' }}">{{ vm.agenda.texto }}</span>
            {% if vm.agenda.recordatorioWhatsapp %}<span class="badge" title="Recordatorio WhatsApp 30 min antes">🔔 WhatsApp</span>{% endif %}
          </p>
        {% endif %}
      </div>

      {% if permisos.cambiarEstado %}
        <form method="post" action="/app/tickets/{{ ticket.id }}/estado" class="card form">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <label class="field"><span>Cambiar estado</span>
            <select name="estado">
              {% for e in config.estados %}{% if e != ticket.estado %}<option>{{ e }}</option>{% endif %}{% endfor %}
            </select>
          </label>
          <textarea name="nota" rows="2" placeholder="Nota interna opcional"></textarea>
          <button class="btn btn--sm" type="submit">Actualizar estado</button>
        </form>
      {% endif %}

      {% if permisos.asignar %}
        <details class="disclosure"{{ ' open' if not ticket.agenteAsignadoUid }}>
          <summary class="disclosure__summary">Asignación <span class="disclosure__hint">— {{ ticket.agenteAsignadoNombre or 'sin asignar' }}</span></summary>
          <form method="post" action="/app/tickets/{{ ticket.id }}/asignar" class="form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <label class="field"><span>Asignar a</span>
              <select name="agenteUid">
                {% for a in agentes %}<option value="{{ a.uid }}" {{ 'selected' if a.uid == ticket.agenteAsignadoUid }}>{{ a.nombre }}</option>{% endfor %}
              </select>
            </label>
            <label class="field--check"><input type="checkbox" name="forzar" /> <span>Ignorar límite de capacidad</span></label>
            <button class="btn btn--sm" type="submit">Asignar</button>
          </form>
        </details>
      {% endif %}

      {% if permisos.editar %}
        <details class="disclosure">
          <summary class="disclosure__summary">⏱️ Tiempo trabajado <span class="disclosure__hint">— {{ vm.tiempoTrabajado }}{{ ' (manual)' if vm.tiempoEsManual }}</span></summary>
          <form method="post" action="/app/tickets/{{ ticket.id }}/tiempo" class="form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <p class="muted">Automático: {{ vm.tiempoTrabajadoAuto }}. Ajusta a mano si no refleja el trabajo real.</p>
            <div class="page-head__actions">
              <label class="field"><span>Horas</span><input type="number" name="horas" min="0" value="0" /></label>
              <label class="field"><span>Minutos</span><input type="number" name="minutos" min="0" max="59" value="0" /></label>
            </div>
            <button class="btn btn--sm" type="submit">Guardar ajuste</button>
          </form>
          {% if vm.tiempoEsManual %}
            <form method="post" action="/app/tickets/{{ ticket.id }}/tiempo" class="disclosure__body">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <input type="hidden" name="quitar" value="true" />
              <button class="btn btn--sm btn--ghost" type="submit">Quitar ajuste (volver al automático)</button>
            </form>
          {% endif %}
        </details>

        <details class="disclosure">
          <summary class="disclosure__summary">Facturación <span class="disclosure__hint">— {{ vm.facturacion.etiqueta }}</span></summary>
          <form method="post" action="/app/tickets/{{ ticket.id }}/facturar" class="form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <label class="field"><span>Estado</span>
              <select name="estado">
                {% for ef in estadosFacturacion %}<option value="{{ ef.valor }}" {{ 'selected' if ticket.facturacion.estado == ef.valor }}>{{ ef.etiqueta }}</option>{% endfor %}
              </select>
            </label>
            <button class="btn btn--sm" type="submit">Guardar</button>
          </form>
        </details>
      {% endif %}

      {% if permisos.editar %}
        <details class="disclosure"{{ ' open' if vm.agenda.vencida }}>
          <summary class="disclosure__summary">📅 Programar atención <span class="disclosure__hint">— {{ vm.agenda.texto if vm.agenda else 'sin programar' }}</span></summary>
          <form method="post" action="/app/tickets/{{ ticket.id }}/agenda" class="form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <label class="field"><span>Fecha</span>
              <input type="date" name="agendaFecha" value="{{ vm.agenda.fecha }}" required />
            </label>
            <label class="field"><span>Hora</span>
              <input type="time" name="agendaHora" value="{{ vm.agenda.hora or '09:00' }}" />
            </label>
            <label class="field--check">
              <input type="checkbox" name="agendaRecordatorio" {{ 'checked' if vm.agenda.recordatorioWhatsapp }} />
              <span>Recordatorio WhatsApp 30 min antes (vía n8n)</span>
            </label>
            <button class="btn btn--sm" type="submit">Guardar</button>
          </form>
          {% if vm.agenda %}
            <form method="post" action="/app/tickets/{{ ticket.id }}/agenda" class="disclosure__body">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <input type="hidden" name="agendaFecha" value="" />
              <button class="btn btn--sm btn--ghost" type="submit">Quitar programación</button>
            </form>
          {% endif %}
        </details>
      {% endif %}

      {% if permisos.eliminar %}
        <details class="disclosure">
          <summary class="disclosure__summary">Administración</summary>
          <form method="post" action="/app/tickets/{{ ticket.id }}/archivar" class="disclosure__body" data-confirm="¿{{ 'Restaurar' if ticket.archivado else 'Enviar a la papelera' }} este ticket?">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <input type="hidden" name="archivar" value="{{ 'false' if ticket.archivado else 'true' }}" />
            <button class="btn btn--sm {{ 'btn--secondary' if ticket.archivado else 'btn--danger' }}" type="submit">{{ 'Restaurar ticket' if ticket.archivado else 'Enviar a la papelera' }}</button>
          </form>
        </details>
      {% endif %}
    </aside>
  </div>
{% endblock %}
