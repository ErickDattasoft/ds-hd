{% extends "layouts/backoffice.njk" %}
{% import "components/tickets.njk" as tk %}
{% block title %}Ticket #{{ ticket.numero }}{% endblock %}
{% block content %}
{# Un mensaje de la conversación o una nota interna (mismo diseño, ⋮ para editar/borrar). #}
{% macro mensaje(n, ticket, csrfToken) %}
            {% set cuerpo = (n.cuerpo | sinMarcasMigracion) if n.autorUid == 'migracion' else n.cuerpo %}
            {% if cuerpo or (n.adjuntoIds and n.adjuntoIds.length) %}
            {% set recibida = n.autorUid == 'correo-entrante' or n.correoDe %}
            {# Los migrados del viejo no dicen quién escribió: si el autor es el contacto del ticket, es del cliente. #}
            {% set deCliente = recibida or (ticket.solicitanteUid and n.autorUid == ticket.solicitanteUid)
              or (n.autorUid == 'migracion' and ticket.contactoNombre and (n.autorNombre | lower | trim) == (ticket.contactoNombre | lower | trim)) %}
            <div class="chat__msg {{ 'chat__msg--interna' if n.tipo == 'interna' else ('chat__msg--cliente' if deCliente else 'chat__msg--equipo') }}">
              <div class="chat__meta">
                <span class="chat__autor">{{ '🔒' if n.tipo == 'interna' else ('📥' if recibida else ('👤' if deCliente else '📤')) }} <span class="{{ 'nombre-sensible' if deCliente }}">{{ n.autorNombre }}</span></span>
                {% if n.correoDe and n.correoDe != n.autorNombre %}<span class="muted sensible">&lt;{{ n.correoDe }}&gt;</span>{% endif %}
                {% if n.tipo == 'interna' %}<span class="badge badge--warning">interna</span>{% endif %}
                {% if n.modificable %}
                  <details class="chat__menu">
                    <summary title="Opciones del mensaje" aria-label="Opciones del mensaje">⋮</summary>
                    <div class="chat__menu-lista">
                      <button type="button" data-nota-editar>✏️ Editar</button>
                      <form method="post" action="/app/tickets/{{ ticket.id }}/notas/{{ n.id }}/eliminar">
                        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                        <button type="submit" data-confirm="¿Eliminar este mensaje de la conversación?{{ ' Si ya se mandó por correo, al cliente le sigue llegando el original.' if n.tipo == 'publica' and not deCliente }}">🗑 Eliminar</button>
                      </form>
                    </div>
                  </details>
                {% endif %}
              </div>
              <div class="chat__cuerpo" data-nota-cuerpo>{{ cuerpo }}</div>
              {% if n.modificable %}
                <form method="post" action="/app/tickets/{{ ticket.id }}/notas/{{ n.id }}/editar" class="chat__editar" data-nota-edicion hidden>
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                  <textarea name="cuerpo" rows="3" required>{{ cuerpo }}</textarea>
                  {% if n.tipo == 'publica' and not deCliente %}<p class="muted chat__editar-aviso">Solo cambia aquí y en el portal: no se vuelve a mandar correo.</p>{% endif %}
                  <div class="chat__editar-botones">
                    <button type="button" class="btn btn--ghost btn--sm" data-nota-cancelar>Cancelar</button>
                    <button type="submit" class="btn btn--sm">Guardar</button>
                  </div>
                </form>
              {% endif %}
              {% if n.adjuntoIds and n.adjuntoIds.length %}
                <div class="nota__imgs">
                  {% for aid in n.adjuntoIds %}<a href="/app/tickets/{{ ticket.id }}/adjuntos/{{ aid }}" target="_blank" rel="noopener"><img src="/app/tickets/{{ ticket.id }}/adjuntos/{{ aid }}" alt="Captura {{ loop.index }}" class="adjunto-thumb" loading="lazy" /></a>{% endfor %}
                </div>
              {% endif %}
              <div class="chat__hora">{% if n.editadaEn %}<span title="Editado {{ n.editadaEn | fechahora }}">editado · </span>{% endif %}{{ n.createdAt | fechahora }}{% if recibida %} · por correo{% endif %}</div>
            </div>
            {% endif %}
{% endmacro %}
  <div class="page-head">
    <h1>#{{ ticket.numero }} — {{ ticket.asunto }}</h1>
    <div class="page-head__actions">
      {% if permisos.editar and not ticket.eliminadoPorAdmin %}<a class="btn btn--sm" href="/app/tickets/{{ ticket.id }}/editar">✏️ Editar</a>{% endif %}
      <a class="btn btn--sm btn--ghost" href="/app/tickets/{{ ticket.id }}/imprimir?auto=1" target="_blank" rel="noopener">🖨️ Imprimir</a>
      {% if cotizacionLigada %}
        <a class="btn btn--sm btn--ghost" href="/app/cotizaciones/{{ cotizacionLigada.id }}" title="Cotización hecha desde este ticket">🧾 Cotización: {{ cotizacionLigada.folio }}</a>
      {% endif %}
      {# Como el viejo: ya no se ofrece «Cotizar» si hay una cotización ligada que no fue rechazada. #}
      {% if permisos.cotizar and (not cotizacionLigada or cotizacionLigada.estado == 'rechazada') %}
        <a class="btn btn--sm btn--ghost" href="/app/cotizaciones/nueva?empresa={{ ticket.empresaId or '' }}&ticket={{ ticket.id }}&ticketNumero={{ ticket.numero }}&contacto={{ (ticket.contactoNombre or '') | urlencode }}&correo={{ (ticket.contactoCorreo or '') | urlencode }}&conceptos=[{{ '{' }}&quot;descripcion&quot;:&quot;{{ ticket.asunto }}&quot;,&quot;cantidad&quot;:1,&quot;precioUnitario&quot;:0{{ '}' }}]">🧾 Cotizar</a>
      {% endif %}
      {% if permisos.eliminar and not ticket.eliminadoPorAdmin %}<button type="submit" form="archivar-ticket" class="btn btn--sm btn--ghost" title="{{ 'Restaurar ticket' if ticket.archivado else 'Enviar a la papelera' }}">{{ '♻️ Restaurar' if ticket.archivado else '🗑️ Papelera' }}</button>{% endif %}
      <a class="btn btn--sm btn--ghost" href="/app/tickets">← Volver</a>
    </div>
  </div>
  {% if ticket.preTicket %}<p class="alert">📝 <strong>Pre-ticket</strong> de la ⚡ Captura rápida. Revísalo con <a href="/app/tickets/{{ ticket.id }}/editar">✏️ Editar</a> (tipo, sistema, contacto…) y al guardar queda como ticket normal.</p>{% endif %}

  {% if aviso == 'correo-reenviado' %}
    <p class="alert alert--ok">✉️ Correo reenviado{% if avisoDetalle %} a {{ avisoDetalle }}{% endif %}.</p>
  {% elif aviso == 'correo-sin-destinatario' %}
    <p class="alert alert--warn">No se pudo reenviar: el ticket no tiene correo de contacto y no hay correos de notificación configurados.</p>
  {% endif %}

  <div class="ticket-grid">
    <section>
      {# Conversación tipo chat: la solicitud original es el primer mensaje, luego todo en orden
         (lo más reciente abajo, junto a la caja para escribir). Cliente a la izquierda, equipo a la derecha. #}
      <div class="card chat" id="conversacion" data-marcar-leida="/app/tickets/{{ ticket.id }}/leida">
        <p class="chat__titulo"><strong>📝 Descripción</strong> <span class="muted">— lo que escribe el cliente a la izquierda · lo que le mandamos a la derecha</span></p>

        <div class="chat__hilo" data-chat-hilo data-chat-conteo="/app/tickets/{{ ticket.id }}/notas/conteo" data-chat-n="{{ notasTotal }}">
          <div class="chat__msg chat__msg--cliente">
            <div class="chat__meta">
              <span class="chat__autor">📝 <span class="nombre-sensible">{{ ticket.contactoNombre or ticket.solicitadoPor or 'Cliente' }}</span></span>
              <span class="badge">solicitud original</span>
            </div>
            <div class="chat__cuerpo ticket-descripcion">{{ descripcionHtml | safe }}</div>
            <div class="chat__hora">{{ (ticket.abiertoEn or ticket.createdAt) | fechahora }}</div>
          </div>


          {% for n in notas %}
            {{ mensaje(n, ticket, csrfToken) }}
          {% else %}
            <p class="muted chat__vacio">Sin respuestas todavía.</p>
          {% endfor %}
        </div>

        {% if permisos.editar %}
        {# Dos recuadros separados: lo que le llega al cliente y lo que solo ve el equipo (antes era
           una casilla y se confundían). Los dos van a la misma ruta; el interno manda tipo=interna. #}
        <div class="chat__escribir-grid">
          <form method="post" action="/app/tickets/{{ ticket.id }}/nota" class="form chat__escribir chat__escribir--cliente" data-nota-form>
            <h3 class="chat__escribir-titulo">💬 Respuesta al cliente <span class="muted">— se le manda por correo</span></h3>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <input type="hidden" name="imagenesNota" value="" data-nota-imagenes-campo />
            {{ tk.editorToolbar(user, '#nota-cuerpo', config.respuestas) }}
            <textarea name="cuerpo" id="nota-cuerpo" rows="3" required placeholder="Escribe la respuesta para el cliente… (puedes pegar capturas)"></textarea>
            <div class="nota__imgs" data-nota-imagenes-preview></div>
            <div class="chat__acciones">
              <details class="chat__mas">
                <summary class="muted">Con copia y capturas</summary>
                <label class="field"><span>Con copia (opcional, separados por coma)</span>
                  <input type="text" name="ccRespuesta" placeholder="otro@cliente.com, agente@dattasoft.mx" autocomplete="off" />
                </label>
                <label class="field"><span>🖼️ Capturas (solo imágenes)</span>
                  <input type="file" accept="image/png,image/jpeg,image/gif,image/webp" multiple data-nota-imagenes-file />
                </label>
              </details>
              <button class="btn btn--sm" type="submit">✉️ Enviar al cliente ➤</button>
            </div>
          </form>

          {% if permisos.notasInternas %}
          <div class="chat__escribir chat__escribir--interna notas-internas">
            <h3 class="chat__escribir-titulo">🔒 Notas internas <span class="muted">— solo el equipo, no manda correo</span></h3>
            <div class="notas-internas__lista">
              {% if notaInternaAnterior %}
          {# El campo «Notas internas» de antes (un solo texto por ticket): se muestra como nota, sin editar. #}
          <div class="chat__msg chat__msg--interna">
            <div class="chat__meta">
              <span class="chat__autor">🔒 Nota interna anterior</span>
              <span class="badge badge--warning">interna</span>
            </div>
            <div class="chat__cuerpo sensible" style="white-space: pre-line">{{ notaInternaAnterior }}</div>
          </div>
          {% endif %}
              {% for n in notasInternas %}
                {{ mensaje(n, ticket, csrfToken) }}
              {% else %}
                {% if not notaInternaAnterior %}<p class="muted notas-internas__vacio">Sin notas internas todavía.</p>{% endif %}
              {% endfor %}
            </div>
          <form method="post" action="/app/tickets/{{ ticket.id }}/nota" class="form notas-internas__form" data-nota-form>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <input type="hidden" name="tipo" value="interna" />
            <input type="hidden" name="imagenesNota" value="" data-nota-imagenes-campo />
            <textarea name="cuerpo" id="nota-interna-cuerpo" rows="3" required placeholder="Avances, pendientes, acuerdos… (el cliente no la ve; puedes pegar capturas)"></textarea>
            <div class="nota__imgs" data-nota-imagenes-preview></div>
            <div class="chat__acciones">
              <span></span>
              <button class="btn btn--sm btn--secondary" type="submit">🔒 Guardar nota interna</button>
            </div>
          </form>
          </div>
          {% endif %}
          {% if permisos.editar %}
          {# 🧾 Factura: el folio a la vista, junto a la respuesta al cliente y las notas internas. #}
          <div class="chat__escribir factura-box">
            <h3 class="chat__escribir-titulo">🧾 Factura <span class="muted">— {{ vm.facturacion.etiqueta }}</span></h3>
            {% if ticket.facturacion.folio %}
              <p class="factura-box__folio" title="Folio de factura">{{ ticket.facturacion.folio }}</p>
            {% else %}
              <p class="muted factura-box__sin">Sin folio todavía.</p>
            {% endif %}
            <form method="post" action="/app/tickets/{{ ticket.id }}/facturar" class="form factura-box__form"
                {%- if not ticket.esCerrado and estadoCerrado %} data-facturar-cerrar="{{ estadoCerrado }}" data-facturar-original="{{ ticket.facturacion.estado }}"{{ ' data-puede-cerrar' if permisos.cambiarEstado }}{% endif %}>
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <input type="hidden" name="cerrarCon" value="" />
                <label class="field"><span>Estado</span>
                  <select name="estado">
                    {% for ef in estadosFacturacion %}<option value="{{ ef.valor }}" {{ 'selected' if ticket.facturacion.estado == ef.valor }}>{{ ef.etiqueta }}</option>{% endfor %}
                  </select>
                </label>
                <label class="field"><span>🧾 Folio de factura</span>
                  <input type="text" name="folioFactura" value="{{ ticket.facturacion.folio or '' }}" maxlength="60" placeholder="Ej: SER 1445" autocomplete="off" />
                  <em class="field__hint">Se guarda sin mandar correo; sale en los correos del ticket y al imprimir.</em></label>
                {% if ticket.contactoCorreo %}
                <label class="field--check"><input type="checkbox" name="avisarFolio" />
                  <span>✉️ Mandárselo al cliente <span class="muted">({{ ticket.contactoCorreo }}, solo a él)</span></span></label>
                {% endif %}
                <div class="chat__acciones"><span></span><button class="btn btn--sm" type="submit">🧾 Guardar factura</button></div>
              </form>
          </div>
          {% endif %}
        </div>
        {% endif %}
      </div>

      {% if permisos.editar %}
        {# «Gestión» se quitó: Solicitado por / Canalizado a se llenan al crear el ticket (se ven en el
           panel de la derecha y se cambian con ✏️ Editar) y las notas internas van en su recuadro. #}
      {% endif %}

      {{ tk.adjuntosTicket(adjuntos, '/app/tickets/' + ticket.id, csrfToken, permisos.editar, permisos.editar) }}

      <div class="card">
        <p><strong>Línea de tiempo</strong> <span class="muted">— duración por estado</span></p>
        <ul class="tl">
          {% for tr in vm.lineaDeTiempo %}
            <li class="tl__item {{ 'tl__item--cuenta' if tr.cuenta else 'tl__item--espera' }}">
              <span class="tl__dot" aria-hidden="true"></span>
              <span class="tl__estado">{{ tr.estado }}</span>
              <span class="tl__meta muted">{{ tr.desdeIso | fechahora }}</span>
              <span class="tl__dur">{{ '✅' if tr.cuenta else '⏳' }} {{ tr.duracion }}</span>
            </li>
          {% endfor %}
        </ul>
        {% if vm.totalFacturable.visible %}
          <p class="tl__total">
            <strong>Total facturable:</strong>
            <span class="badge badge--{{ 'ok' if vm.totalFacturable.clase == 'consultoria' else 'warning' }}">
              {{ '💼' if vm.totalFacturable.clase == 'consultoria' else 'ℹ️' }} {{ vm.totalFacturable.texto }}
            </span>
            {% if vm.totalFacturable.clase == 'referencia' %}<span class="muted">(referencia, no se factura por hora)</span>{% endif %}
          </p>
        {% endif %}
      </div>

      <details class="disclosure" open>
        <summary class="disclosure__summary">Historial de actividad</summary>
        <div class="disclosure__body">
          {% if eventos and eventos.length %}
            <ul class="timeline">
              {% for e in eventos %}<li><span class="muted">{{ e.at | fechahora }}</span> — {{ e.resumen }}{% if e.actorNombre %} ({{ e.actorNombre }}){% endif %}</li>{% endfor %}
            </ul>
          {% else %}
            <p class="muted">Sin actividad registrada todavía.</p>
          {% endif %}
        </div>
      </details>

      {% if permisos.editar %}
        <form method="post" action="/app/tickets/{{ ticket.id }}/reenviar-correo" class="form">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <button class="btn btn--sm btn--secondary" type="submit">✉️ Reenviar correo</button>
          <span class="muted">— manda al contacto el resumen actual del ticket (con copia al equipo). Nunca incluye notas internas.</span>
        </form>
      {% endif %}
    </section>

    <aside class="ticket-side">
      <div class="card">
        <p><strong>Estado:</strong> <span class="{{ ticket.estado | estadoClase }}">{{ ticket.estado }}</span></p>
        <p><strong>Prioridad:</strong> <span class="{{ ticket.prioridad | prioridadClase }}">{{ ticket.prioridad }}</span></p>
        <p><strong>Tipo:</strong> {{ ticket.tipo or 'General' }}</p>
        <p><strong>SLA:</strong> {{ tk.slaBadge(vm) }}</p>
        {% if ticket.satisfaccion %}
          <p><strong>Satisfacción:</strong> <span title="{{ ticket.satisfaccion.comentario or '' }}">{% for i in range(ticket.satisfaccion.calificacion) %}★{% endfor %}</span> ({{ ticket.satisfaccion.calificacion }}/5)
            {% if ticket.satisfaccion.comentario %}<br><em class="muted">“{{ ticket.satisfaccion.comentario }}”</em>{% endif %}</p>
        {% endif %}
        <p><strong>Tiempo trabajado:</strong> {{ vm.tiempoTrabajado }}
          {% if vm.tiempoEsManual %}<span class="badge" title="Ajustado a mano">✏️</span> <span class="muted">(auto: {{ vm.tiempoTrabajadoAuto }})</span>{% endif %}
        </p>
        <p><strong>Facturación:</strong>
          {% if vm.facturacion.clase %}<span class="badge badge--{{ vm.facturacion.clase }}">{{ vm.facturacion.etiqueta }}</span>{% else %}{{ vm.facturacion.etiqueta }}{% endif %}
          {% if ticket.facturacion.folio %}<span title="Folio de factura">🧾 <strong>{{ ticket.facturacion.folio }}</strong></span>{% endif %}
        </p>
        <p><strong>Agente:</strong> {{ ticket.agenteAsignadoNombre or 'Sin asignar' }}</p>
        <p><strong>Empresa:</strong> <span class="nombre-sensible">{{ ticket.empresaNombre or '—' }}</span></p>
        <p><strong>Contacto:</strong> <span class="nombre-sensible">{{ ticket.contactoNombre or '—' }}</span>{% if ticket.contactoCorreo %} <span class="muted">({{ ticket.contactoCorreo }})</span>{% endif %}</p>
        <p><strong>Grupo:</strong> {{ ticket.grupo or '—' }}</p>
        <p><strong>Sistema:</strong> {{ ticket.sistema or '—' }}</p>
        {% if ticket.solicitadoPor %}<p><strong>Solicitado por:</strong> <span class="nombre-sensible">{{ ticket.solicitadoPor }}</span></p>{% endif %}
        {% if ticket.canalizadoA %}<p><strong>Canalizado a:</strong> {{ ticket.canalizadoA }}</p>{% endif %}
        <p><strong>Canal:</strong> {{ ticket.canal }}</p>
        {% if vm.agenda %}
          <p><strong>📅 Programado:</strong>
            <span class="badge badge--{{ 'danger' if vm.agenda.vencida else 'ok' }}">{{ vm.agenda.texto }}</span>
            {% if vm.agenda.recordatorioWhatsapp %}<span class="badge" title="Recordatorio WhatsApp 30 min antes">🔔 WhatsApp</span>{% endif %}
          </p>
        {% endif %}
      </div>

      {% if permisos.cambiarEstado %}
        <form method="post" action="/app/tickets/{{ ticket.id }}/estado" class="card form"
          {%- if permisos.editar and estadoCerrado and ticket.facturacion.estado == 'no_facturado' %} data-cerrar-cobro="{{ tk.opcionesCobro(estadosFacturacion) }}" data-estado-cerrado="{{ estadoCerrado }}" data-ticket-numero="{{ ticket.numero }}"{% endif %}>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <input type="hidden" name="facturarCon" value="" />
          <input type="hidden" name="estadoActual" value="{{ ticket.estado }}" />
          <label class="field"><span>🔄 Estado del ticket</span>
            <select name="estado" aria-label="Estado del ticket">
              {% for e in config.estados %}<option value="{{ e }}" {{ 'selected' if e == ticket.estado }}>{{ e }}{{ ' (actual)' if e == ticket.estado }}</option>{% endfor %}
            </select>
          </label>
          <textarea name="nota" rows="2" placeholder="Motivo del cambio (opcional, queda como nota interna)" aria-label="Motivo del cambio"></textarea>
          <button class="btn btn--sm" type="submit">🔄 Cambiar estado del ticket</button>
        </form>
      {% endif %}

      {% if permisos.asignar %}
        <details class="disclosure"{{ ' open' if not ticket.agenteAsignadoUid }}>
          <summary class="disclosure__summary">Asignación <span class="disclosure__hint">— {{ ticket.agenteAsignadoNombre or 'sin asignar' }}</span></summary>
          <form method="post" action="/app/tickets/{{ ticket.id }}/asignar" class="form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <label class="field"><span>Asignar a</span>
              <select name="agenteUid">
                {% for a in agentes %}<option value="{{ a.uid }}" {{ 'selected' if a.uid == ticket.agenteAsignadoUid }}>{{ a.nombre }}</option>{% endfor %}
              </select>
            </label>
            <label class="field--check"><input type="checkbox" name="forzar" /> <span>Ignorar límite de capacidad</span></label>
            <button class="btn btn--sm" type="submit">Asignar</button>
          </form>
        </details>
      {% endif %}

      {% if permisos.editar %}
        <details class="disclosure">
          <summary class="disclosure__summary">⏱️ Tiempo trabajado <span class="disclosure__hint">— {{ vm.tiempoTrabajado }}{{ ' (manual)' if vm.tiempoEsManual }}</span></summary>
          <form method="post" action="/app/tickets/{{ ticket.id }}/tiempo" class="form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <p class="muted">Automático: {{ vm.tiempoTrabajadoAuto }}. Ajusta a mano si no refleja el trabajo real.</p>
            <div class="page-head__actions">
              <label class="field"><span>Horas</span><input type="number" name="horas" min="0" value="0" /></label>
              <label class="field"><span>Minutos</span><input type="number" name="minutos" min="0" max="59" value="0" /></label>
            </div>
            <button class="btn btn--sm" type="submit">Guardar ajuste</button>
          </form>
          {% if vm.tiempoEsManual %}
            <form method="post" action="/app/tickets/{{ ticket.id }}/tiempo" class="disclosure__body">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <input type="hidden" name="quitar" value="true" />
              <button class="btn btn--sm btn--ghost" type="submit">Quitar ajuste (volver al automático)</button>
            </form>
          {% endif %}
          <form method="post" action="/app/tickets/{{ ticket.id }}/incluir-tiempo-descripcion" class="disclosure__body">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <button class="btn btn--sm btn--ghost" type="submit" title="Agrega '{{ vm.tiempoTrabajado }}' al final de la descripción">➕ Incluir en descripción</button>
          </form>
        </details>

      {% endif %}

      {% if permisos.editar %}
        <details class="disclosure"{{ ' open' if vm.agenda.vencida }}>
          <summary class="disclosure__summary">📅 Programar atención <span class="disclosure__hint">— {{ vm.agenda.texto if vm.agenda else 'sin programar' }}</span></summary>
          <form method="post" action="/app/tickets/{{ ticket.id }}/agenda" class="form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <label class="field"><span>Fecha</span>
              <input type="date" name="agendaFecha" value="{{ vm.agenda.fecha }}" required />
            </label>
            <label class="field"><span>Hora</span>
              <input type="time" name="agendaHora" value="{{ vm.agenda.hora or '09:00' }}" />
            </label>
            <label class="field--check">
              <input type="checkbox" name="agendaRecordatorio" {{ 'checked' if vm.agenda.recordatorioWhatsapp }} />
              <span>Recordatorio WhatsApp 30 min antes (vía n8n)</span>
            </label>
            {{ tk.destinatariosRecordatorio(equipoRecordatorio, vm.agenda.destinatarios if vm.agenda else []) }}
            <button class="btn btn--sm" type="submit">Guardar</button>
          </form>
          {% if vm.agenda %}
            <form method="post" action="/app/tickets/{{ ticket.id }}/agenda" class="disclosure__body">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <input type="hidden" name="agendaFecha" value="" />
              <button class="btn btn--sm btn--ghost" type="submit">Quitar programación</button>
            </form>
          {% endif %}
        </details>
      {% endif %}

      {% if permisos.eliminar %}
        <form id="archivar-ticket" method="post" action="/app/tickets/{{ ticket.id }}/archivar" hidden data-confirm="{{ '¿Restaurar este ticket? Vuelve a ocupar su folio en la lista.' if ticket.archivado else '¿Enviar este ticket a la papelera? Su folio quedará en la lista como «Ticket eliminado por administrador».' }}">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <input type="hidden" name="archivar" value="{{ 'false' if ticket.archivado else 'true' }}" />
        </form>
      {% endif %}
    </aside>
  </div>
{% endblock %}
