{% extends "layouts/backoffice.njk" %}
{% import "components/tickets.njk" as tk %}
{% block title %}Tablero{% endblock %}
{% block content %}
  <div class="page-head"><h1>Tablero de tickets</h1>
    <a class="btn btn--sm btn--ghost" href="/app/tickets">Ver lista</a>
  </div>
  <div class="kanban">
    {% for col in columnas %}
      <section class="kanban__col">
        <h2 class="kanban__title">{{ col.estado }} <span class="muted">({{ col.tickets | length }})</span></h2>
        {% for vm in col.tickets %}
          <a class="kanban__card" href="/app/tickets/{{ vm.id }}">
            <strong>#{{ vm.numero }}</strong> {{ vm.asunto }}
            <div class="kanban__meta">
              <span>{{ vm.prioridad }}</span>
              <span>{{ vm.agenteAsignadoNombre or 'sin asignar' }}</span>
            </div>
            {{ tk.slaBadge(vm) }}
          </a>
        {% else %}
          <p class="muted">—</p>
        {% endfor %}
      </section>
    {% endfor %}
  </div>
{% endblock %}
