{% extends "layouts/backoffice.njk" %}
{% import "components/tickets.njk" as tk %}
{% block title %}Tickets{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>{{ 'Agenda de tickets' if filtro.agenda == '1' else 'Tickets' }} <span class="muted">({{ total }})</span></h1>
    <div class="page-head__actions">
      <a class="btn btn--sm" href="/app/tickets/nuevo">Nuevo ticket</a>
      <a class="btn btn--sm {{ 'btn--secondary' if filtro.agenda != '1' }}" href="/app/tickets{{ '' if filtro.agenda == '1' else '?agenda=1' }}">📅 Agenda</a>
      <a class="btn btn--sm btn--secondary" href="/app/tickets/tablero">Tablero</a>
      <a class="btn btn--sm btn--secondary" href="/app/tickets/mis-asignados">Mis asignados</a>
    </div>
  </div>
  {% if filtro.agenda == '1' %}<p class="muted">Solo tickets con atención programada, del más próximo al más lejano.</p>{% endif %}

  {% if resumen %}
    <div class="stat-row">
      <a class="stat stat--top-brand" href="/app/tickets"><span class="stat__num">{{ resumen.total }}</span><span class="stat__lbl">Total tickets</span></a>
      {% for e in config.estados %}
        <a class="stat {{ e | estadoStatClase }}" href="/app/tickets?estado={{ e }}"><span class="stat__num">{{ resumen.porEstado[e] or 0 }}</span><span class="stat__lbl">{{ e }}</span></a>
      {% endfor %}
    </div>
  {% endif %}

  <form method="get" class="filterbar">
    <input type="hidden" name="f" value="1" />
    {% if filtro.agenda == '1' %}<input type="hidden" name="agenda" value="1" />{% endif %}
    <input type="search" name="texto" value="{{ filtro.texto }}" placeholder="Buscar por asunto, # o empresa…" autocomplete="off" spellcheck="false" />
    <select name="estado">
      <option value="">Todos los estados</option>
      {% for e in config.estados %}<option value="{{ e }}" {{ 'selected' if filtro.estado == e }}>{{ e }}</option>{% endfor %}
    </select>
    <select name="prioridad">
      <option value="">Cualquier prioridad</option>
      {% for p in config.prioridades %}<option value="{{ p }}" {{ 'selected' if filtro.prioridad == p }}>{{ p }}</option>{% endfor %}
    </select>
    <label class="field--check"><input type="checkbox" name="abiertos" value="0" {{ 'checked' if filtro.abiertos == '0' or filtro.f != '1' }} /> incluir cerrados</label>
    <label class="field--check"><input type="checkbox" data-toggle-columna="SLA" /> mostrar SLA</label>
    <button class="btn btn--sm" type="submit">Filtrar</button>
    <button class="btn btn--sm btn--ghost" type="submit" formaction="/app/tickets/exportar" hx-boost="false">Exportar Excel</button>
  </form>

  {{ tk.tablaTickets(tickets, csrfToken, can('tickets:eliminar')) }}
{% endblock %}
