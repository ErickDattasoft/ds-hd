{% extends "layouts/backoffice.njk" %}
{% block title %}{{ evento.titulo }}{% endblock %}
{% block content %}
  {#- Página del evento como una guía: ① revisa la invitación, ② elige cómo invitar (con nombre
      o link abierto), ③ respuestas. Lo que casi no se usa (editar un invitado, lista negra,
      borrar) queda guardado detrás de ✏️ y «Más opciones». app.js: data-ev-tab, data-abre. -#}
  {% set puedeGestionar = can('eventos:gestionar') %}
  {% set linkPublico = config.baseUrl + '/eventos/' + evento.id %}

  <div class="page-head">
    <h1>{{ evento.titulo }} <span class="{{ evento.estado | estadoClase }}">{{ evento.estado }}</span></h1>
    <div class="page-head__actions">
      {% if puedeGestionar %}<a class="btn btn--sm" href="/app/eventos/{{ evento.id }}/editar">✏️ Editar evento</a>{% endif %}
    </div>
  </div>
  <p class="muted">📅 {{ evento.fechaHora | fechahora }}{% if evento.lugarNombre %} · 📍 {{ evento.lugarNombre }}{% endif %} · {{ TIPO_EVENTO_ETIQUETA[evento.tipo] }}</p>

  {% if evento.estado == 'borrador' %}
    <p class="alert">📝 <strong>Borrador:</strong> puedes probar todo (mándate invitaciones, ábrelas, confirma). Solo no aparece en la lista pública de eventos.
      {% if puedeGestionar %}Cuando esté listo, cámbialo a <strong>publicado</strong> en <a href="/app/eventos/{{ evento.id }}/editar">✏️ Editar evento</a>.{% endif %}</p>
  {% endif %}
  {% if avisoInvitaciones %}<p class="alert {{ 'alert--error' if avisoInvitaciones.startsWith('⚠') else 'alert--ok' }}" id="invitaciones-aviso">{{ avisoInvitaciones }}</p>{% endif %}
  {% if errorInscrito %}<p class="alert alert--error">{{ errorInscrito }}</p>{% endif %}

  {#- ── Respuestas de un vistazo ─────────────────────────────────────── -#}
  {% if evento.pideConfirmacion %}
    <div class="ev-total">
      <div class="ev-total__grande"><strong>👥 Total que van: {{ resumen.personas + personasInscritos }}</strong>
        <span class="muted">{{ resumen.personas }} con nombre + {{ personasInscritos }} del link abierto</span></div>
      <div class="ev-total__chips">
        <span>✅ {{ resumen.asistiran }} van</span>
        <span>❌ {{ resumen.noAsistiran }} no van</span>
        <span>⏳ {{ resumen.pendientes }} sin contestar</span>
        <span>👁 {{ resumen.abiertas }} la abrieron</span>
      </div>
    </div>
  {% endif %}

  {#- ── ① La invitación ─────────────────────────────────────────────── -#}
  <section class="ev-paso">
    <h2 class="ev-paso__titulo"><span class="ev-paso__num">1</span> Revisa cómo se ve la invitación</h2>
    <div class="ev-invitacion">
      <div class="ev-invitacion__img" id="flayer-preview">
        {% if evento.flayer %}
          <img src="/eventos/{{ evento.id }}/flayer?v={{ evento.flayer.tamano }}" alt="Imagen de la invitación" />
        {% else %}
          <span class="muted">Sin imagen</span>
        {% endif %}
      </div>
      <div class="ev-invitacion__acciones">
        <a class="btn" href="/app/eventos/{{ evento.id }}/vista-previa" target="_blank" rel="noopener">👁 Ver cómo se ve</a>
        {% if puedeGestionar %}
          <form method="post" action="/app/eventos/{{ evento.id }}/enviarme-prueba" class="inline">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <button class="btn btn--secondary" type="submit" title="Te llega a ti el correo con asunto «[Prueba]». No te agrega a la lista.">✉️ Mandarme una prueba</button>
          </form>
          <a class="btn btn--ghost" href="/app/eventos/{{ evento.id }}/editar">✏️ Cambiar texto, fecha o lugar</a>
          <button type="button" class="btn btn--ghost" data-abre="ev-imagen">🖼 {{ 'Cambiar imagen' if evento.flayer else 'Poner imagen' }}</button>
        {% endif %}
      </div>
    </div>
    {% if puedeGestionar %}
      <div class="ev-panel" id="ev-imagen" hidden>
        <form class="form" data-flayer-form action="/app/eventos/{{ evento.id }}/flayer">
          <label class="field"><span>Imagen de la invitación <span class="muted">(PNG, JPG o WebP, máx. 700 KB)</span></span>
            <input type="file" accept="image/png,image/jpeg,image/webp" name="archivo" required />
          </label>
          <button class="btn btn--sm" type="submit">Subir imagen</button>
          <p id="flayer-mensaje"></p>
        </form>
        {% if evento.flayer %}
          <form method="post" action="/app/eventos/{{ evento.id }}/flayer/eliminar" data-confirm="¿Quitar la imagen?">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <button class="btn btn--sm btn--ghost" type="submit">Quitar imagen</button>
          </form>
        {% endif %}
      </div>
    {% endif %}
  </section>

  {#- ── ② Cómo invitar ──────────────────────────────────────────────── -#}
  {% set todosInvitados = [] %}
  {% for inv in invitacionesVM %}{% set _ = todosInvitados.push({ clase: 'empresa', i: inv }) %}{% endfor %}
  {% for ext in externosVM %}{% set _ = todosInvitados.push({ clase: 'externo', i: ext }) %}{% endfor %}
  {% set porMandar = [] %}
  {% for x in todosInvitados %}{% if x.i.correo and not x.i.enviadaAt and x.i.respuesta == 'pendiente' %}{% set _ = porMandar.push(1) %}{% endif %}{% endfor %}

  <section class="ev-paso" id="invitaciones">
    <h2 class="ev-paso__titulo"><span class="ev-paso__num">2</span> Invitaciones: elige cómo invitar</h2>
    <div class="ev-tabs" role="tablist" data-ev-tabs="{{ evento.id }}"
         data-ev-tab-inicial="{{ 'abierto' if (inscritos | length) and not (todosInvitados | length) else 'nombre' }}">
      <button type="button" role="tab" class="ev-tab" data-ev-tab="nombre">
        <strong>👥 Con nombre</strong>
        <span>Cada quien recibe su propia invitación: «¡Hola, Ana!» · {{ todosInvitados | length }} invitado(s)</span>
      </button>
      <button type="button" role="tab" class="ev-tab" data-ev-tab="abierto">
        <strong>🌐 Link abierto</strong>
        <span>Un solo link para redes o grupos; cada quien pone sus datos · {{ inscritos | length }} registrado(s)</span>
      </button>
    </div>

    {#- Pestaña A: invitados con nombre -#}
    <div class="ev-tabpanel" data-ev-panel="nombre">
      {% if puedeGestionar %}
        <div class="ev-agregar" data-paneles>
          <span class="ev-agregar__label">Agregar invitados:</span>
          <button type="button" class="btn btn--secondary" data-abre="ev-add-clientes">🏢 De mis clientes</button>
          <button type="button" class="btn btn--secondary" data-abre="ev-add-persona">👤 Otra persona</button>
          <button type="button" class="btn btn--secondary" data-abre="ev-add-lista">📄 Lista de Excel</button>
        </div>

        {#- De mis clientes: casillas + buscador (de 25 en 25 por JS). Las ya invitadas, deshabilitadas. -#}
        {% set yaInvitadas = [] %}{% for inv in evento.invitaciones %}{% set _ = yaInvitadas.push(inv.empresaNombre | lower) %}{% endfor %}
        <div class="ev-panel" id="ev-add-clientes" data-panel hidden>
          <form method="post" action="/app/eventos/{{ evento.id }}/empresas/varias" data-varias>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <p class="ev-panel__ayuda">Marca los clientes que quieres invitar. Se usa su <strong>contacto principal</strong> (nombre, correo y celular).</p>
            <div class="varias__barra">
              <input type="search" placeholder="🔎 Buscar cliente o sistema (ej. Nóminas)" data-varias-buscar aria-label="Buscar cliente o sistema" />
              <button type="button" class="btn btn--sm btn--ghost" data-varias-todas>☑️ Marcar los que se ven</button>
              <button type="button" class="btn btn--sm btn--ghost" data-varias-ninguna>☐ Desmarcar</button>
            </div>
            <ul class="varias__lista">
              {% for e in empresasCartera %}
                {% set ya = (e.nombre | lower) in yaInvitadas %}
                <li data-varias-fila data-texto="{{ (e.nombre + ' ' + (e.sistemas | join(' '))) | lower }}">
                  <label class="varias__item{{ ' is-ya' if ya }}">
                    <input type="checkbox" name="empresas" value="{{ e.nombre }}" {{ 'disabled' if ya }} />
                    <span class="varias__nombre">{{ e.nombre }}</span>
                    {% if ya %}<span class="badge">ya invitado</span>{% endif %}
                    {% if e.sistemas | length %}<span class="varias__sistemas muted">{{ e.sistemas | join(' · ') }}</span>{% endif %}
                  </label>
                </li>
              {% else %}
                <li class="muted" style="padding:8px 12px">No hay clientes activos.</li>
              {% endfor %}
            </ul>
            <div class="varias__pie">
              {% if evento.pideConfirmacion %}<label class="inv-pases-alta" title="Cuántas personas incluye cada invitación, contando al invitado">🎟 Personas por invitación <input type="number" name="pases" min="1" max="{{ MAX_PASES }}" value="{{ evento.maxPersonasRegistro }}" style="width:4.5em" /></label>{% endif %}
              <button class="btn" type="submit" data-varias-boton disabled>Agregar <span data-varias-n>0</span> marcados</button>
              <span class="muted" data-varias-estado></span>
            </div>
          </form>
        </div>

        <div class="ev-panel" id="ev-add-persona" data-panel hidden>
          <form method="post" action="/app/eventos/{{ evento.id }}/externos" class="ev-persona">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <p class="ev-panel__ayuda">Para alguien que no está en tus clientes (amigos, prospectos, referidos). Pon su correo, su celular o los dos.</p>
            <label class="field"><span>Nombre</span><input name="nombre" placeholder="Ej. Ana López" autocomplete="off" /></label>
            <label class="field"><span>Correo</span><input type="email" name="correo" placeholder="ana@correo.com" autocomplete="off" /></label>
            <label class="field"><span>Celular</span><input type="tel" name="telefono" placeholder="999 123 4567" autocomplete="off" /></label>
            {% if evento.pideConfirmacion %}<label class="field"><span>🎟 Personas</span><input type="number" name="pases" min="1" max="{{ MAX_PASES }}" value="{{ evento.maxPersonasRegistro }}" /></label>{% endif %}
            <button class="btn" type="submit">＋ Agregar</button>
          </form>
        </div>

        <div class="ev-panel" id="ev-add-lista" data-panel hidden>
          <form method="post" action="/app/eventos/{{ evento.id }}/externos/lista" class="form" data-lista-invitados>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <p class="ev-panel__ayuda">Para muchas personas a la vez. En Excel, una persona por renglón con estas columnas (correo o celular, al menos uno):</p>
            <pre class="lista-ejemplo">nombre       correo              celular      personas
Ana López    ana@correo.com      9991234567   2
Luis Mena                        9997654321   1</pre>
            <label class="field"><span>Selecciona las celdas en Excel, cópialas (Ctrl+C) y pégalas aquí (Ctrl+V)</span>
              <textarea name="lista" rows="5" required placeholder="Pega aquí…" data-lista-texto></textarea>
              <em class="field__hint" data-lista-conteo></em>
            </label>
            <label class="field"><span class="muted">…o sube el archivo guardado como CSV</span>
              <input type="file" accept=".csv,.txt,text/csv,text/plain" data-lista-archivo />
            </label>
            <div class="varias__pie">
              {% if evento.pideConfirmacion %}<label class="inv-pases-alta" title="Para los renglones que no traen personas">🎟 Personas si no lo trae <input type="number" name="pases" min="1" max="{{ MAX_PASES }}" value="{{ evento.maxPersonasRegistro }}" style="width:4.5em" /></label>{% endif %}
              <button class="btn" type="submit">📄 Agregar a todos</button>
            </div>
          </form>
        </div>
      {% endif %}

      {% if puedeGestionar and todosInvitados | length %}
        <div class="ev-mandar">
          {% if porMandar | length %}
            <form method="post" action="/app/eventos/{{ evento.id }}/invitaciones/enviar" class="inline"
                  data-confirm="{{ '⚠️ El evento sigue en BORRADOR. ' if evento.estado == 'borrador' }}¿Mandar la invitación por correo a los {{ porMandar | length }} que faltan?">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <button class="btn" type="submit">✉️ Enviar a los que faltan ({{ porMandar | length }})</button>
            </form>
            <span class="muted">Por correo, a quien todavía no se le ha mandado. Para WhatsApp usa el 💬 de cada uno.</span>
          {% else %}
            <span class="muted">✔️ Ya se les mandó por correo a todos los que tienen correo. Usa 💬 para mandar por WhatsApp.</span>
          {% endif %}
        </div>
      {% endif %}

      <ul class="ev-lista">
        {% for x in todosInvitados %}
          {% set inv = x.i %}
          {% set esEmpresa = x.clase == 'empresa' %}
          {% set nombreVisible = (inv.paraNombre or inv.empresaNombre) if esEmpresa else (inv.nombre or 'Sin nombre') %}
          {% set hist = historialEmpresas[inv.empresaNombre | lower] if esEmpresa else none %}
          <li class="ev-invitado">
            <div class="ev-invitado__fila">
              <div class="ev-invitado__quien">
                <strong class="nombre-sensible">{{ nombreVisible }}</strong>
                {% if esEmpresa and inv.paraNombre %}<span class="muted nombre-sensible"> · {{ inv.empresaNombre }}</span>{% endif %}
                {% if hist %}<span class="muted" title="Invitado a {{ hist.eventos }} evento(s) antes{% if hist.asistio %}, fue a {{ hist.asistio }}{% endif %}"> 🔁{{ hist.eventos }}</span>{% endif %}
                <div class="muted ev-invitado__contacto sensible">{{ inv.correo or '' }}{% if inv.correo and inv.telefono %} · {% endif %}{{ inv.telefono or '' }}{% if not inv.correo and not inv.telefono %}⚠️ sin correo ni celular{% endif %}</div>
                {% if inv.mensaje %}<div class="ev-invitado__mensaje">💬 «{{ inv.mensaje }}»</div>{% endif %}
              </div>
              {% if evento.pideConfirmacion %}<div class="ev-invitado__pases" title="Personas que incluye su invitación">🎟 {{ inv.pases }}</div>{% endif %}
              <div class="ev-invitado__estado">
                {% if inv.respuesta == 'asistira' %}<span class="ev-chip ev-chip--si">✅ {% if evento.pideConfirmacion %}Van {{ inv.personas or 1 }} de {{ inv.pases }}{% else %}Confirmó{% endif %}</span>
                {% elif inv.respuesta == 'no_asistira' %}<span class="ev-chip ev-chip--no">❌ No va</span>
                {% elif inv.respuesta == 'no_localizado' %}<span class="ev-chip">📵 No localizado</span>
                {% elif inv.abiertaAt %}<span class="ev-chip ev-chip--abrio" title="La abrió el {{ inv.abiertaAt | fechahora }}">👁 La abrió</span>
                {% elif inv.enviadaAt %}<span class="ev-chip" title="Se le mandó el {{ inv.enviadaAt | fechahora }}">✉️ Enviada</span>
                {% else %}<span class="ev-chip ev-chip--pend">⏳ Sin mandar</span>{% endif %}
              </div>
              <div class="ev-invitado__acciones">
                {% if puedeGestionar %}
                  <a class="btn btn--sm btn--ghost" href="{{ inv.waInvitacion }}" target="_blank" rel="noopener"
                     title="{{ 'Mandar por WhatsApp a ' + inv.telefono if inv.telefono else 'Mandar por WhatsApp (eliges el chat)' }}">💬</a>
                  {% if inv.correo %}
                    <form method="post" action="/app/eventos/{{ evento.id }}/invitaciones/{{ inv.id }}/enviar" class="inline"
                          {% if inv.enviadaAt %}data-confirm="Ya se le mandó el {{ inv.enviadaAt | fechahora }}. ¿Mandarla otra vez?"{% endif %}>
                      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                      <button class="btn btn--sm btn--ghost" type="submit" title="Mandar por correo a {{ inv.correo }}">✉️</button>
                    </form>
                  {% endif %}
                {% endif %}
                <a class="btn btn--sm btn--ghost" href="{{ inv.link }}" target="_blank" rel="noopener" title="Ver su invitación">👁</a>
                <button type="button" class="btn btn--sm btn--ghost" data-copiar-link data-link="{{ inv.link }}" title="Copiar su link">🔗</button>
                {% if puedeGestionar %}<button type="button" class="btn btn--sm btn--ghost" data-abre="ed-{{ inv.id }}" title="Cambiar sus datos o su respuesta">✏️</button>{% endif %}
              </div>
            </div>
            {% if puedeGestionar %}
              <div class="ev-panel ev-invitado__editar" id="ed-{{ inv.id }}" hidden>
                <form method="post" action="/app/eventos/{{ evento.id }}/{{ 'empresas' if esEmpresa else 'externos' }}/{{ inv.id }}" class="ev-persona">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                  {% if esEmpresa %}
                    <label class="field"><span>Para (nombre)</span><input name="paraNombre" value="{{ inv.paraNombre or '' }}" class="nombre-sensible" /></label>
                  {% else %}
                    <label class="field"><span>Nombre</span><input name="nombre" value="{{ inv.nombre }}" class="nombre-sensible" /></label>
                  {% endif %}
                  <label class="field"><span>Correo</span><input type="email" name="correo" value="{{ inv.correo or '' }}" class="sensible" /></label>
                  <label class="field"><span>Celular</span><input type="tel" name="telefono" value="{{ inv.telefono or '' }}" class="sensible" /></label>
                  {% if evento.pideConfirmacion %}
                    <label class="field"><span>🎟 Personas</span><input type="number" name="pases" value="{{ inv.pases }}" min="1" max="{{ MAX_PASES }}" /></label>
                  {% endif %}
                  <label class="field"><span>Respuesta <span class="muted">(si te contestó por teléfono)</span></span>
                    <select name="respuesta">
                      {% for r in RESPUESTAS_INVITACION %}<option value="{{ r }}" {{ 'selected' if inv.respuesta == r }}>{{ RESPUESTA_INVITACION_ETIQUETA[r] }}</option>{% endfor %}
                    </select>
                  </label>
                  {% if evento.pideConfirmacion %}
                    <label class="field"><span>¿Cuántos van?</span><input type="number" name="personas" value="{{ inv.personas or '' }}" min="1" max="{{ inv.pases }}" /></label>
                  {% endif %}
                  <label class="field"><span>Notas</span><input name="notas" value="{{ inv.notas or '' }}" /></label>
                  {% if esEmpresa %}<input type="hidden" name="invitadoPor" value="{{ inv.invitadoPor or '' }}" />{% else %}<input type="hidden" name="fuente" value="{{ inv.fuente or '' }}" />{% endif %}
                  {% if inv.contactado %}<input type="hidden" name="contactado" value="on" />{% endif %}
                  <button class="btn btn--sm" type="submit">💾 Guardar</button>
                </form>
                <form method="post" action="/app/eventos/{{ evento.id }}/{{ 'empresas' if esEmpresa else 'externos' }}/{{ inv.id }}/quitar" class="inline" data-confirm="¿Quitar a «{{ nombreVisible }}» de las invitaciones?">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                  <button class="btn btn--sm btn--ghost" type="submit">🗑 Quitar de la lista</button>
                </form>
              </div>
            {% endif %}
          </li>
        {% else %}
          <li class="ev-vacio">Todavía no hay invitados. {% if puedeGestionar %}Agrégalos con los botones de arriba.{% endif %}</li>
        {% endfor %}
      </ul>
    </div>

    {#- Pestaña B: link abierto (sin nombre) -#}
    <div class="ev-tabpanel" data-ev-panel="abierto" id="inscritos">
      <p class="ev-panel__ayuda">Compártelo en Facebook, en un grupo de WhatsApp o en un correo masivo. Quien entra pone su nombre y sus datos{% if evento.pideConfirmacion %}, y cuántos van (hasta {{ evento.maxPersonasRegistro }}){% endif %}. Aparecen abajo.</p>
      <div class="ev-link">
        <input type="text" readonly value="{{ linkPublico }}" aria-label="Link abierto" data-seleccionar />
        <button type="button" class="btn" data-copiar-link data-link="{{ linkPublico }}">📋 Copiar link</button>
        <a class="btn btn--secondary" href="https://wa.me/?text={{ (evento.titulo + ' — ' + linkPublico) | urlencode }}" target="_blank" rel="noopener">💬 Compartir por WhatsApp</a>
        <a class="btn btn--ghost" href="/eventos/{{ evento.id }}" target="_blank" rel="noopener">👁 Ver cómo se ve</a>
      </div>

      <div class="ev-subtitulo">
        <h3>Quién se ha registrado ({{ inscritos | length }})</h3>
        <span class="ev-subtitulo__acciones">
          {% if puedeGestionar and pendientesWsp %}
            <button class="btn btn--sm btn--ghost" type="button" data-wsp-masivo data-pendientes="{{ pendientesWsp }}"
                    title="Abre WhatsApp uno por uno para quien tenga teléfono y no esté marcado como contactado">💬 WhatsApp a pendientes ({{ pendientesWsp }})</button>
          {% endif %}
          {% if inscritos | length %}<a class="btn btn--sm btn--ghost" href="/app/eventos/{{ evento.id }}/inscritos.xlsx">📥 Excel</a>{% endif %}
        </span>
      </div>
      <ul class="ev-lista">
        {% for i in inscritos %}
          <li class="ev-invitado" id="inscrito-{{ i.id }}">
            <div class="ev-invitado__fila">
              <div class="ev-invitado__quien">
                <strong>{{ i.nombre }}</strong>{% if i.empresa %}<span class="muted nombre-sensible"> · {{ i.empresa }}</span>{% endif %}
                {% if i.asistioAntes %}<span class="muted" title="Ya asistió a: {{ i.asistioAntes }}"> 🔁</span>{% endif %}
                {% if i.enListaNegra %}<span title="{{ i.enListaNegra }}"> 🚫</span>{% endif %}
                <div class="muted ev-invitado__contacto sensible">{{ i.email }}{% if i.correoSospechoso %} 🚩{% endif %}{% if i.telefono %} · {{ i.telefono }}{% endif %}</div>
              </div>
              <div class="ev-invitado__estado">
                {% if i.asistira == 'No' %}<span class="ev-chip ev-chip--no">❌ No va</span>
                {% elif i.asistira %}<span class="ev-chip ev-chip--si">✅ {{ i.asistira }}{% if i.personas and i.personas > 1 %} · 👥 {{ i.personas }}{% endif %}</span>
                {% else %}<span class="ev-chip ev-chip--si">✅ Registrado</span>{% endif %}
              </div>
              <div class="ev-invitado__acciones">
                {% if puedeGestionar and i.waLink %}
                  <a class="btn btn--sm btn--ghost" target="_blank" rel="noopener" href="{{ i.waLink }}"
                     data-wsp-inscrito data-marcar="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/contactado"
                     title="Mandarle un WhatsApp">💬</a>
                {% endif %}
                {% if puedeGestionar %}<button type="button" class="btn btn--sm btn--ghost" data-abre="ins-{{ i.id }}" title="Ver y cambiar sus datos">✏️</button>{% endif %}
              </div>
            </div>
            {% if puedeGestionar %}
              <div class="ev-panel ev-invitado__editar" id="ins-{{ i.id }}" hidden>
                <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}" class="ev-persona">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                  <input type="hidden" name="marcasPresentes" value="1" />
                  <label class="field"><span>Nombre</span><input name="nombre" value="{{ i.nombre }}" autocomplete="off" spellcheck="false" required /></label>
                  <label class="field"><span>Empresa</span><input name="empresa" value="{{ i.empresa or '' }}" autocomplete="off" spellcheck="false" /></label>
                  <label class="field"><span>Correo
                    {% if i.correoEstado == 'entregado' %}<span title="Le llegó">🟢</span>{% elif i.correoEstado == 'rebotado' %}<span title="Rebotó — probablemente un correo falso o inexistente">🔴</span>{% else %}<span title="Aún sin confirmar entrega">🟡</span>{% endif %}</span>
                    <input type="email" name="email" value="{{ i.email }}" autocomplete="off" required /></label>
                  <label class="field"><span>Teléfono</span><input type="tel" name="telefono" value="{{ i.telefono or '' }}" autocomplete="off" /></label>
                  <label class="field--check" title="Asistencia real confirmada"><input type="checkbox" name="asistioReal" {{ 'checked' if i.asistioReal }} /> ✅ Sí asistió</label>
                  <label class="field--check" title="Ya se le mandó el mensaje por WhatsApp"><input type="checkbox" name="contactadoWsp" {{ 'checked' if i.contactadoWsp }} /> 💬 Ya lo contacté</label>
                  <button class="btn btn--sm" type="submit">💾 Guardar</button>
                </form>
                <div class="muted ev-inscrito__extra">
                  Dijo: <span class="muted" title="Lo que declaró al registrarse">{{ i.asistira or '—' }}</span>{% if i.personas and i.personas > 1 %} · 👥 {{ i.personas }}{% endif %}
                  {% if i.asistioAntes %} · Ya asistió a: {{ i.asistioAntes }}{% endif %}
                  {% if i.usaSistema %} · ¿Usa {{ evento.sistema }}? {{ i.usaSistema }}{% endif %}
                  {% if i.fuente %} · Se enteró: {{ i.fuente }}{% endif %}
                  {% if i.deseaCanalWhatsapp %} · 💬 quiere el canal de WhatsApp{% endif %}
                  · IP {{ i.ip or '—' }}
                </div>
                <div class="ev-inscrito__mas">
                  <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/marcar" class="inline">
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                    <select name="estado" aria-label="Estado">
                      {% for e in ['registrado','confirmado','asistio','no_asistio'] %}<option {{ 'selected' if i.estado == e }}>{{ e }}</option>{% endfor %}
                    </select>
                    <button class="btn btn--sm btn--ghost" type="submit">Cambiar estado</button>
                  </form>
                  <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/reenviar" class="inline">
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                    <button class="btn btn--sm btn--ghost" type="submit">✉️ Reenviar su confirmación</button>
                  </form>
                  {% if not i.enListaNegra %}
                    <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/lista-negra" class="inline" data-prompt-motivo
                          data-confirm="¿Marcar a «{{ i.nombre }}» como problemático? Quedará señalado con 🚫 si se vuelve a registrar.">
                      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                      <input type="hidden" name="motivo" value="" />
                      <button class="btn btn--sm btn--ghost" type="submit">🚫 Bloquear</button>
                    </form>
                  {% endif %}
                  <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/eliminar" class="inline"
                        data-confirm="¿Eliminar el registro de «{{ i.nombre }}»? No se puede deshacer.">
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                    <button class="btn btn--sm btn--ghost" type="submit">🗑 Eliminar</button>
                  </form>
                </div>
              </div>
            {% endif %}
          </li>
        {% else %}
          <li class="ev-vacio">Nadie se ha registrado todavía por el link abierto.</li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {#- ── Más opciones (casi no se usan) ───────────────────────────────── -#}
  {% if puedeGestionar %}
    <details class="disclosure ev-mas">
      <summary class="disclosure__summary">⚙️ Más opciones <span class="disclosure__hint">— bloqueados ({{ listaNegra | length }}), eliminar evento</span></summary>
      <div class="disclosure__body">
        <h3>🚫 Personas bloqueadas</h3>
        <p class="muted">Si alguien bloqueado se vuelve a registrar por el link abierto, sale marcado con 🚫.</p>
        <form method="post" action="/app/eventos/{{ evento.id }}/lista-negra" class="filterbar">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <input type="email" name="email" autocomplete="email" placeholder="correo@ejemplo.com" required />
          <input type="tel" name="telefono" placeholder="Teléfono (opcional)" />
          <input name="motivo" placeholder="Motivo (opcional)" />
          <button class="btn btn--sm btn--danger" type="submit">Bloquear</button>
        </form>
        <ul class="kb-list">
          {% for e in listaNegra %}
            <li><span class="sensible">{{ e.email }}{% if e.telefono %} · {{ e.telefono }}{% endif %}</span>
              <span class="muted">{{ e.motivo }}{% if e.marcadoPor %} — por {{ e.marcadoPor }}{% endif %}</span>
              <form method="post" action="/app/eventos/{{ evento.id }}/lista-negra/quitar" class="inline">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <input type="hidden" name="email" value="{{ e.email }}" />
                <button class="btn btn--sm btn--ghost" type="submit">Quitar</button>
              </form>
            </li>
          {% else %}<li class="muted">Nadie bloqueado.</li>{% endfor %}
        </ul>
        <h3>🗑 Eliminar el evento</h3>
        <form method="post" action="/app/eventos/{{ evento.id }}/eliminar" class="inline"
              data-confirm="¿Eliminar «{{ evento.titulo }}» con sus invitados y sus {{ inscritos | length }} registrados? No se puede deshacer.">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <button class="btn btn--sm btn--danger" type="submit">Eliminar evento</button>
        </form>
      </div>
    </details>
  {% endif %}
{% endblock %}
