{% extends "layouts/backoffice.njk" %}
{% block title %}{{ evento.titulo }}{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>{{ evento.titulo }} <span class="{{ evento.estado | estadoClase }}">{{ evento.estado }}</span></h1>
    <div class="page-head__actions">
      {% if can('eventos:gestionar') %}<a class="btn btn--sm" href="/app/eventos/{{ evento.id }}/editar">Editar</a>{% endif %}
      <button type="button" class="btn btn--sm btn--secondary" data-copiar-link
              data-link="{{ config.baseUrl }}/eventos/{{ evento.id }}"
              title="Link SIN nombre para compartir en redes, grupos o por correo: cada quien llena sus datos al confirmar (salen en «Inscritos»). Para invitados con nombre y pases usa el 🔗 de cada uno en «Invitaciones».">🔗 Link público</button>
      <a class="btn btn--sm btn--secondary" href="/app/eventos/{{ evento.id }}/vista-previa" target="_blank" rel="noopener"
         title="La invitación como la verá un invitado (nombre de ejemplo y 2 pases). Funciona en borrador y no guarda nada.">👁 Vista previa</a>
      {% if can('eventos:gestionar') %}
        <form method="post" action="/app/eventos/{{ evento.id }}/enviarme-prueba" class="inline">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <button class="btn btn--sm btn--ghost" type="submit" title="Te manda a ti el correo de la invitación, con asunto «[Prueba]». No te agrega a la lista de invitados.">✉️ Enviarme una prueba</button>
        </form>
      {% endif %}
      <a class="btn btn--sm btn--ghost" href="/eventos/{{ evento.id }}" target="_blank" rel="noopener">Ver página pública</a>
      {% if can('eventos:gestionar') %}
        <form method="post" action="/app/eventos/{{ evento.id }}/eliminar" class="inline"
              data-confirm="¿Eliminar «{{ evento.titulo }}» y sus {{ inscritos | length }} inscritos? No se puede deshacer.">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <button class="btn btn--sm btn--danger" type="submit">Eliminar</button>
        </form>
      {% endif %}
    </div>
  </div>
  <p class="muted">{{ evento.fechaHora | fechahora }} · {{ inscritos | length }} inscritos{% if evento.cupo %} / {{ evento.cupo }}{% endif %} · límite {{ evento.limiteIpEfectivo }}/IP</p>

  {% set puedeGestionar = can('eventos:gestionar') %}

  <h2>Flayer</h2>
  <p class="muted">Imagen promocional del evento, se muestra en la página pública de registro. PNG, JPG o WebP, máx. 700 KB.</p>
  <div id="flayer-preview">
    {% if evento.flayer %}
      <img src="/eventos/{{ evento.id }}/flayer?v={{ evento.flayer.tamano }}" alt="Flayer del evento" style="max-height:220px;max-width:100%" />
    {% else %}
      <p class="muted">Sin flayer configurado.</p>
    {% endif %}
  </div>
  {% if puedeGestionar %}
    <form class="form" data-flayer-form action="/app/eventos/{{ evento.id }}/flayer">
      <label class="field"><span>Archivo</span>
        <input type="file" accept="image/png,image/jpeg,image/webp" name="archivo" required />
      </label>
      <button class="btn btn--sm" type="submit">Subir flayer</button>
      <p id="flayer-mensaje"></p>
    </form>
    {% if evento.flayer %}
      <form method="post" action="/app/eventos/{{ evento.id }}/flayer/eliminar" data-confirm="¿Quitar el flayer actual?">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <button class="btn btn--sm btn--danger" type="submit">Quitar flayer</button>
      </form>
    {% endif %}
  {% endif %}
  {% macro respuestaSelect(nombre, valor) %}
    <select name="{{ nombre }}">
      {% for r in RESPUESTAS_INVITACION %}
        <option value="{{ r }}" {{ 'selected' if valor == r }}>{{ RESPUESTA_INVITACION_ETIQUETA[r] }}</option>
      {% endfor %}
    </select>
  {% endmacro %}

  {% macro estadoInvitado(inv) %}
    <div class="inv-estado muted">
      {% if inv.enviadaAt %}<span title="Se le mandó por correo">✉️ {{ inv.enviadaAt | fechahora }}</span>{% endif %}
      {% if inv.abiertaAt %}<span title="Abrió su invitación">👁 {{ inv.abiertaAt | fechahora }}</span>{% else %}<span title="Aún no abre su link">👁 sin abrir</span>{% endif %}
      {% if inv.respondioAt %}
        <span title="Contestó desde su link">
          {% if inv.respuesta == 'asistira' %}✅ van {{ inv.personas or 1 }} de {{ inv.pases }}{% else %}❌ no va{% endif %}
          {% if inv.respondioNombre %}· {{ inv.respondioNombre }}{% endif %}
        </span>
      {% endif %}
      {% if inv.mensaje %}<span class="inv-estado__mensaje">💬 «{{ inv.mensaje }}»</span>{% endif %}
    </div>
  {% endmacro %}

  {% macro accionesInvitado(inv) %}
    <span class="inv-acciones">
      <button type="button" class="btn btn--sm btn--ghost" data-copiar-link data-link="{{ inv.link }}" title="Copiar su link personal">🔗</button>
      <a class="btn btn--sm btn--ghost" href="{{ inv.link }}" target="_blank" rel="noopener" title="Ver su invitación como la verá él">👁</a>
      {% if evento.estado != 'borrador' %}
        {% if inv.correo %}
          <form method="post" action="/app/eventos/{{ evento.id }}/invitaciones/{{ inv.id }}/enviar" class="inline"
                {% if inv.enviadaAt %}data-confirm="Ya se le mandó el {{ inv.enviadaAt | fechahora }}. ¿Mandarla otra vez?"{% endif %}>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <button class="btn btn--sm btn--ghost" type="submit" title="Mandar la invitación a {{ inv.correo }}">✉️</button>
          </form>
        {% endif %}
        <a class="btn btn--sm btn--ghost" href="{{ inv.waInvitacion }}" target="_blank" rel="noopener"
           title="{{ 'Mandar por WhatsApp a ' + inv.telefono if inv.telefono else 'Mandar por WhatsApp (eliges el chat)' }}">💬</a>
      {% endif %}
    </span>
  {% endmacro %}

  <h2 id="invitaciones">Invitaciones <span class="muted">({{ TIPO_EVENTO_ETIQUETA[evento.tipo] }})</span></h2>
  <p class="muted">
    Cada invitado tiene su <strong>link personal</strong> con sus pases. Desde ahí confirma y aquí ves su respuesta.
    Agrega empresas de la cartera (toma su contacto principal) o a cualquier otra persona en «Otros invitados».
  </p>
  {% if avisoInvitaciones %}<p class="alert {{ 'alert--error' if avisoInvitaciones.startsWith('⚠') else 'alert--ok' }}">{{ avisoInvitaciones }}</p>{% endif %}
  {% if evento.estado == 'borrador' %}
    <p class="alert">El evento está en <strong>borrador</strong>: puedes armar la lista y ver las invitaciones (👁), pero para mandarlas ponlo en <strong>publicado</strong> desde <a href="/app/eventos/{{ evento.id }}/editar">Editar</a>.</p>
  {% endif %}

  {% if evento.pideConfirmacion and inscritos | length %}
    <p class="muted">
      👥 <strong>Total que van: {{ resumen.personas + personasInscritos }}</strong>
      — {{ resumen.personas }} por invitación con nombre + {{ personasInscritos }} del link público (Inscritos que dijeron «Sí»).
    </p>
  {% endif %}
  <div class="inv-resumen">
    <div><strong>{{ resumen.invitados }}</strong><span>invitaciones</span></div>
    {% if evento.pideConfirmacion %}
      <div><strong>{{ resumen.pases }}</strong><span>pases</span></div>
      <div><strong>{{ resumen.personas }}</strong><span>personas confirmadas</span></div>
      <div><strong>✅ {{ resumen.asistiran }}</strong><span>van</span></div>
      <div><strong>❌ {{ resumen.noAsistiran }}</strong><span>no van</span></div>
      <div><strong>⏳ {{ resumen.pendientes }}</strong><span>sin contestar</span></div>
    {% endif %}
    <div><strong>👁 {{ resumen.abiertas }}</strong><span>abiertas</span></div>
  </div>
  {% if puedeGestionar and evento.estado != 'borrador' and resumen.invitados %}
    <form method="post" action="/app/eventos/{{ evento.id }}/invitaciones/enviar" class="filterbar"
          data-confirm="¿Mandar la invitación por correo a todos los que tienen correo y aún no se les ha mandado?">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <button class="btn btn--sm" type="submit">✉️ Enviar a los que faltan</button>
      <span class="muted">Solo a quien tiene correo, no se le ha mandado y no ha contestado.</span>
    </form>
  {% endif %}

  <h3>🏢 Empresas de la cartera</h3>
  {% if puedeGestionar %}
    <form method="post" action="/app/eventos/{{ evento.id }}/empresas" class="filterbar">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <input name="empresaNombre" list="empresas-cartera" placeholder="Empresa de la cartera" required autocomplete="off" />
      <datalist id="empresas-cartera">
        {% for e in empresasCartera %}<option value="{{ e.nombre }}">{% endfor %}
      </datalist>
      {% if evento.pideConfirmacion %}<input type="number" name="pases" min="1" max="{{ MAX_PASES }}" value="1" title="Pases (personas que puede llevar)" style="width:5em" />{% endif %}
      <input name="invitadoPor" placeholder="Invitado por (opcional)" />
      <button class="btn btn--sm" type="submit">Agregar</button>
      <span class="muted">Se llenan solos el nombre, correo y celular del contacto principal; los puedes cambiar.</span>
    </form>
  {% endif %}
  <div class="table-wrap">
  <table class="data-table">
    <thead><tr><th>Empresa</th><th>Para / correo / celular</th>{% if evento.pideConfirmacion %}<th>Pases</th>{% endif %}<th>Respuesta</th><th>Notas</th><th></th></tr></thead>
    <tbody>
      {% for inv in invitacionesVM %}
        {% set hist = historialEmpresas[inv.empresaNombre | lower] %}
        <tr>
          <td>
            <span class="nombre-sensible">{{ inv.empresaNombre }}</span>
            {% if hist %}<span class="muted" title="Participó en {{ hist.eventos }} evento(s) anteriores{% if hist.asistio %}, asistió a {{ hist.asistio }}{% endif %}">🔁 {{ hist.eventos }}{% if hist.asistio %}·✅{{ hist.asistio }}{% endif %}</span>{% endif %}
            {% if inv.sistemas | length %}<div class="muted" style="font-size:.78em">{{ inv.sistemas | join(', ') }}</div>{% endif %}
          </td>
          {% if puedeGestionar %}
            <td colspan="{{ 4 if evento.pideConfirmacion else 3 }}">
              <form method="post" action="/app/eventos/{{ evento.id }}/empresas/{{ inv.id }}" class="inline-form">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <input name="paraNombre" value="{{ inv.paraNombre or '' }}" placeholder="Para (nombre)" size="14" class="nombre-sensible" />
                <input type="email" name="correo" value="{{ inv.correo or '' }}" placeholder="Correo" size="18" class="sensible" />
                <input type="tel" name="telefono" value="{{ inv.telefono or '' }}" placeholder="Celular" size="11" class="sensible" />
                {% if evento.pideConfirmacion %}
                  <input type="number" name="pases" value="{{ inv.pases }}" min="1" max="{{ MAX_PASES }}" title="Pases" style="width:4.5em" />
                {% endif %}
                {{ respuestaSelect('respuesta', inv.respuesta) }}
                {% if evento.pideConfirmacion %}
                  <input type="number" name="personas" value="{{ inv.personas or '' }}" min="1" max="{{ inv.pases }}" placeholder="¿cuántos?" title="Personas que van (si contestó por teléfono)" style="width:5.5em" />
                {% endif %}
                <input name="invitadoPor" value="{{ inv.invitadoPor or '' }}" placeholder="Invitado por" size="10" />
                <label class="field--check"><input type="checkbox" name="contactado" {{ 'checked' if inv.contactado }} /> contactado</label>
                <input name="notas" value="{{ inv.notas or '' }}" placeholder="Notas" size="14" />
                <button class="btn btn--sm" type="submit">Guardar</button>
              </form>
              {{ estadoInvitado(inv) }}
            </td>
            <td style="white-space:nowrap">
              {{ accionesInvitado(inv) }}
              <form method="post" action="/app/eventos/{{ evento.id }}/empresas/{{ inv.id }}/quitar" class="inline" data-confirm="¿Quitar «{{ inv.empresaNombre }}» del evento?">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <button class="btn btn--sm btn--ghost" type="submit" title="Quitar">🗑️</button>
              </form>
            </td>
          {% else %}
            <td><span class="nombre-sensible">{{ inv.paraNombre or '—' }}</span><div class="muted sensible">{{ inv.correo or '' }} {{ inv.telefono or '' }}</div></td>
            {% if evento.pideConfirmacion %}<td>{{ inv.pases }}</td>{% endif %}
            <td>{{ RESPUESTA_INVITACION_ETIQUETA[inv.respuesta] }}{{ estadoInvitado(inv) }}</td>
            <td class="muted">{{ inv.notas or '—' }}</td>
            <td><button type="button" class="btn btn--sm btn--ghost" data-copiar-link data-link="{{ inv.link }}" title="Copiar su link personal">🔗</button></td>
          {% endif %}
        </tr>
      {% else %}<tr><td colspan="6" class="muted">Ninguna empresa invitada todavía.</td></tr>{% endfor %}
    </tbody>
  </table>
  </div>

  <h3>👤 Otros invitados <span class="muted">(quien no está en la cartera: amigos, prospectos, referidos)</span></h3>
  {% if puedeGestionar %}
    <form method="post" action="/app/eventos/{{ evento.id }}/externos" class="filterbar">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <input name="nombre" placeholder="Nombre (opcional: sin nombre saluda «¡Hola!»)" size="28" />
      <input type="email" name="correo" placeholder="Correo (opcional)" />
      <input type="tel" name="telefono" placeholder="Celular (opcional)" />
      {% if evento.pideConfirmacion %}<input type="number" name="pases" min="1" max="{{ MAX_PASES }}" value="1" title="Pases" style="width:5em" />{% endif %}
      <input name="fuente" placeholder="Fuente (referido, redes…)" />
      <button class="btn btn--sm" type="submit">Agregar</button>
    </form>
  {% endif %}
  <div class="table-wrap">
  <table class="data-table">
    <thead><tr><th>Nombre / correo / celular</th>{% if evento.pideConfirmacion %}<th>Pases</th>{% endif %}<th>Respuesta</th><th>Notas</th><th></th></tr></thead>
    <tbody>
      {% for ext in externosVM %}
        <tr>
          {% if puedeGestionar %}
            <td colspan="{{ 4 if evento.pideConfirmacion else 3 }}">
              <form method="post" action="/app/eventos/{{ evento.id }}/externos/{{ ext.id }}" class="inline-form">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <input name="nombre" value="{{ ext.nombre }}" placeholder="Nombre" size="14" class="nombre-sensible" />
                <input type="email" name="correo" value="{{ ext.correo or '' }}" placeholder="Correo" size="18" class="sensible" />
                <input type="tel" name="telefono" value="{{ ext.telefono or '' }}" placeholder="Celular" size="11" class="sensible" />
                {% if evento.pideConfirmacion %}
                  <input type="number" name="pases" value="{{ ext.pases }}" min="1" max="{{ MAX_PASES }}" title="Pases" style="width:4.5em" />
                {% endif %}
                {{ respuestaSelect('respuesta', ext.respuesta) }}
                {% if evento.pideConfirmacion %}
                  <input type="number" name="personas" value="{{ ext.personas or '' }}" min="1" max="{{ ext.pases }}" placeholder="¿cuántos?" title="Personas que van (si contestó por teléfono)" style="width:5.5em" />
                {% endif %}
                <input name="fuente" value="{{ ext.fuente or '' }}" placeholder="Fuente" size="10" />
                <label class="field--check"><input type="checkbox" name="contactado" {{ 'checked' if ext.contactado }} /> contactado</label>
                <input name="notas" value="{{ ext.notas or '' }}" placeholder="Notas" size="14" />
                <button class="btn btn--sm" type="submit">Guardar</button>
              </form>
              {{ estadoInvitado(ext) }}
            </td>
            <td style="white-space:nowrap">
              {{ accionesInvitado(ext) }}
              <form method="post" action="/app/eventos/{{ evento.id }}/externos/{{ ext.id }}/quitar" class="inline" data-confirm="¿Quitar a «{{ ext.nombre }}» del evento?">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <button class="btn btn--sm btn--ghost" type="submit" title="Quitar">🗑️</button>
              </form>
            </td>
          {% else %}
            <td><span class="nombre-sensible">{{ ext.nombre or '—' }}</span><div class="muted sensible">{{ ext.correo or '' }} {{ ext.telefono or '' }}</div></td>
            {% if evento.pideConfirmacion %}<td>{{ ext.pases }}</td>{% endif %}
            <td>{{ RESPUESTA_INVITACION_ETIQUETA[ext.respuesta] }}{{ estadoInvitado(ext) }}</td>
            <td class="muted">{{ ext.notas or '—' }}</td>
            <td><button type="button" class="btn btn--sm btn--ghost" data-copiar-link data-link="{{ ext.link }}" title="Copiar su link personal">🔗</button></td>
          {% endif %}
        </tr>
      {% else %}<tr><td colspan="5" class="muted">Nadie más invitado.</td></tr>{% endfor %}
    </tbody>
  </table>
  </div>

  <h2 id="inscritos">Inscritos <span class="muted">(registro público)</span></h2>
  {% if errorInscrito %}<p class="alert alert--error">{{ errorInscrito }}</p>{% endif %}
  <div class="filterbar">
    <span class="muted">{{ inscritos | length }} persona(s) registrada(s)</span>
    {% if puedeGestionar %}
      <button class="btn btn--sm btn--ghost" type="button" data-wsp-masivo
              data-pendientes="{{ pendientesWsp }}"
              title="Abre WhatsApp uno por uno para quien tenga teléfono y no esté marcado como contactado">
        💬 WhatsApp a pendientes ({{ pendientesWsp }})
      </button>
    {% endif %}
    {% if inscritos | length %}
      <a class="btn btn--sm btn--ghost" href="/app/eventos/{{ evento.id }}/inscritos.xlsx">📥 Exportar Excel</a>
    {% endif %}
  </div>
  <div class="table-wrap">
  <table class="data-table">
    <thead><tr>
      <th>Nombre</th><th>Empresa</th>
      <th title="Ya asistió de verdad a otro evento antes — no tiene mucho caso reinvitarlo si este webinar se repite">🔁 Antes</th>
      <th>Correo</th>
      <th title="🟢 entregado · 🟡 pendiente · 🔴 rebotó">📧</th>
      <th title="Marcado como problemático en algún evento">🚫</th>
      <th>Teléfono</th><th>¿Asistirá?</th>
      <th title="Asistencia real confirmada, no solo la intención declarada al registrarse">✅ Asistió</th>
      <th title="Ya se le mandó el mensaje por WhatsApp">Contactado</th>
      <th>Estado</th><th></th>
    </tr></thead>
    <tbody>
      {% for i in inscritos %}
        <tr id="inscrito-{{ i.id }}">
          {% if puedeGestionar %}
            {# Una sola fila = un solo formulario: los datos editables y las dos marcas se guardan juntos. #}
            <td colspan="10">
              <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}" class="inline-form">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <input type="hidden" name="marcasPresentes" value="1" />
                <input name="nombre" value="{{ i.nombre }}" placeholder="Nombre" size="16" autocomplete="off" spellcheck="false" required />
                <input name="empresa" value="{{ i.empresa or '' }}" placeholder="Empresa" size="14" autocomplete="off" spellcheck="false" />
                {% if i.asistioAntes %}
                  <span title="Ya asistió a: {{ i.asistioAntes }}">🔁 {{ i.asistioAntes }}</span>
                {% else %}<span class="muted">—</span>{% endif %}
                <input type="email" name="email" value="{{ i.email }}" placeholder="Correo" size="22" autocomplete="off" required />
                {% if i.correoEstado == 'entregado' %}<span title="Entregado">🟢</span>
                {% elif i.correoEstado == 'rebotado' %}<span title="Rebotó — probablemente un correo falso o inexistente">🔴</span>
                {% else %}<span title="Aún sin confirmar entrega (Brevo puede tardar unos minutos)">🟡</span>{% endif %}
                {% if i.correoSospechoso %}<span title="Dominio de correo temporal/desechable conocido — probablemente no es un prospecto real">🚩</span>{% endif %}
                <input type="tel" name="telefono" value="{{ i.telefono or '' }}" placeholder="Teléfono" size="12" autocomplete="off" />
                <span class="muted" title="Lo que declaró al registrarse">{{ i.asistira or '—' }}{% if i.personas and i.personas > 1 %} · 👥 {{ i.personas }}{% endif %}</span>
                <label class="field--check" title="Asistencia real confirmada"><input type="checkbox" name="asistioReal" {{ 'checked' if i.asistioReal }} /> ✅</label>
                <label class="field--check" title="Ya se le mandó el mensaje por WhatsApp"><input type="checkbox" name="contactadoWsp" {{ 'checked' if i.contactadoWsp }} /> 💬</label>
                <button class="btn btn--sm" type="submit">Guardar</button>
              </form>
              {% if i.asistira or i.usaSistema or i.fuente or i.deseaCanalWhatsapp %}
                <div class="muted" style="font-size:.78em">
                  {% if i.usaSistema %}¿Usa {{ evento.sistema }}? {{ i.usaSistema }} · {% endif %}
                  {% if i.fuente %}Se enteró: {{ i.fuente }} · {% endif %}
                  {% if i.deseaCanalWhatsapp %}💬 quiere el canal de WhatsApp · {% endif %}
                  IP {{ i.ip or '—' }}
                </div>
              {% endif %}
            </td>
            <td>
              <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/marcar" class="inline">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <select name="estado">
                  {% for e in ['registrado','confirmado','asistio','no_asistio'] %}<option {{ 'selected' if i.estado == e }}>{{ e }}</option>{% endfor %}
                </select>
                <button class="btn btn--sm btn--ghost" type="submit">↵</button>
              </form>
            </td>
            <td style="white-space:nowrap">
              {% if i.waLink %}
                <a class="btn btn--sm btn--ghost" target="_blank" rel="noopener" href="{{ i.waLink }}"
                   data-wsp-inscrito data-marcar="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/contactado"
                   title="Manda el mensaje de la plantilla de este evento por WhatsApp">💬</a>
              {% endif %}
              <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/reenviar" class="inline">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <button class="btn btn--sm btn--ghost" type="submit" title="Reenviar el correo de confirmación">✉️</button>
              </form>
              {% if i.enListaNegra %}
                <span title="{{ i.enListaNegra }}">🚫</span>
              {% else %}
                <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/lista-negra" class="inline"
                      data-prompt-motivo
                      data-confirm="¿Marcar a «{{ i.nombre }}» como problemático? Quedará señalado con 🚫 si se vuelve a registrar en cualquier evento futuro.">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                  <input type="hidden" name="motivo" value="" />
                  <button class="btn btn--sm btn--ghost" type="submit" style="opacity:.45"
                          title="Marcar como problemático (ej. mala conducta en una videollamada)">🚫</button>
                </form>
              {% endif %}
              <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/eliminar" class="inline"
                    data-confirm="¿Eliminar el registro de «{{ i.nombre }}»? No se puede deshacer.">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <button class="btn btn--sm btn--danger" type="submit" title="Eliminar este registro">🗑️</button>
              </form>
            </td>
          {% else %}
            <td>{{ i.nombre }}</td>
            <td class="nombre-sensible">{{ i.empresa or '—' }}</td>
            <td>{% if i.asistioAntes %}🔁 {{ i.asistioAntes }}{% else %}—{% endif %}</td>
            <td><span class="sensible">{{ i.email }}</span>{% if i.correoSospechoso %} 🚩{% endif %}</td>
            <td>{{ i.correoEstado or '—' }}</td>
            <td>{% if i.enListaNegra %}🚫{% else %}—{% endif %}</td>
            <td class="sensible">{{ i.telefono or '—' }}</td>
            <td>{{ i.asistira or '—' }}{% if i.personas and i.personas > 1 %} · 👥 {{ i.personas }}{% endif %}</td>
            <td>{{ 'Sí' if i.asistioReal else '—' }}</td>
            <td>{{ 'Sí' if i.contactadoWsp else '—' }}</td>
            <td>{{ i.estado }}</td>
            <td></td>
          {% endif %}
        </tr>
      {% else %}<tr><td colspan="12" class="muted">Sin inscritos.</td></tr>{% endfor %}
    </tbody>
  </table>
  </div>

  {% if can('eventos:gestionar') %}
    <details class="disclosure"{{ ' open' if listaNegra | length }}>
      <summary class="disclosure__summary">Lista negra <span class="disclosure__hint">— {{ listaNegra | length }} bloqueado(s)</span></summary>
      <div class="disclosure__body">
        <form method="post" action="/app/eventos/{{ evento.id }}/lista-negra" class="filterbar">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <input type="email" name="email" autocomplete="email" placeholder="correo@ejemplo.com" required />
          <input type="tel" name="telefono" placeholder="Teléfono (opcional)" />
          <input name="motivo" placeholder="Motivo (opcional)" />
          <button class="btn btn--sm btn--danger" type="submit">Bloquear</button>
        </form>
        <ul class="kb-list">
          {% for e in listaNegra %}
            <li><span class="sensible">{{ e.email }}{% if e.telefono %} · {{ e.telefono }}{% endif %}</span>
              <span class="muted">{{ e.motivo }}{% if e.marcadoPor %} — por {{ e.marcadoPor }}{% endif %}</span>
              <form method="post" action="/app/eventos/{{ evento.id }}/lista-negra/quitar" class="inline">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <input type="hidden" name="email" value="{{ e.email }}" />
                <button class="btn btn--sm btn--ghost" type="submit">Quitar</button>
              </form>
            </li>
          {% else %}<li class="muted">Vacía.</li>{% endfor %}
        </ul>
      </div>
    </details>
  {% endif %}
{% endblock %}
