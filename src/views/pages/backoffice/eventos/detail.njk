{% extends "layouts/backoffice.njk" %}
{% block title %}{{ evento.titulo }}{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>{{ evento.titulo }} <span class="{{ evento.estado | estadoClase }}">{{ evento.estado }}</span></h1>
    <div class="page-head__actions">
      {% if can('eventos:gestionar') %}<a class="btn btn--sm" href="/app/eventos/{{ evento.id }}/editar">Editar</a>{% endif %}
      <button type="button" class="btn btn--sm btn--secondary" data-copiar-link
              data-link="{{ config.baseUrl }}/eventos/{{ evento.id }}"
              title="Copiar el link de registro público para compartirlo en redes o por correo">🔗 Link Registro</button>
      <a class="btn btn--sm btn--ghost" href="/eventos/{{ evento.id }}" target="_blank" rel="noopener">Ver página pública</a>
      {% if can('eventos:gestionar') %}
        <form method="post" action="/app/eventos/{{ evento.id }}/eliminar" class="inline"
              data-confirm="¿Eliminar «{{ evento.titulo }}» y sus {{ inscritos | length }} inscritos? No se puede deshacer.">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <button class="btn btn--sm btn--danger" type="submit">Eliminar</button>
        </form>
      {% endif %}
    </div>
  </div>
  <p class="muted">{{ evento.fechaHora | fechahora }} · {{ inscritos | length }} inscritos{% if evento.cupo %} / {{ evento.cupo }}{% endif %} · límite {{ evento.limiteIpEfectivo }}/IP</p>

  {% set puedeGestionar = can('eventos:gestionar') %}

  <h2>Flayer</h2>
  <p class="muted">Imagen promocional del evento, se muestra en la página pública de registro. PNG, JPG o WebP, máx. 700 KB.</p>
  <div id="flayer-preview">
    {% if evento.flayer %}
      <img src="/eventos/{{ evento.id }}/flayer?v={{ evento.flayer.tamano }}" alt="Flayer del evento" style="max-height:220px;max-width:100%" />
    {% else %}
      <p class="muted">Sin flayer configurado.</p>
    {% endif %}
  </div>
  {% if puedeGestionar %}
    <form class="form" data-flayer-form action="/app/eventos/{{ evento.id }}/flayer">
      <label class="field"><span>Archivo</span>
        <input type="file" accept="image/png,image/jpeg,image/webp" name="archivo" required />
      </label>
      <button class="btn btn--sm" type="submit">Subir flayer</button>
      <p id="flayer-mensaje"></p>
    </form>
    {% if evento.flayer %}
      <form method="post" action="/app/eventos/{{ evento.id }}/flayer/eliminar" data-confirm="¿Quitar el flayer actual?">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <button class="btn btn--sm btn--danger" type="submit">Quitar flayer</button>
      </form>
    {% endif %}
  {% endif %}
  {% macro respuestaSelect(nombre, valor) %}
    <select name="{{ nombre }}">
      {% for r in RESPUESTAS_INVITACION %}
        <option value="{{ r }}" {{ 'selected' if valor == r }}>{{ RESPUESTA_INVITACION_ETIQUETA[r] }}</option>
      {% endfor %}
    </select>
  {% endmacro %}

  <h2 id="invitaciones">Invitación dirigida</h2>
  <p class="muted">
    {{ resumen.invitados }} invitados · {{ resumen.contactados }} contactados ·
    ✅ {{ resumen.asistiran }} · ❌ {{ resumen.noAsistiran }} ·
    📵 {{ resumen.noLocalizados }} · pendientes {{ resumen.pendientes }}
  </p>

  <h3>🏢 Empresas invitadas</h3>
  {% if puedeGestionar %}
    <form method="post" action="/app/eventos/{{ evento.id }}/empresas" class="filterbar">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <input name="empresaNombre" list="empresas-cartera" placeholder="Empresa (de la cartera o nombre nuevo)" required autocomplete="off" />
      <datalist id="empresas-cartera">
        {% for e in empresasCartera %}<option value="{{ e.nombre }}">{% endfor %}
      </datalist>
      <input name="invitadoPor" placeholder="Invitado por (opcional)" />
      <button class="btn btn--sm" type="submit">Agregar</button>
    </form>
  {% endif %}
  <table class="data-table">
    <thead><tr><th>Empresa</th><th>Sistemas</th><th>Invitado por</th><th>Contactado</th><th>Respuesta</th><th>Notas</th><th></th></tr></thead>
    <tbody>
      {% for inv in evento.invitaciones %}
        {% set hist = historialEmpresas[inv.empresaNombre | lower] %}
        <tr>
          <td>
            {{ inv.empresaNombre }}
            {% if hist %}<span class="muted" title="Participó en {{ hist.eventos }} evento(s) anteriores{% if hist.asistio %}, asistió a {{ hist.asistio }}{% endif %}">🔁 {{ hist.eventos }}{% if hist.asistio %}·✅{{ hist.asistio }}{% endif %}</span>{% endif %}
          </td>
          <td class="muted">{{ inv.sistemas | join(', ') or '—' }}</td>
          {% if puedeGestionar %}
            <td colspan="4">
              <form method="post" action="/app/eventos/{{ evento.id }}/empresas/{{ inv.id }}" class="inline-form">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <input name="invitadoPor" value="{{ inv.invitadoPor or '' }}" placeholder="Invitado por" size="12" />
                <label class="field--check"><input type="checkbox" name="contactado" {{ 'checked' if inv.contactado }} /> contactado</label>
                {{ respuestaSelect('respuesta', inv.respuesta) }}
                <input name="notas" value="{{ inv.notas or '' }}" placeholder="Notas" size="16" />
                <button class="btn btn--sm" type="submit">Guardar</button>
              </form>
            </td>
            <td>
              <form method="post" action="/app/eventos/{{ evento.id }}/empresas/{{ inv.id }}/quitar" class="inline" data-confirm="¿Quitar «{{ inv.empresaNombre }}» del evento?">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <button class="btn btn--sm btn--ghost" type="submit">Quitar</button>
              </form>
            </td>
          {% else %}
            <td>{{ inv.invitadoPor or '—' }}</td>
            <td>{{ 'Sí' if inv.contactado else 'No' }}</td>
            <td>{{ RESPUESTA_INVITACION_ETIQUETA[inv.respuesta] }}</td>
            <td class="muted">{{ inv.notas or '—' }}</td>
            <td></td>
          {% endif %}
        </tr>
      {% else %}<tr><td colspan="7" class="muted">Ninguna empresa invitada todavía.</td></tr>{% endfor %}
    </tbody>
  </table>

  <h3>🌐 Invitados externos <span class="muted">(redes sociales, referidos)</span></h3>
  {% if puedeGestionar %}
    <form method="post" action="/app/eventos/{{ evento.id }}/externos" class="filterbar">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <input name="nombre" placeholder="Nombre" />
      <input name="fuente" placeholder="Fuente (Redes sociales, referido…)" />
      <button class="btn btn--sm" type="submit">Agregar</button>
    </form>
  {% endif %}
  <table class="data-table">
    <thead><tr><th>Nombre</th><th>Fuente</th><th>Contactado</th><th>Respuesta</th><th>Notas</th><th></th></tr></thead>
    <tbody>
      {% for ext in evento.invitadosExternos %}
        <tr>
          {% if puedeGestionar %}
            <td colspan="5">
              <form method="post" action="/app/eventos/{{ evento.id }}/externos/{{ ext.id }}" class="inline-form">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <input name="nombre" value="{{ ext.nombre }}" placeholder="Nombre" size="14" />
                <input name="fuente" value="{{ ext.fuente or '' }}" placeholder="Fuente" size="12" />
                <label class="field--check"><input type="checkbox" name="contactado" {{ 'checked' if ext.contactado }} /> contactado</label>
                {{ respuestaSelect('respuesta', ext.respuesta) }}
                <input name="notas" value="{{ ext.notas or '' }}" placeholder="Notas" size="14" />
                <button class="btn btn--sm" type="submit">Guardar</button>
              </form>
            </td>
            <td>
              <form method="post" action="/app/eventos/{{ evento.id }}/externos/{{ ext.id }}/quitar" class="inline">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <button class="btn btn--sm btn--ghost" type="submit">Quitar</button>
              </form>
            </td>
          {% else %}
            <td>{{ ext.nombre or '—' }}</td>
            <td>{{ ext.fuente or '—' }}</td>
            <td>{{ 'Sí' if ext.contactado else 'No' }}</td>
            <td>{{ RESPUESTA_INVITACION_ETIQUETA[ext.respuesta] }}</td>
            <td class="muted">{{ ext.notas or '—' }}</td>
            <td></td>
          {% endif %}
        </tr>
      {% else %}<tr><td colspan="6" class="muted">Sin invitados externos.</td></tr>{% endfor %}
    </tbody>
  </table>

  <h2 id="inscritos">Inscritos <span class="muted">(registro público)</span></h2>
  {% if errorInscrito %}<p class="alert alert--error">{{ errorInscrito }}</p>{% endif %}
  <div class="filterbar">
    <span class="muted">{{ inscritos | length }} persona(s) registrada(s)</span>
    {% if puedeGestionar %}
      <button class="btn btn--sm btn--ghost" type="button" data-wsp-masivo
              data-pendientes="{{ pendientesWsp }}"
              title="Abre WhatsApp uno por uno para quien tenga teléfono y no esté marcado como contactado">
        💬 WhatsApp a pendientes ({{ pendientesWsp }})
      </button>
    {% endif %}
    {% if inscritos | length %}
      <a class="btn btn--sm btn--ghost" href="/app/eventos/{{ evento.id }}/inscritos.xlsx">📥 Exportar Excel</a>
    {% endif %}
  </div>
  <div class="table-wrap">
  <table class="data-table">
    <thead><tr>
      <th>Nombre</th><th>Empresa</th>
      <th title="Ya asistió de verdad a otro evento antes — no tiene mucho caso reinvitarlo si este webinar se repite">🔁 Antes</th>
      <th>Correo</th>
      <th title="🟢 entregado · 🟡 pendiente · 🔴 rebotó">📧</th>
      <th title="Marcado como problemático en algún evento">🚫</th>
      <th>Teléfono</th><th>¿Asistirá?</th>
      <th title="Asistencia real confirmada, no solo la intención declarada al registrarse">✅ Asistió</th>
      <th title="Ya se le mandó el mensaje por WhatsApp">Contactado</th>
      <th>Estado</th><th></th>
    </tr></thead>
    <tbody>
      {% for i in inscritos %}
        <tr id="inscrito-{{ i.id }}">
          {% if puedeGestionar %}
            {# Una sola fila = un solo formulario: los datos editables y las dos marcas se guardan juntos. #}
            <td colspan="10">
              <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}" class="inline-form">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <input type="hidden" name="marcasPresentes" value="1" />
                <input name="nombre" value="{{ i.nombre }}" placeholder="Nombre" size="16" autocomplete="off" spellcheck="false" required />
                <input name="empresa" value="{{ i.empresa or '' }}" placeholder="Empresa" size="14" autocomplete="off" spellcheck="false" />
                {% if i.asistioAntes %}
                  <span title="Ya asistió a: {{ i.asistioAntes }}">🔁 {{ i.asistioAntes }}</span>
                {% else %}<span class="muted">—</span>{% endif %}
                <input type="email" name="email" value="{{ i.email }}" placeholder="Correo" size="22" autocomplete="off" required />
                {% if i.correoEstado == 'entregado' %}<span title="Entregado">🟢</span>
                {% elif i.correoEstado == 'rebotado' %}<span title="Rebotó — probablemente un correo falso o inexistente">🔴</span>
                {% else %}<span title="Aún sin confirmar entrega (Brevo puede tardar unos minutos)">🟡</span>{% endif %}
                {% if i.correoSospechoso %}<span title="Dominio de correo temporal/desechable conocido — probablemente no es un prospecto real">🚩</span>{% endif %}
                <input type="tel" name="telefono" value="{{ i.telefono or '' }}" placeholder="Teléfono" size="12" autocomplete="off" />
                <span class="muted" title="Lo que declaró al registrarse">{{ i.asistira or '—' }}</span>
                <label class="field--check" title="Asistencia real confirmada"><input type="checkbox" name="asistioReal" {{ 'checked' if i.asistioReal }} /> ✅</label>
                <label class="field--check" title="Ya se le mandó el mensaje por WhatsApp"><input type="checkbox" name="contactadoWsp" {{ 'checked' if i.contactadoWsp }} /> 💬</label>
                <button class="btn btn--sm" type="submit">Guardar</button>
              </form>
              {% if i.asistira or i.usaSistema or i.fuente or i.deseaCanalWhatsapp %}
                <div class="muted" style="font-size:.78em">
                  {% if i.usaSistema %}¿Usa {{ evento.sistema }}? {{ i.usaSistema }} · {% endif %}
                  {% if i.fuente %}Se enteró: {{ i.fuente }} · {% endif %}
                  {% if i.deseaCanalWhatsapp %}💬 quiere el canal de WhatsApp · {% endif %}
                  IP {{ i.ip or '—' }}
                </div>
              {% endif %}
            </td>
            <td>
              <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/marcar" class="inline">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <select name="estado">
                  {% for e in ['registrado','confirmado','asistio','no_asistio'] %}<option {{ 'selected' if i.estado == e }}>{{ e }}</option>{% endfor %}
                </select>
                <button class="btn btn--sm btn--ghost" type="submit">↵</button>
              </form>
            </td>
            <td style="white-space:nowrap">
              {% if i.waLink %}
                <a class="btn btn--sm btn--ghost" target="_blank" rel="noopener" href="{{ i.waLink }}"
                   data-wsp-inscrito data-marcar="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/contactado"
                   title="Manda el mensaje de la plantilla de este evento por WhatsApp">💬</a>
              {% endif %}
              <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/reenviar" class="inline">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <button class="btn btn--sm btn--ghost" type="submit" title="Reenviar el correo de confirmación">✉️</button>
              </form>
              {% if i.enListaNegra %}
                <span title="{{ i.enListaNegra }}">🚫</span>
              {% else %}
                <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/lista-negra" class="inline"
                      data-prompt-motivo
                      data-confirm="¿Marcar a «{{ i.nombre }}» como problemático? Quedará señalado con 🚫 si se vuelve a registrar en cualquier evento futuro.">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                  <input type="hidden" name="motivo" value="" />
                  <button class="btn btn--sm btn--ghost" type="submit" style="opacity:.45"
                          title="Marcar como problemático (ej. mala conducta en una videollamada)">🚫</button>
                </form>
              {% endif %}
              <form method="post" action="/app/eventos/{{ evento.id }}/inscritos/{{ i.id }}/eliminar" class="inline"
                    data-confirm="¿Eliminar el registro de «{{ i.nombre }}»? No se puede deshacer.">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <button class="btn btn--sm btn--danger" type="submit" title="Eliminar este registro">🗑️</button>
              </form>
            </td>
          {% else %}
            <td>{{ i.nombre }}</td>
            <td>{{ i.empresa or '—' }}</td>
            <td>{% if i.asistioAntes %}🔁 {{ i.asistioAntes }}{% else %}—{% endif %}</td>
            <td>{{ i.email }}{% if i.correoSospechoso %} 🚩{% endif %}</td>
            <td>{{ i.correoEstado or '—' }}</td>
            <td>{% if i.enListaNegra %}🚫{% else %}—{% endif %}</td>
            <td>{{ i.telefono or '—' }}</td>
            <td>{{ i.asistira or '—' }}</td>
            <td>{{ 'Sí' if i.asistioReal else '—' }}</td>
            <td>{{ 'Sí' if i.contactadoWsp else '—' }}</td>
            <td>{{ i.estado }}</td>
            <td></td>
          {% endif %}
        </tr>
      {% else %}<tr><td colspan="12" class="muted">Sin inscritos.</td></tr>{% endfor %}
    </tbody>
  </table>
  </div>

  {% if can('eventos:gestionar') %}
    <details class="disclosure"{{ ' open' if listaNegra | length }}>
      <summary class="disclosure__summary">Lista negra <span class="disclosure__hint">— {{ listaNegra | length }} bloqueado(s)</span></summary>
      <div class="disclosure__body">
        <form method="post" action="/app/eventos/{{ evento.id }}/lista-negra" class="filterbar">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <input type="email" name="email" autocomplete="email" placeholder="correo@ejemplo.com" required />
          <input type="tel" name="telefono" placeholder="Teléfono (opcional)" />
          <input name="motivo" placeholder="Motivo (opcional)" />
          <button class="btn btn--sm btn--danger" type="submit">Bloquear</button>
        </form>
        <ul class="kb-list">
          {% for e in listaNegra %}
            <li>{{ e.email }}{% if e.telefono %} · {{ e.telefono }}{% endif %}
              <span class="muted">{{ e.motivo }}{% if e.marcadoPor %} — por {{ e.marcadoPor }}{% endif %}</span>
              <form method="post" action="/app/eventos/{{ evento.id }}/lista-negra/quitar" class="inline">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <input type="hidden" name="email" value="{{ e.email }}" />
                <button class="btn btn--sm btn--ghost" type="submit">Quitar</button>
              </form>
            </li>
          {% else %}<li class="muted">Vacía.</li>{% endfor %}
        </ul>
      </div>
    </details>
  {% endif %}
{% endblock %}
