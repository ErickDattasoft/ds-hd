{% extends "layouts/backoffice.njk" %}
{% block title %}{{ titulo }}{% endblock %}
{% block content %}
  {#
    Formulario del evento en pasos: ① qué es, ② lo básico, ③ cómo se ve. Lo que casi no se usa
    queda en dos desplegables al final. Los campos que no aplican al tipo elegido se esconden
    (data-solo-tipo / data-sin-tipo) pero se siguen mandando, para no perder lo ya capturado.
  #}
  <div class="page-head">
    <h1>{{ titulo }}</h1>
    {% if modo != 'crear' %}<a class="btn btn--ghost" href="/app/eventos/{{ evento.id }}">← Volver al evento</a>{% endif %}
  </div>
  <p class="muted">Solo llena lo básico. Lo demás es opcional y puedes cambiarlo cuando quieras.</p>
  {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}
  {% set tipoActual = valores.tipo or 'webinar' %}
  <form method="post" action="{{ '/app/eventos' if modo == 'crear' else '/app/eventos/' + evento.id }}" class="evf" data-form-evento>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

    <section class="ev-paso">
      <h2 class="ev-paso__titulo"><span class="ev-paso__num">1</span> ¿Qué vas a hacer?</h2>
      <div class="inv-opciones inv-opciones--4">
        {% for t in TIPOS_EVENTO %}
          <label class="inv-opcion">
            <input type="radio" name="tipo" value="{{ t }}" {{ 'checked' if tipoActual == t }} />
            <span>{{ TIPO_EVENTO_ETIQUETA[t] }}<small class="evf-ayuda">{{ TIPO_EVENTO_AYUDA[t] }}</small></span>
          </label>
        {% endfor %}
      </div>
    </section>

    <section class="ev-paso">
      <h2 class="ev-paso__titulo"><span class="ev-paso__num">2</span> Lo básico</h2>
      <div class="evf-campos">
        <label class="field evf-ancho"><span>Nombre del evento</span>
          <input type="text" name="titulo" value="{{ valores.titulo }}" required placeholder="Ej. Posada DattaSoft 2026" />
          {% if errores.titulo %}<em class="field__error">{{ errores.titulo }}</em>{% endif %}</label>
        <label class="field evf-ancho" data-solo-tipo="comunicado"><span>🔗 Link del comunicado <span class="muted">(el que te pasa CONTPAQi)</span></span>
          <input type="text" name="urlComunicado" value="{{ valores.urlComunicado }}" placeholder="Pega aquí el link, ej. https://www.contpaqi.com/…" data-requerido inputmode="url" autocomplete="off" />
          <em class="field__hint">Al mandarlo (WhatsApp o correo), el cliente da clic y llega directo a este link.</em>
          {% if errores.urlComunicado %}<em class="field__error">{{ errores.urlComunicado }}</em>{% endif %}</label>
        <label class="field" data-sin-tipo="comunicado"><span>Fecha y hora</span>
          <input type="datetime-local" name="fechaHora" value="{{ valores.fechaHora }}" data-requerido />
          {% if errores.fechaHora %}<em class="field__error">{{ errores.fechaHora }}</em>{% endif %}</label>
        <label class="field" data-sin-tipo="felicitacion comunicado"><span>🎟 Personas por invitación</span>
          <input type="number" name="maxPersonasRegistro" value="{{ valores.maxPersonasRegistro or 1 }}" min="1" max="20" />
          <em class="field__hint">1 = solo el invitado. Con 2, el invitado elige «dos», «solo yo» o «ninguno».</em>
        </label>
        <label class="field evf-ancho"><span>Mensaje para el invitado <span class="muted" data-solo-tipo="comunicado">(opcional: sale en el correo)</span></span>
          <textarea name="descripcion" rows="5" placeholder="Ej. Queremos celebrar contigo este fin de año…">{{ valores.descripcion }}</textarea>
          <em class="field__hint">Es lo primero que lee, debajo de la imagen. Los saltos de línea se respetan.</em>
        </label>
        <label class="field evf-ancho" data-solo-tipo="webinar"><span>💻 Liga para entrar al webinar</span>
          <input type="text" name="urlWebinar" value="{{ valores.urlWebinar }}" placeholder="https://zoom.us/j/…" /></label>
        <label class="field" data-solo-tipo="presencial"><span>📍 Lugar</span>
          <input type="text" name="lugarNombre" value="{{ valores.lugarNombre }}" placeholder="Ej. Hotel Fiesta Americana, Salón Uxmal" /></label>
        <label class="field" data-solo-tipo="presencial"><span>Dirección</span>
          <input type="text" name="lugarDireccion" value="{{ valores.lugarDireccion }}" placeholder="Calle, número, colonia, ciudad" /></label>
      </div>
    </section>

    <section class="ev-paso">
      <h2 class="ev-paso__titulo"><span class="ev-paso__num">3</span> ¿Cómo se ve?</h2>
      <p class="muted evf-nota">🎨 Estilo de la invitación: cambia colores, letra y adorno. La imagen se pone después, en la página del evento.</p>
      <div class="inv-opciones inv-opciones--estilos" data-estilos>
        {% for e in ESTILOS_EVENTO %}
          {% set info = ESTILO_EVENTO_INFO[e] %}
          <label class="inv-opcion">
            <input type="radio" name="estilo" value="{{ e }}" {{ 'checked' if (valores.estilo or ('fiesta' if valores.tipo == 'felicitacion' else 'corporativo')) == e }} />
            <span>
              <i class="inv-muestra" style="--_c:{{ info.color }};--_f:{{ info.fondo }};--_fuente:{{ info.fuente }}">{{ info.adorno or 'Aa' }}</i>
              {{ info.nombre }}
              <small>{{ info.ayuda }}</small>
            </span>
          </label>
        {% endfor %}
      </div>
    </section>

    <details class="disclosure evf-mas"{{ ' open' if valores.itinerario or valores.vestimenta or valores.lugarMapsUrl or valores.contactoNombre or valores.contactoWhatsapp or errores.lugarMapsUrl }}>
      <summary class="disclosure__summary">➕ Más detalles <span class="disclosure__hint">— opcional: programa, vestimenta, mapa y a quién contactar</span></summary>
      <div class="disclosure__body evf-campos">
        <label class="field evf-ancho" data-solo-tipo="presencial"><span>Programa <span class="muted">(un renglón por actividad)</span></span>
          <textarea name="itinerario" rows="4" placeholder="8:00 PM - Bienvenida&#10;9:00 PM - Cena&#10;10:30 PM - Rifa">{{ valores.itinerario }}</textarea>
        </label>
        <label class="field" data-solo-tipo="presencial"><span>Vestimenta / qué llevar</span>
          <input type="text" name="vestimenta" value="{{ valores.vestimenta }}" placeholder="Ej. Casual · Trae tu laptop" /></label>
        <label class="field" data-solo-tipo="presencial"><span>Link de Google Maps</span>
          <input type="text" name="lugarMapsUrl" value="{{ valores.lugarMapsUrl }}" placeholder="https://maps.app.goo.gl/…" />
          <em class="field__hint">Si lo dejas vacío, «Cómo llegar» busca la dirección.</em>
          {% if errores.lugarMapsUrl %}<em class="field__error">{{ errores.lugarMapsUrl }}</em>{% endif %}
        </label>
        <label class="field"><span>¿A quién contactan? (nombre)</span>
          <input type="text" name="contactoNombre" value="{{ valores.contactoNombre }}" placeholder="Ej. Gaby" /></label>
        <label class="field"><span>WhatsApp de esa persona</span>
          <input type="tel" name="contactoWhatsapp" value="{{ valores.contactoWhatsapp }}" placeholder="999 123 4567" /></label>
      </div>
    </details>

    <details class="disclosure evf-mas"{{ ' open' if errores.cupo or errores.plantilla or errores.mensajeSeguimiento }}>
      <summary class="disclosure__summary">⚙️ Opciones avanzadas <span class="disclosure__hint">— casi nunca se tocan</span></summary>
      <div class="disclosure__body evf-campos">
        <label class="field"><span>Cupo máximo <span class="muted">(0 = sin límite)</span></span>
          <input type="number" name="cupo" value="{{ valores.cupo or 0 }}" min="0" /></label>
        <label class="field"><span>Recordatorio: horas antes <span class="muted">(0 = no mandar)</span></span>
          <input type="number" name="horasRecordatorio" value="{{ valores.horasRecordatorio if valores.horasRecordatorio is defined and valores.horasRecordatorio !== '' else 24 }}" min="0" placeholder="24" /></label>
        <label class="field" data-sin-tipo="felicitacion comunicado"><span>Sistema <span class="muted">(agrega «¿lo usas?» al link abierto)</span></span>
          <input type="text" name="sistema" value="{{ valores.sistema }}" placeholder="Ej. Contabilidad" /></label>
        <label class="field" data-sin-tipo="felicitacion comunicado"><span>Registros por IP en el link abierto <span class="muted">(vacío = 5)</span></span>
          <input type="number" name="limiteRegistrosPorIp" value="{{ valores.limiteRegistrosPorIp }}" min="1" placeholder="5" /></label>
        <label class="field evf-ancho"><span>Correo de confirmación <span class="muted">(vacío = el texto de siempre, el que ves en gris)</span></span>
          <textarea name="plantilla" rows="5" placeholder="{{ plantillaPorDefecto }}">{{ valores.plantilla }}</textarea>
          <em class="field__hint">Comodines: [nombre] [evento] [fecha] [hora] [sistema] [link] [lugar] [direccion] [mapa] [contacto_nombre] [contacto_whatsapp]. También se usa en el 💬 WhatsApp de cada registrado.</em>
        </label>
        <label class="field evf-ancho"><span>Mensaje de seguimiento <span class="muted">(después del evento; vacío = no se manda)</span></span>
          <textarea name="mensajeSeguimiento" rows="3" placeholder="Ej. Gracias por acompañarnos en [evento]. Aquí está la grabación: [link]">{{ valores.mensajeSeguimiento }}</textarea>
        </label>
        <label class="field"><span>Seguimiento: horas después</span>
          <input type="number" name="horasSeguimiento" value="{{ valores.horasSeguimiento }}" min="1" placeholder="24" /></label>
      </div>
    </details>

    {% set estadosEvento = [
      ['borrador', '📝 En preparación (no sale en la lista pública; ya puedes mandar y probar)'],
      ['publicado', '✅ Publicado (sale en la lista pública)'],
      ['finalizado', '🏁 Ya pasó'],
      ['cancelado', '❌ Cancelado']
    ] %}
    <div class="evf-guardar">
      <label class="field"><span>¿Cómo está?</span>
        <select name="estado">
          {% for s in estadosEvento %}<option value="{{ s[0] }}" {{ 'selected' if (valores.estado or 'borrador') == s[0] }}>{{ s[1] }}</option>{% endfor %}
        </select>
      </label>
      <div class="evf-guardar__botones">
        <button class="btn" type="submit">💾 Guardar</button>
        <a class="btn btn--ghost" href="{{ '/app/eventos' if modo == 'crear' else '/app/eventos/' + evento.id }}">Cancelar</a>
      </div>
    </div>
  </form>
{% endblock %}
