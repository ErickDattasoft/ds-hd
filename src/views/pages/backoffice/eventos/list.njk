{% extends "layouts/backoffice.njk" %}
{% block title %}Eventos{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>Eventos</h1>
    {% if can('eventos:gestionar') %}
      <div class="page-head__acciones" style="display:flex;gap:var(--space-2);flex-wrap:wrap">
        <form method="post" action="/app/eventos/ejemplos" data-confirm="{{ 'Se borran los ejemplos actuales y se crean de nuevo. ' if hayEjemplos }}Se crean 5 eventos de ejemplo (webinar, cena elegante, aniversario, posada y cumpleaños) y te llega la invitación de cada uno a tu correo. ¿Continuar?">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <button class="btn btn--sm btn--ghost" title="Para probar las invitaciones con tu propio correo: uno de cada tipo y estilo. No salen en la lista pública.">🧪 {{ 'Volver a crear ejemplos' if hayEjemplos else 'Crear eventos de ejemplo' }}</button>
        </form>
        {% if hayEjemplos %}
          <form method="post" action="/app/eventos/ejemplos/eliminar" data-confirm="¿Borrar todos los eventos de ejemplo (🧪) con sus registros?">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <button class="btn btn--sm btn--ghost">🗑 Borrar ejemplos</button>
          </form>
        {% endif %}
        <a class="btn btn--sm" href="/app/eventos/nuevo">Nuevo evento</a>
      </div>
    {% endif %}
  </div>
  {% if aviso %}<p class="alert {{ 'alert--error' if aviso.startsWith('⚠') else 'alert--ok' }}">{{ aviso }}</p>{% endif %}
  {% if hayEjemplos and can('eventos:gestionar') %}
    <form method="post" action="/app/eventos/ejemplos/invitar" class="filterbar" style="margin-bottom:var(--space-4)">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <strong>🧪 Invitar a alguien más a los ejemplos:</strong>
      <input name="nombre" placeholder="Nombre (opcional)" autocomplete="off" />
      <input type="email" name="correo" placeholder="Correo" required autocomplete="off" />
      <button class="btn btn--sm" type="submit">✉️ Agregar y enviar a los 5</button>
    </form>
  {% endif %}
  <table class="data-table">
    <thead><tr><th>Título</th><th>Fecha</th><th>Estado</th><th>Cupo</th></tr></thead>
    <tbody>
      {% for e in eventos %}
        <tr>
          <td><a href="/app/eventos/{{ e.id }}">{{ e.titulo }}</a></td>
          <td>{{ e.fechaHora | fechahora }}</td>
          <td><span class="{{ e.estado | estadoClase }}">{{ e.estado }}</span></td>
          <td>{{ e.cupo if e.cupo else 'sin límite' }}</td>
        </tr>
      {% else %}<tr><td colspan="4" class="muted">📭 Sin eventos todavía.{% if can('eventos:gestionar') %} <a href="/app/eventos/nuevo">Crea el primero</a>.{% endif %}</td></tr>{% endfor %}
    </tbody>
  </table>
{% endblock %}
