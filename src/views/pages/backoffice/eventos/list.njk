{% extends "layouts/backoffice.njk" %}
{% block title %}Eventos{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>Eventos</h1>
    {% if can('eventos:gestionar') %}
      <div class="page-head__acciones" style="display:flex;gap:var(--space-2);flex-wrap:wrap">
        <form method="post" action="/app/eventos/ejemplos" data-confirm="{{ 'Se borran los ejemplos actuales y se crean de nuevo. ' if hayEjemplos }}Se crean 5 eventos de ejemplo (webinar, cena elegante, aniversario, posada y cumpleaños) y te llega la invitación de cada uno a tu correo. ¿Continuar?">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <button class="btn btn--sm btn--ghost" title="Para probar las invitaciones con tu propio correo: uno de cada tipo y estilo. No salen en la lista pública.">🧪 {{ 'Volver a crear ejemplos' if hayEjemplos else 'Crear eventos de ejemplo' }}</button>
        </form>
        {% if hayEjemplos %}
          <form method="post" action="/app/eventos/ejemplos/eliminar" data-confirm="¿Borrar todos los eventos de ejemplo (🧪) con sus registros?">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <button class="btn btn--sm btn--ghost">🗑 Borrar ejemplos</button>
          </form>
        {% endif %}
      </div>
    {% endif %}
  </div>
  {% if aviso %}<p class="alert {{ 'alert--error' if aviso.startsWith('⚠') else 'alert--ok' }}">{{ aviso }}</p>{% endif %}
  {% if hayEjemplos and can('eventos:gestionar') %}
    <form method="post" action="/app/eventos/ejemplos/invitar" class="filterbar" style="margin-bottom:var(--space-4)">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <strong>🧪 Invitar a alguien más a los ejemplos:</strong>
      <input name="nombre" placeholder="Nombre (opcional)" autocomplete="off" />
      <input type="email" name="correo" placeholder="Correo" required autocomplete="off" />
      <button class="btn btn--sm" type="submit">✉️ Agregar y enviar a los 5</button>
    </form>
  {% endif %}
  {#- Arriba: una tarjeta por tipo (abre «Nuevo» con ese tipo ya elegido). Abajo: un recuadro por tipo. -#}
  {% if can('eventos:gestionar') %}
    <section class="ev-paso">
      <h2 class="ev-paso__titulo">➕ ¿Qué quieres hacer?</h2>
      <div class="ev-tipos">
        {% for t in TIPOS_EVENTO %}
          <a class="ev-tipo ev-tipo--{{ t }}" href="/app/eventos/nuevo?tipo={{ t }}">
            <strong>{{ TIPO_EVENTO_ETIQUETA[t] }}</strong>
            <small>{{ TIPO_EVENTO_AYUDA[t] }}</small>
            <span class="ev-tipo__nuevo">＋ Nuevo</span>
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% for g in grupos %}
    <section class="ev-paso ev-grupo ev-grupo--{{ g.tipo }}" id="tipo-{{ g.tipo }}">
      <h2 class="ev-paso__titulo">{{ g.titulo }} <span class="badge">{{ g.eventos | length }}</span></h2>
      {% if g.eventos | length %}
        <div class="table-wrap"><table class="data-table ev-tabla">
          {# Mismas columnas y anchos en todos los tipos, para que Fecha, Estado, Van y Cupo queden alineados. #}
          <colgroup><col class="ev-tabla__titulo" /><col class="ev-tabla__fecha" /><col class="ev-tabla__estado" /><col class="ev-tabla__van" /><col class="ev-tabla__cupo" /></colgroup>
          <thead><tr><th>Título</th><th>{{ 'Creado' if g.tipo == 'comunicado' else 'Fecha' }}</th><th>Estado</th><th>👥 Van</th><th>Cupo</th></tr></thead>
          <tbody>
            {% for e in g.eventos %}
              {% set confirma = g.tipo != 'comunicado' and g.tipo != 'felicitacion' %}
              <tr>
                <td><a href="/app/eventos/{{ e.id }}">{{ e.titulo }}</a></td>
                <td>{{ (e.createdAt if g.tipo == 'comunicado' else e.fechaHora) | fechahora }}</td>
                <td><span class="{{ e.estado | estadoClase }}">{{ e.estado }}</span></td>
                <td>{% if confirma and van[e.id] !== undefined %}<a class="ev-van" href="/app/eventos/{{ e.id }}" title="Total que van: invitados que confirmaron + los «Sí» del link abierto">👥 {{ van[e.id] }}</a>{% else %}<span class="muted">—</span>{% endif %}</td>
                <td>{% if confirma %}{{ e.cupo if e.cupo else 'sin límite' }}{% else %}<span class="muted">—</span>{% endif %}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table></div>
      {% else %}
        <p class="muted">📭 Todavía no hay.{% if can('eventos:gestionar') %} <a href="/app/eventos/nuevo?tipo={{ g.tipo }}">Crear uno</a>.{% endif %}</p>
      {% endif %}
    </section>
  {% endfor %}
{% endblock %}
