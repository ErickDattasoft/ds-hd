{% extends "layouts/backoffice.njk" %}
{% block title %}Mis notas{% endblock %}
{% block content %}
  {% set nombresColor = { amarillo: 'Amarillo', verde: 'Verde', rosa: 'Rosa', morado: 'Morado', azul: 'Azul', gris: 'Gris' } %}
  {% macro tarjeta(n, colores, nombresColor) %}
    <article class="nota nota--{{ n.color }}{{ ' nota--fijada' if n.fijada }}{{ (' nota--recordar-' + n.recordatorio.estado) if n.recordatorio }}"
             data-nota data-id="{{ n.id }}" data-color="{{ n.color }}">
      <header class="nota__cab">
        <button type="button" class="nota__fijar" data-nota-fijar aria-pressed="{{ 'true' if n.fijada else 'false' }}"
                title="{{ 'Desfijar' if n.fijada else 'Fijar hasta arriba' }}" aria-label="Fijar nota">📌</button>
        <span class="nota__estado" data-nota-estado></span>
        <span class="nota__aviso" data-nota-aviso {{ 'hidden' if not n.recordatorio }}>⏰ <span data-nota-aviso-texto>{{ n.recordatorio.texto if n.recordatorio }}</span></span>
        <time class="nota__cuando" data-nota-cuando>{{ n.cuando }}</time>
      </header>
      <textarea class="nota__texto sensible" data-nota-texto rows="3" placeholder="Escribe una nota…" aria-label="Texto de la nota">{{ n.texto }}</textarea>
      <div class="nota__imgs" data-nota-imgs>
        {% for i in n.imagenes %}
          <span class="nota__img" data-nota-img="{{ i.id }}"><a href="{{ i.url }}" target="_blank" rel="noopener"><img class="adjunto-thumb" src="{{ i.url }}" alt="{{ i.nombre }}" loading="lazy" /></a><button type="button" class="nota__img-quitar" data-nota-img-quitar title="Quitar imagen" aria-label="Quitar imagen">✕</button></span>
        {% endfor %}
      </div>
      {% if n.tickets and n.tickets.length %}
        <p class="nota__tickets">{% for t in n.tickets %}<a href="/app/tickets/{{ t.id }}" title="Ticket creado con esta nota">🎫 #{{ t.numero }}</a>{% endfor %}</p>
      {% endif %}
      <footer class="nota__pie">
        <span class="nota__colores">
          {% for c in colores %}<button type="button" class="nota__color nota--{{ c }}" data-nota-color="{{ c }}" title="{{ nombresColor[c] }}" aria-label="Color {{ nombresColor[c] }}"></button>{% endfor %}
        </span>
        <label class="btn btn--sm btn--ghost nota__recordar" title="Recordatorio: ese día sale en tu Dashboard">⏰
          <input type="date" data-nota-recordar value="{{ n.recordarEn }}" aria-label="Día del recordatorio" /></label>
        <label class="btn btn--sm btn--ghost nota__subir" title="Agregar imagen (también puedes pegarla con Ctrl+V o arrastrarla)">🖼
          <input type="file" accept="image/*" multiple data-nota-img-file hidden /></label>
        <button type="button" class="btn btn--sm btn--ghost" data-nota-ticket title="Mandar esta nota a ⚡ Captura rápida para volverla pre-ticket">🎫 Ticket</button>
        <button type="button" class="btn btn--sm btn--ghost" data-nota-borrar title="Mandar a la papelera" aria-label="Mandar a la papelera">🗑</button>
      </footer>
    </article>
  {% endmacro %}

  <div data-notas>
    <div class="page-head">
      <h1>🗒️ Mis notas <span class="muted" data-notas-total>({{ notas.length }})</span></h1>
      <div class="page-head__actions">
        <input type="search" class="notas__buscar" data-notas-buscar placeholder="🔍 Buscar en mis notas" aria-label="Buscar en mis notas" />
        <button type="button" class="btn" data-nota-nueva>＋ Nota</button>
      </div>
    </div>
    <p class="muted">Tu borrador personal, como Sticky Notes: solo tú ves tus notas y se guardan solas mientras escribes.
      <strong>📌</strong> la fija arriba, <strong>🖼</strong> (o Ctrl+V) le pega imágenes, <strong>⏰</strong> te la recuerda en el Dashboard ese día y <strong>🎫 Ticket</strong>
      la pasa a ⚡ Captura rápida. Desde cualquier pantalla, <kbd>Alt</kbd>+<kbd>N</kbd> abre una nota rápida.</p>

    <div class="notas" data-notas-lista>
      {% for n in notas %}{{ tarjeta(n, colores, nombresColor) }}{% endfor %}
    </div>
    <p class="muted notas__vacio" data-notas-vacio {{ 'hidden' if notas.length }}>No tienes notas pendientes. Dale <strong>＋ Nota</strong> para empezar.</p>

    {% if conTicket.length %}
    <details class="notas__seccion" data-seccion="notas-con-ticket">
      <summary>🎫 Ya convertidas en ticket <span class="muted">({{ conTicket.length }})</span></summary>
      <p class="muted">Ya salió al menos un ticket de cada una. Bórralas cuando ya no las necesites.</p>
      <div class="notas">
        {% for n in conTicket %}{{ tarjeta(n, colores, nombresColor) }}{% endfor %}
      </div>
    </details>
    {% endif %}

    <details class="notas__seccion" data-seccion="notas-papelera" data-notas-papelera {{ 'hidden' if not papelera.length }}>
      <summary>🗑️ Papelera <span class="muted">({{ papelera.length }}) — se borran solas a los {{ diasPapelera }} días</span></summary>
      <ul class="notas__papelera">
        {% for n in papelera %}
          <li class="nota-borrada nota--{{ n.color }}" data-nota-borrada data-id="{{ n.id }}">
            <span class="nota-borrada__texto sensible">{{ (n.texto | truncate(160)) or '(vacía)' }}{% if n.imagenes.length %} <span class="muted">🖼 {{ n.imagenes.length }}</span>{% endif %}</span>
            <span class="muted">quedan {{ n.quedanDias }} día{{ 's' if n.quedanDias != 1 }}</span>
            <button type="button" class="btn btn--sm btn--secondary" data-nota-restaurar>↩ Restaurar</button>
            <button type="button" class="btn btn--sm btn--ghost" data-nota-borrar-definitivo title="Borrar para siempre">❌</button>
          </li>
        {% endfor %}
      </ul>
    </details>

    <div class="notas__deshacer" data-notas-deshacer role="status" hidden>
      🗑️ Nota enviada a la papelera <button type="button" class="btn btn--sm" data-nota-deshacer>↩ Deshacer</button>
    </div>

    <template data-nota-plantilla>{{ tarjeta({ id: '', texto: '', color: 'amarillo', cuando: '', fijada: false, recordarEn: '', recordatorio: null, tickets: [], imagenes: [] }, colores, nombresColor) }}</template>

    <form method="post" action="/app/tickets/captura" data-nota-ticket-form hidden>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <input type="hidden" name="texto" />
      <input type="hidden" name="notaId" />
    </form>
  </div>
{% endblock %}
