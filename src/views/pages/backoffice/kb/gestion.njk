{% extends "layouts/backoffice.njk" %}
{% block title %}Base de conocimiento{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>Base de conocimiento</h1>
    <a class="btn btn--sm" href="/app/kb/nuevo">Nuevo artículo</a>
  </div>
  <table class="data-table">
    <thead><tr><th>Título</th><th>Categoría</th><th>Visibilidad</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      {% for a in articulos %}
        <tr>
          <td><a href="/app/kb/{{ a.slug or a.id }}">{{ a.titulo }}</a></td>
          <td>{{ a.categoria or '—' }}</td>
          <td>{{ a.visibilidad }}</td>
          <td>{{ 'Publicado' if a.publicado else 'Borrador' }}</td>
          <td><a href="/app/kb/{{ a.id }}/editar">Editar</a></td>
        </tr>
      {% else %}<tr><td colspan="5" class="muted">Sin artículos.</td></tr>{% endfor %}
    </tbody>
  </table>
{% endblock %}
