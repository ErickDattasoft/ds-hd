{% extends "layouts/backoffice.njk" %}
{% block title %}{{ titulo }}{% endblock %}
{% block content %}
  <h1>{{ titulo }}</h1>
  {% if empresaAgregada %}
    <p><strong class="sensible">{{ email }}</strong> ya tenía cuenta en el portal. Se le agregó esta empresa: al crear un ticket elegirá para cuál de sus empresas es. Entra con la misma contraseña de siempre.</p>
  {% else %}
  {% if errorCorreo %}
    <p>Se creó la cuenta de <strong>{{ nombre }}</strong> (<span class="sensible">{{ email }}</span>), pero <strong>el correo de invitación NO salió</strong>.</p>
    <p class="alert alert--error">Motivo: {{ errorCorreo }}<br>Copia el enlace de abajo y mándaselo por WhatsApp o correo.</p>
  {% else %}
    <p>Se creó la cuenta de <strong>{{ nombre }}</strong> (<span class="sensible">{{ email }}</span>) y se envió el correo de invitación.</p>
  {% endif %}
  <div class="card">
    <p class="muted">Enlace de invitación (por si necesitas compartirlo manualmente):</p>
    <code class="code-block">{{ urlInvitacion }}</code>
  </div>
  {% endif %}
  <p><a class="btn" href="/app/usuarios">Volver a usuarios</a></p>
{% endblock %}
