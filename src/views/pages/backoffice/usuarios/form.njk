{% extends "layouts/backoffice.njk" %}
{% block title %}{{ titulo }}{% endblock %}
{% block content %}
  <h1>{{ titulo }}</h1>
  {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}

  <form method="post"
        action="{{ '/app/usuarios' if modo == 'crear' else '/app/usuarios/' + usuario.uid }}"
        class="form form--wide">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

    <label class="field">
      <span>Nombre</span>
      <input name="nombre" value="{{ valores.nombre }}" required />
      {% if errores.nombre %}<em class="field__error">{{ errores.nombre }}</em>{% endif %}
    </label>

    {% if modo == 'crear' %}
      <label class="field">
        <span>Correo</span>
        <input type="email" name="email" autocomplete="email" value="{{ valores.email }}" required />
        {% if errores.email %}<em class="field__error">{{ errores.email }}</em>{% endif %}
      </label>
    {% else %}
      <p class="muted">Correo: {{ usuario.email.value }}</p>
    {% endif %}

    <fieldset class="field">
      <legend>Roles de personal</legend>
      <p class="muted">Los permisos son la suma de todos los roles marcados.</p>
      {% for g in ROL_GRUPOS %}
        <div class="perm-group">
          <strong>{{ g.etiqueta }}</strong>
          {% for r in g.roles %}
            {% if r in rolesStaff %}
              <label class="field--check">
                <input type="checkbox" name="roles" value="{{ r }}"
                       {{ 'checked' if r in valores.roles }}
                       {{ 'disabled' if valores.esCliente }} />
                <span>{{ ROL_ETIQUETA[r] }}</span>
              </label>
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
      {% if errores.roles %}<em class="field__error">{{ errores.roles }}</em>{% endif %}
    </fieldset>

    {% if modo == 'editar' %}
      <label class="field field--check">
        <input type="checkbox" name="esCliente" data-cliente-toggle {{ 'checked' if valores.esCliente }} />
        <span>Cliente del portal <span class="muted">— excluye los roles de personal</span></span>
      </label>
    {% endif %}

    {% if modo == 'editar' %}
      <label class="field field--check">
        <input type="checkbox" name="activo" {{ 'checked' if usuario.activo }} />
        <span>Cuenta activa</span>
      </label>

      <label class="field">
        <span>Empresa asociada (obligatoria para clientes)</span>
        <input name="empresaId" value="{{ valores.empresaId or '' }}" placeholder="ID de empresa" />
        {% if errores.empresaId %}<em class="field__error">{{ errores.empresaId }}</em>{% endif %}
      </label>

      <details class="disclosure"{{ ' open' if usuario.agente.grupo or usuario.agente.capacidadMax or usuario.agente.disponibleAsignacion }}>
        <summary class="disclosure__summary">Configuración de agente <span class="disclosure__hint">— solo para roles de soporte</span></summary>
        <div class="disclosure__body form">
          <input name="agenteGrupo" value="{{ usuario.agente.grupo or '' }}" placeholder="Grupo / cola" />
          <input type="number" name="agenteCapacidad" value="{{ usuario.agente.capacidadMax }}" min="0" placeholder="Capacidad máx (0 = sin límite)" />
          <label class="field--check">
            <input type="checkbox" name="agenteDisponible" {{ 'checked' if usuario.agente.disponibleAsignacion }} />
            <span>Disponible para asignación</span>
          </label>
        </div>
      </details>

      <details class="disclosure"{{ ' open' if usuario.permisosExtra | length or usuario.permisosRevocados | length }}>
        <summary class="disclosure__summary">Permisos avanzados <span class="disclosure__hint">— ajustar por encima del rol</span></summary>
        <div class="disclosure__body">
          <p class="muted">Marca EXTRA para conceder por encima del rol; REVOCAR para quitar.</p>
          {% for modulo, permisos in permisosModulo %}
            <div class="perm-group">
              <strong>{{ modulo }}</strong>
              {% for p in permisos %}
                <span class="perm-row">
                  <code>{{ p }}</code>
                  <label><input type="checkbox" name="permisosExtra" value="{{ p }}" {{ 'checked' if p in usuario.permisosExtra }} /> extra</label>
                  <label><input type="checkbox" name="permisosRevocados" value="{{ p }}" {{ 'checked' if p in usuario.permisosRevocados }} /> revocar</label>
                </span>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </details>
    {% endif %}

    <div class="page-head__actions">
      <button type="submit" class="btn">{{ 'Crear y enviar invitación' if modo == 'crear' else 'Guardar cambios' }}</button>
      <a class="btn btn--ghost" href="/app/usuarios">Cancelar</a>
    </div>
  </form>
{% endblock %}
