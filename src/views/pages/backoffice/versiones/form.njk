{% extends "layouts/backoffice.njk" %}
{% block title %}{{ titulo }}{% endblock %}
{% block content %}
  <h1>{{ titulo }}</h1>
  {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}
  <form method="post" action="{{ '/app/versiones' if modo == 'crear' else '/app/versiones/' + version.id }}" class="form form--wide">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    <label class="field"><span>Sistema</span><input name="sistema" value="{{ valores.sistema }}" required />
      {% if errores.sistema %}<em class="field__error">{{ errores.sistema }}</em>{% endif %}</label>
    <label class="field"><span>Versión actual</span><input name="versionActual" value="{{ valores.versionActual }}" required />
      {% if errores.versionActual %}<em class="field__error">{{ errores.versionActual }}</em>{% endif %}</label>

    <details class="disclosure"{{ ' open' if valores.fechaLiberacion or valores.linkDescarga or valores.linkCartaTecnica or valores.notasVersion }}>
      <summary class="disclosure__summary">Detalles de la versión</summary>
      <div class="disclosure__body form">
        <label class="field"><span>Fecha de liberación</span><input type="date" name="fechaLiberacion" value="{{ valores.fechaLiberacion }}" /></label>
        <label class="field"><span>Link de descarga</span><input name="linkDescarga" value="{{ valores.linkDescarga }}" /></label>
        <label class="field"><span>Link carta técnica</span><input name="linkCartaTecnica" value="{{ valores.linkCartaTecnica }}" placeholder="https://…" /></label>
        <label class="field"><span>Notas de versión</span><textarea name="notasVersion" rows="4">{{ valores.notasVersion }}</textarea></label>
      </div>
    </details>

    <div class="page-head__actions">
      <button class="btn" type="submit">Guardar</button>
      <a class="btn btn--ghost" href="/app/versiones">Cancelar</a>
    </div>
  </form>

  {% if modo == 'editar' %}
    <details class="disclosure">
      <summary class="disclosure__summary">Zona de peligro</summary>
      <form method="post" action="/app/versiones/{{ version.id }}/eliminar" class="form" data-confirm="¿Eliminar esta versión?">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <button class="btn btn--sm btn--danger" type="submit">Eliminar versión</button>
      </form>
    </details>
  {% endif %}
{% endblock %}
