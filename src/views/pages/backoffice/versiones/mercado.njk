{% extends "layouts/backoffice.njk" %}
{% block title %}Versiones del mercado{% endblock %}
{% block content %}
  <div class="page-head">
    <h1>Versiones del mercado</h1>
    <div class="page-head__actions">
      {% if puedeTraer %}
        <a class="btn btn--sm" href="/app/versiones/mercado?traer=1" hx-boost="false"
           title="Lee {{ urlContpaqi }} y llena la tabla con lo más nuevo. No guarda nada: revisa y dale «Guardar todo».">📥 Traer de CONTPAQi</a>
      {% endif %}
      <a class="btn btn--sm btn--ghost" href="/app/versiones">Volver</a>
    </div>
  </div>
  {% if guardado %}<p class="alert alert--ok">Versiones guardadas.</p>{% endif %}
  {% if errorTraer %}
    <p class="alert alert--error">{{ errorTraer }}. La tabla quedó como estaba; puedes capturar a mano desde <a href="{{ urlContpaqi }}" target="_blank" rel="noopener">la página de descargas</a>.</p>
  {% elif traer %}
    {% if traidas.length %}
      <p class="alert alert--warn">Se llenaron o completaron <strong>{{ traidas.length }}</strong> sistemas con lo publicado en CONTPAQi (resaltados en la tabla): {{ traidas | join(', ') }}. <strong>Todavía no se guarda</strong> — revisa y dale «Guardar todo».</p>
    {% else %}
      <p class="alert alert--ok">Todo está al día: CONTPAQi no ha publicado nada más nuevo que lo registrado.</p>
    {% endif %}
  {% endif %}
  <p class="muted">
    Una fila por sistema de CONTPAQi con su versión, y debajo un renglón por cada service pack con su propia descarga. Deja la versión vacía para no registrar ese sistema; borra el número de un SP para quitarlo.
    Las «Soluciones fuera de versión» se toman como service pack de la versión anterior; si un SP no trae carta técnica, se usa la de su versión.
    {% if estadoContpaqi and estadoContpaqi.revisado %}Última lectura de <a href="{{ urlContpaqi }}" target="_blank" rel="noopener">CONTPAQi</a>: {{ estadoContpaqi.revisado | fechahora }}.{% endif %}
    {% if estadoContpaqi and estadoContpaqi.error and not traer %}<span style="color: var(--danger)">La última lectura automática falló: {{ estadoContpaqi.error }}.</span>{% endif %}
  </p>

  {% macro filaSp(sistema, sp, clase) %}
    <tr class="mercado__sp {{ clase }}" data-sp-de="{{ sistema }}">
      <td>
        <input type="hidden" name="spSistema" value="{{ sistema }}" />
        <input type="hidden" name="spNota" value="{{ sp.nota or '' }}" />
        <span class="mercado__sp-etiqueta" title="{{ sp.nota or '' }}">↳ Service pack</span>
      </td>
      <td><label class="mercado__sp-numero">SP <input name="spNumero" type="number" min="1" value="{{ sp.numero or '' }}" title="Número de SP (vacío = quitarlo)" /></label></td>
      <td><input type="date" name="spFecha" value="{{ sp.fecha or '' }}" /></td>
      <td class="mercado__link"><input name="spDescarga" value="{{ sp.linkDescarga or '' }}" title="{{ sp.linkDescarga or '' }}" placeholder="https://… (descarga del SP)" /></td>
      <td class="muted" style="font-size: 0.8rem">{{ sp.nota or 'Usa la carta técnica de la versión' }}</td>
    </tr>
  {% endmacro %}

  <form method="post" action="/app/versiones/mercado" class="form mercado">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    <input type="hidden" name="conSp" value="1" />
    <p class="muted" style="margin: 0">Arrastra la orilla derecha de un encabezado para cambiar el ancho de esa columna; con doble clic se ajusta al contenido, como en Excel.</p>
    <table class="data-table">
      <thead><tr><th data-no-ordenar>Sistema</th><th data-no-ordenar>Versión oficial</th><th data-no-ordenar>Liberación</th><th data-no-ordenar class="mercado__link">Link descarga</th><th data-no-ordenar class="mercado__link">Link carta técnica</th></tr></thead>
      <tbody>
        {% for f in filas %}
          <tr class="mercado__version{{ ' fila--traida' if f.traida }}">
            <td>
              <input type="hidden" name="sistema" value="{{ f.sistema }}" />
              <strong>{{ f.sistema }}</strong>
              <button type="button" class="btn btn--ghost btn--sm" data-agregar-sp="{{ f.sistema }}" title="Agregar un service pack a este sistema">＋ SP</button>
              {% if f.completada %}
                <div class="muted" style="font-size: 0.8rem" title="{{ f.origen }}">📥 se completó lo que faltaba</div>
              {% elif f.traida %}
                <div class="muted" style="font-size: 0.8rem" title="{{ f.origen }}">antes: {{ f.anterior or '—' }} · 📥 {{ f.origen }}</div>
              {% elif f.sugerida %}
                <div title="{{ f.origen }}"><span class="badge badge--warning badge--sm">🆕 {{ f.sugerida }}</span></div>
              {% endif %}
            </td>
            <td><input name="versionActual" value="{{ f.versionActual }}" placeholder="Ej. 12.1.0" /></td>
            <td><input type="date" name="fechaLiberacion" value="{{ f.fechaLiberacion }}" /></td>
            <td class="mercado__link"><input name="linkDescarga" value="{{ f.linkDescarga }}" title="{{ f.linkDescarga }}" placeholder="https://… (descarga de la versión)" /></td>
            <td class="mercado__link"><input name="linkCartaTecnica" value="{{ f.linkCartaTecnica }}" title="{{ f.linkCartaTecnica }}" placeholder="https://…" /></td>
          </tr>
          {% for sp in f.servicePacks %}{{ filaSp(f.sistema, sp, 'fila--traida' if f.traida else '') }}{% endfor %}
        {% else %}
          <tr><td colspan="5" class="muted">No hay sistemas en el catálogo. Agrégalos en Configuración → Tickets.</td></tr>
        {% endfor %}
      </tbody>
    </table>
    <template data-plantilla-sp>{{ filaSp('__SISTEMA__', {}, '') }}</template>
    <div class="page-head__actions">
      <button class="btn" type="submit">Guardar todo</button>
    </div>
  </form>
{% endblock %}
