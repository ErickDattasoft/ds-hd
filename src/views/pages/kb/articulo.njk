{% extends "layouts/backoffice.njk" %}
{% block title %}{{ articulo.titulo }}{% endblock %}
{% block content %}
  <p><a href="/app/kb?carpeta={{ articulo.carpeta }}">← Base de conocimiento</a></p>
  <article class="kb-article">
    <h1>{% if articulo.esScript %}⚡ {% endif %}{{ articulo.titulo }}</h1>
    <p class="muted">
      {{ etiquetaCarpeta }}{% if articulo.rutaDestino %} · <code>{{ articulo.rutaDestino }}</code>{% endif %}
      · Actualizado {{ articulo.updatedAt | fecha }}
    </p>
    {# Solo lectura: se copia; el contenido solo cambia al reindexar la carpeta. #}
    <p class="kb-acciones">
      <button type="button" class="btn btn--sm" data-kb-copiar>📋 Copiar</button>
      <a class="btn btn--sm btn--ghost" href="/app/kb/comparar?a={{ articulo.id }}">🔀 Comparar con otro</a>
      {% if esPropietario %}
        <form method="post" action="/app/kb/{{ articulo.id }}/eliminar" class="inline" data-confirm="¿Eliminar «{{ articulo.titulo }}» del CRM? Si sigue en la carpeta de Windows, volverá al reindexar.">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <button class="btn btn--sm btn--ghost" type="submit">🗑️ Eliminar</button>
        </form>
      {% endif %}
      <textarea hidden data-kb-markdown>{{ articulo.cuerpoMarkdown }}</textarea>
    </p>
    {% if articulo.tags | length %}
      <div class="kb-tags">
        {% for t in articulo.tags %}<a class="kb-tag" href="/app/kb?q={{ t | urlencode }}">{{ t }}</a>{% endfor %}
      </div>
    {% endif %}
    <div class="prose">{{ cuerpoHtml | safe }}</div>
  </article>
  {% if relacionados | length %}
    <aside class="kb-relacionados">
      <h2>Ver también</h2>
      <ul class="kb-list">
        {% for a in relacionados %}
          <li><a href="/app/kb/{{ a.id }}">{{ a.titulo }}</a> <span class="muted">{{ a.subcarpeta }}</span></li>
        {% endfor %}
      </ul>
    </aside>
  {% endif %}
{% endblock %}
