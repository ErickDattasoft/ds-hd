{% extends "layouts/public.njk" %}
{% block title %}Establecer contraseña{% endblock %}
{% block content %}
  <h1>Establecer contraseña</h1>
  {% if not valida %}
    <p class="alert alert--error">Esta invitación no es válida o ya expiró. Pide una nueva a tu contacto.</p>
    <p><a href="/login">Ir al inicio de sesión</a></p>
  {% else %}
    {% if email %}<p class="muted">Para <strong>{{ email }}</strong></p>{% endif %}
    {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}
    <form method="post" action="/invitacion/{{ token }}" class="form">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <label class="field">
        <span>Contraseña (mínimo 8 caracteres)</span>
        <input type="password" name="password" required minlength="8" autocomplete="new-password" />
        {% if errores.password %}<em class="field__error">{{ errores.password }}</em>{% endif %}
      </label>
      <label class="field">
        <span>Repite la contraseña</span>
        <input type="password" name="passwordConfirmacion" required autocomplete="new-password" />
        {% if errores.passwordConfirmacion %}<em class="field__error">{{ errores.passwordConfirmacion }}</em>{% endif %}
      </label>
      <button type="submit" class="btn">Guardar y continuar</button>
    </form>
  {% endif %}
{% endblock %}
