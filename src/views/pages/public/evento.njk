{% extends "layouts/public-page.njk" %}
{% block title %}{{ evento.titulo if evento else 'Evento' }}{% endblock %}
{% block head %}
  {% if turnstileSiteKey %}<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>{% endif %}
{% endblock %}
{% block content %}
<div class="evento-landing">
  {% if not evento %}
    <div class="evento-resultado">
      <h1>Evento no encontrado</h1>
      <p>El enlace puede haber caducado. <a href="/eventos">Consulta los próximos eventos</a>.</p>
    </div>
  {% elif registrado %}
    <div class="evento-resultado">
      <h1>Registro confirmado</h1>
      <p>
        Gracias por inscribirte a <strong>{{ evento.titulo }}</strong>.
        Te enviamos los detalles de acceso; si no los encuentras, revisa tu carpeta de spam o correo no deseado.
      </p>
    </div>
  {% else %}
    <header class="evento-encabezado">
      <p class="evento-encabezado__antetitulo">Registro al evento</p>
      <h1>{{ evento.titulo }}</h1>
      <dl class="evento-datos">
        <div><dt>Fecha</dt><dd>{{ evento.fechaHora | fechalarga }}</dd></div>
        <div><dt>Hora</dt><dd>{{ evento.fechaHora | hora }}</dd></div>
        {% if evento.sistema %}<div><dt>Tema</dt><dd>{{ evento.sistema }}</dd></div>{% endif %}
        {% if evento.contactoNombre %}<div><dt>Imparte</dt><dd>{{ evento.contactoNombre }}</dd></div>{% endif %}
      </dl>
      {% if evento.flayer %}
        <img class="evento-flayer" src="/eventos/{{ evento.id }}/flayer?v={{ evento.flayer.tamano }}" alt="{{ evento.titulo }}" />
      {% endif %}
      {% if evento.descripcion %}<p class="evento-encabezado__descripcion">{{ evento.descripcion }}</p>{% endif %}
    </header>

    {% if duplicado %}
      <div class="card">
        <p class="alert alert--ok">Ya estás registrado en este evento. Te esperamos.</p>
        <p class="muted">
          El acceso se envía al correo o al WhatsApp que registraste. Si es por correo, revisa también spam o correo no deseado.
        </p>
        {% if valores.email %}
          <button type="button" class="btn btn--secondary" data-reenviar-link data-evento-id="{{ evento.id }}" data-correo="{{ valores.email }}">
            Reenviarme el acceso
          </button>
          <p id="reenviar-link-mensaje" class="muted"></p>
        {% endif %}
      </div>
    {% elif evento.abiertoARegistro %}
      <div class="card">
        {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}
        <form method="post" action="/eventos/{{ evento.id }}" class="form" data-form-registro-evento>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

          <fieldset class="evento-seccion">
            <legend>Tus datos</legend>
            <div class="evento-campos">
              <label class="field"><span>Nombre completo</span>
                <input name="nombre" value="{{ valores.nombre }}" autocomplete="name" required />
                {% if errores.nombre %}<em class="field__error">{{ errores.nombre }}</em>{% endif %}
              </label>
              <label class="field"><span>Empresa u organización</span>
                <input name="empresa" value="{{ valores.empresa }}" autocomplete="organization" />
              </label>
              <label class="field"><span>Correo electrónico</span>
                <input type="email" name="email" value="{{ valores.email }}" autocomplete="email" placeholder="tu@correo.com" />
                {% if errores.email %}<em class="field__error">{{ errores.email }}</em>{% endif %}
              </label>
              <label class="field"><span>Teléfono</span>
                <input type="tel" inputmode="tel" name="telefono" value="{{ valores.telefono }}" autocomplete="tel" placeholder="55 1234 5678" />
                {% if errores.telefono %}<em class="field__error">{{ errores.telefono }}</em>{% endif %}
              </label>
              <p class="evento-nota">Indica al menos uno de los dos, correo o teléfono: por ese medio te enviamos el acceso.</p>
            </div>
          </fieldset>

          <fieldset class="evento-seccion">
            <legend>Tu asistencia</legend>
            <div class="evento-campos">
              <label class="field"><span>¿Asistirás?</span>
                <select name="asistira" required>
                  <option value="">Selecciona una opción</option>
                  <option value="Sí" {{ 'selected' if valores.asistira == 'Sí' }}>Sí, ahí estaré</option>
                  <option value="No" {{ 'selected' if valores.asistira == 'No' }}>No podré asistir</option>
                  <option value="Tal vez" {{ 'selected' if valores.asistira == 'Tal vez' }}>Aún no estoy seguro</option>
                </select>
              </label>
              {% if evento.sistema %}
                <label class="field"><span>¿Actualmente utilizas {{ evento.sistema }}?</span>
                  <select name="usaSistema" required>
                    <option value="">Selecciona una opción</option>
                    <option value="Sí" {{ 'selected' if valores.usaSistema == 'Sí' }}>Sí, lo utilizo</option>
                    <option value="No" {{ 'selected' if valores.usaSistema == 'No' }}>No lo utilizo</option>
                  </select>
                </label>
              {% endif %}
            </div>
          </fieldset>

          <fieldset class="evento-seccion">
            <legend>Para conocerte mejor</legend>
            <div class="evento-campos evento-campos--una">
              <label class="field"><span>¿Cómo te enteraste del evento?</span>
                <select name="fuente">
                  <option value="">Selecciona una opción</option>
                  {% for f in ['Facebook', 'Instagram', 'LinkedIn', 'WhatsApp', 'Recomendación de un conocido', 'Correo electrónico', 'Página web', 'Otro'] %}
                    <option {{ 'selected' if valores.fuente == f }}>{{ f }}</option>
                  {% endfor %}
                </select>
              </label>
              <label class="field--check">
                <input type="checkbox" name="deseaCanalWhatsapp" {{ 'checked' if valores.deseaCanalWhatsapp }} />
                <span>Quiero unirme al canal de WhatsApp para recibir avisos y novedades.</span>
              </label>
            </div>
          </fieldset>

          {% if turnstileSiteKey %}
            <div class="field evento-captcha">
              <span>Verificación de seguridad</span>
              <div class="cf-turnstile" data-sitekey="{{ turnstileSiteKey }}" data-action="registro_evento"></div>
              <span class="evento-captcha__ayuda">Confirma que eres una persona. Es necesaria para completar el registro.</span>
              {% if errores.captcha %}<em class="field__error">{{ errores.captcha }}</em>{% endif %}
            </div>
          {% endif %}

          <button class="btn evento-enviar" type="submit">Confirmar mi registro</button>
          <p class="evento-pie">Usaremos tus datos únicamente para darte acceso a este evento y darte seguimiento.</p>
        </form>
      </div>
    {% else %}
      <div class="card">
        {# Decir por qué: "no disponible" a secas deja al visitante sin saber si esperar o no. #}
        {% if evento.estado == 'cancelado' %}
          <p class="alert alert--error">Este evento fue cancelado.</p>
        {% elif evento.yaPaso %}
          <p class="alert">Este evento ya se llevó a cabo. <a href="/eventos">Consulta los próximos eventos</a>.</p>
        {% else %}
          <p class="alert">El registro para este evento todavía no está abierto. <a href="/eventos">Consulta los próximos eventos</a>.</p>
        {% endif %}
        {% if user and can('eventos:gestionar') %}
          <p class="muted">
            Lo estás viendo como staff: el evento está en <strong>{{ evento.estado }}</strong>.
            Para abrir el registro, ponlo en <strong>publicado</strong> desde
            <a href="/app/eventos/{{ evento.id }}/editar">Editar evento</a>.
          </p>
        {% endif %}
      </div>
    {% endif %}
  {% endif %}
</div>
{% endblock %}
