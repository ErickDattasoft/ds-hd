{% extends "layouts/public-page.njk" %}
{% block title %}{{ evento.titulo if evento else 'Evento' }}{% endblock %}
{% block head %}
  {% if turnstileSiteKey %}<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>{% endif %}
{% endblock %}
{% block content %}
  {% if not evento %}
    <h1>Evento no encontrado</h1>
  {% elif registrado %}
    <h1>¡Registro confirmado!</h1>
    <p>Te enviamos un correo con los detalles de <strong>{{ evento.titulo }}</strong>.</p>
  {% else %}
    <h1>{{ evento.titulo }}</h1>
    {% if evento.flayer %}
      <img src="/eventos/{{ evento.id }}/flayer?v={{ evento.flayer.tamano }}" alt="{{ evento.titulo }}" style="max-width:100%" />
    {% endif %}
    <p class="muted">{{ evento.fechaHora | fechahora }}</p>
    {% if evento.descripcion %}<p>{{ evento.descripcion }}</p>{% endif %}

    {% if duplicado %}
      <p class="alert alert--ok">Ya estás registrado para este evento con estos datos. ¡Te esperamos!</p>
      <p class="muted">El link se envía al correo o WhatsApp que registraste — si es por correo, revisa también spam o correo no deseado.</p>
      {% if valores.email %}
        <button type="button" class="btn btn--secondary" data-reenviar-link data-evento-id="{{ evento.id }}" data-correo="{{ valores.email }}">🔁 No encuentro el correo, reenviármelo</button>
        <p id="reenviar-link-mensaje" class="muted"></p>
      {% endif %}
    {% elif evento.abiertoARegistro %}
      {% if errores.general %}<p class="alert alert--error">{{ errores.general }}</p>{% endif %}
      <form method="post" action="/eventos/{{ evento.id }}" class="form" data-form-registro-evento>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <label class="field"><span>Nombre</span><input name="nombre" value="{{ valores.nombre }}" required />
          {% if errores.nombre %}<em class="field__error">{{ errores.nombre }}</em>{% endif %}</label>
        <label class="field"><span>Empresa / Organización</span><input name="empresa" autocomplete="organization" value="{{ valores.empresa }}" /></label>
        <label class="field"><span>Correo electrónico</span><input type="email" name="email" autocomplete="email" placeholder="tu@correo.com" value="{{ valores.email }}" />
          {% if errores.email %}<em class="field__error">{{ errores.email }}</em>{% endif %}</label>
        <label class="field"><span>Teléfono</span><input type="tel" inputmode="tel" name="telefono" autocomplete="tel" placeholder="55 1234 5678" value="{{ valores.telefono }}" />
          {% if errores.telefono %}<em class="field__error">{{ errores.telefono }}</em>{% endif %}</label>
        <p class="muted">Ingresa al menos uno de los dos (correo o teléfono). Por ahí te mandamos el acceso al evento.</p>

        <label class="field"><span>¿Asistirás?</span>
          <select name="asistira" required>
            <option value="">— Selecciona —</option>
            <option value="Sí" {{ 'selected' if valores.asistira == 'Sí' }}>Sí, ahí estaré</option>
            <option value="No" {{ 'selected' if valores.asistira == 'No' }}>No podré, tal vez en otra ocasión</option>
            <option value="Tal vez" {{ 'selected' if valores.asistira == 'Tal vez' }}>Aún no estoy seguro/a</option>
          </select>
        </label>
        {% if evento.sistema %}
          <label class="field"><span>¿Actualmente utilizas {{ evento.sistema }}?</span>
            <select name="usaSistema" required>
              <option value="">— Selecciona —</option>
              <option value="Sí" {{ 'selected' if valores.usaSistema == 'Sí' }}>Sí, lo utilizo</option>
              <option value="No" {{ 'selected' if valores.usaSistema == 'No' }}>No lo utilizo</option>
            </select>
          </label>
        {% endif %}
        <label class="field"><span>¿Cómo te enteraste del evento?</span>
          <select name="fuente">
            <option value="">— Selecciona una opción —</option>
            {% for f in ['📘 Facebook', '📸 Instagram', '💼 LinkedIn', '💬 WhatsApp', '👥 Recomendación de un amigo', '✉️ Correo electrónico', '🌐 Página web', 'Otro'] %}
              <option {{ 'selected' if valores.fuente == f }}>{{ f }}</option>
            {% endfor %}
          </select>
        </label>
        <label class="field--check">
          <input type="checkbox" name="deseaCanalWhatsapp" {{ 'checked' if valores.deseaCanalWhatsapp }} />
          Quiero unirme al canal de WhatsApp para recibir avisos y novedades.
        </label>

        {% if turnstileSiteKey %}
          <div class="field">
            <span>Verificación de seguridad <span class="required">*</span></span>
            <div class="cf-turnstile" data-sitekey="{{ turnstileSiteKey }}" data-action="registro_evento"></div>
            <span class="muted">Es obligatoria: confirma que eres una persona y no un robot. Sin ella no podemos completar tu registro.</span>
            {% if errores.captcha %}<em class="field__error">{{ errores.captcha }}</em>{% endif %}
          </div>
        {% endif %}
        <button class="btn" type="submit">✅ Confirmar mi registro</button>
      </form>
    {% else %}
      {# Decir por qué: "no disponible" a secas deja al visitante sin saber si esperar o no. #}
      {% if evento.estado == 'cancelado' %}
        <p class="alert alert--error">Este evento fue cancelado.</p>
      {% elif evento.yaPaso %}
        <p class="alert">Este evento ya se llevó a cabo. <a href="/eventos">Ver los próximos eventos</a>.</p>
      {% else %}
        <p class="alert">El registro para este evento todavía no está abierto. <a href="/eventos">Ver los próximos eventos</a>.</p>
      {% endif %}
      {% if user and can('eventos:gestionar') %}
        <p class="muted">Lo estás viendo como staff: está en <strong>{{ evento.estado }}</strong>.
          Para que el público pueda registrarse, ponlo en <strong>publicado</strong> desde
          <a href="/app/eventos/{{ evento.id }}/editar">Editar evento</a>.</p>
      {% endif %}
    {% endif %}
  {% endif %}
{% endblock %}
