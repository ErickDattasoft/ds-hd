<!doctype html>
<html lang="es"{% if theme %} data-theme="{{ theme }}"{% endif %}{% if sidebarMini %} data-sidebar="mini"{% endif %}{% if user %} data-role="{{ user.rol }}"{% endif %}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#f6f7f9" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0e1116" media="(prefers-color-scheme: dark)" />
  <title>{% block title %}{{ titulo | default(appNombre) }}{% endblock %} · {{ appNombre }}</title>
  <link rel="icon" href="/logo" />
  <link rel="apple-touch-icon" href="/logo" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="{{ appNombre }}" />
  {% if area == 'portal' %}
    <link rel="manifest" href="/static/manifest-portal.json" />
  {% elif area == 'backoffice' %}
    <link rel="manifest" href="/static/manifest-staff.json" />
  {% endif %}
  <link rel="stylesheet" href="/static/build/tokens.css" />
  <link rel="stylesheet" href="/static/build/roles.css" />
  <link rel="stylesheet" href="/static/build/base.css" />
  <link rel="stylesheet" href="/static/build/components.css" />
  {% block head %}{% endblock %}
  <!-- Los scripts van en el <head> con defer, NO al final de <body>. El shell navega con
       hx-boost y hx-swap="innerHTML" sobre <body>: dentro del body, htmx los re-ejecutaba en
       cada navegación y los manejadores de eventos se iban acumulando (un clic llegaba a
       abrir cuatro veces el mismo confirm, y los botones de alternar se disparaban varias
       veces y quedaban como estaban). En el head sobreviven al intercambio y corren una vez.
       Con "defer" igual se ejecutan con el DOM ya construido. -->
  <script src="/static/vendor/htmx.min.js" defer></script>
  <script src="/static/vendor/htmx-preload.min.js" defer></script>
  <script src="/static/build/app.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  {% block body %}
  <main id="contenido" class="container">
    {% block content %}{% endblock %}
  </main>
  {% endblock %}

  {% if flash %}
  <div class="toasts" aria-live="polite">
    {% for f in flash %}<div class="toast toast--{{ f.tipo }}">{{ f.mensaje }}</div>{% endfor %}
  </div>
  {% endif %}

  {% if user %}
    <dialog id="logo-grande" class="logo-grande" aria-label="Logo en grande">
      <img data-logo-img src="/logo" alt="" />
    </dialog>
  {% endif %}

  <div id="barra-carga" class="barra-carga" aria-hidden="true"></div>
  {% block scripts %}{% endblock %}
</body>
</html>
