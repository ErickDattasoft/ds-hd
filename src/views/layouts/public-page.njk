{% extends "layouts/base.njk" %}
{% block body %}
<header class="pubbar">
  <a class="pubbar__brand" href="/">ds-hd</a>
  <nav aria-label="Secciones públicas">
    {# `navMinima`: páginas que son una landing, no parte del sitio público navegable — el link
       de registro a un evento se comparte en redes y no debe mandar al prospecto a otro lado
       (el CRM anterior servía esa página sin barra alguna). #}
    {% if not navMinima %}
      <a href="/kb">Base de conocimiento</a>
      <a href="/eventos">Eventos</a>
      <a href="/ticket-publico">Levantar ticket</a>
    {% endif %}
    {# Solo para quien ya trae sesión: un visitante no debe ver una puerta al CRM.
       `volverA` deja que la página diga a dónde se regresa — desde el registro a un evento se
       vuelve a ESE evento, que es de donde saliste, no al inicio. Un cliente del portal no
       tiene back-office, así que siempre va a /portal. #}
    {% if user %}
      <a href="{{ '/portal' if user.esCliente else (volverA or '/app') }}">← Volver al CRM</a>
    {% endif %}
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Cambiar tema">◐</button>
  </nav>
</header>
<main id="contenido" class="container">
  {% block content %}{% endblock %}
</main>
{% endblock %}
