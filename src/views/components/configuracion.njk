{# Links entre las subpáginas de Configuración. Siempre se ven todos; `activo` resalta la página actual. #}
{% macro nav(activo) %}
  {% for p in [
    ['tickets', '🎫 Tickets'],
    ['cotizaciones', '💰 Cotizaciones'],
    ['calculadora', '🧮 Calculadora'],
    ['apariencia', '🎨 Apariencia'],
    ['resumen', '📰 Resumen diario'],
    ['correo-entrante', '📥 Correo entrante'],
    ['integraciones', '🔌 Integraciones'],
    ['backup', '💾 Backup'],
    ['excel', '📊 Excel unificado']
  ] %}
  {% if activo == p[0] %}<a class="btn btn--secondary btn--sm" href="/app/configuracion/{{ p[0] }}" aria-current="page">{{ p[1] }}</a>
  {% else %}<a class="btn btn--ghost btn--sm" href="/app/configuracion/{{ p[0] }}">{{ p[1] }}</a>{% endif %}
  {% endfor %}
{% endmacro %}
