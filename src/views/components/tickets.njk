{% macro slaBadge(vm) %}
  {% if vm.slaEstado == 'vencido' %}<span class="badge badge--danger">{{ vm.slaTexto }}</span>
  {% elif vm.slaEstado == 'por-vencer' %}<span class="badge badge--warning">{{ vm.slaTexto }}</span>
  {% elif vm.slaEstado == 'na' %}<span class="badge">{{ vm.slaTexto }}</span>
  {% else %}<span class="badge badge--ok">{{ vm.slaTexto }}</span>{% endif %}
{% endmacro %}

{% macro agendaBadge(vm) %}
  {% if vm.agenda %}<span class="badge {{ 'badge--danger' if vm.agenda.vencida else 'badge--ok' }}" title="Atención programada">📅 {{ vm.agenda.texto }}</span>{% endif %}
{% endmacro %}

{% macro facturacionBadge(vm) %}
  {% if vm.facturacion.estado == 'facturado' %}<span class="badge badge--warning">{{ vm.facturacion.etiqueta }}</span>
  {% elif vm.facturacion.clase == 'warning' %}<span class="badge badge--danger">{{ vm.facturacion.etiqueta }}</span>
  {% else %}<span class="muted">{{ vm.facturacion.etiqueta }}</span>{% endif %}
{% endmacro %}

{% macro filaTicket(vm, csrfToken, puedeEliminar, puedeEditar) %}
  <tr>
    <td><a href="/app/tickets/{{ vm.id }}">#{{ vm.numero }}</a></td>
    <td>{{ vm.asunto }}{% if vm.agenda %}<br>{{ agendaBadge(vm) }}{% endif %}</td>
    <td>{{ vm.empresaNombre or '—' }}{% if vm.contactoNombre %}<br><span class="muted">{{ vm.contactoNombre }}</span>{% endif %}</td>
    <td>{{ vm.tipo }}{% if vm.sistema %}<br><span class="muted">{{ vm.sistema }}</span>{% endif %}</td>
    <td><span class="{{ vm.prioridad | prioridadClase }}">{{ vm.prioridad }}</span></td>
    <td><span class="{{ vm.estado | estadoClase }}">{{ vm.estado }}</span></td>
    <td>{{ facturacionBadge(vm) }}</td>
    <td>{{ vm.agenteAsignadoNombre or 'Sin asignar' }}</td>
    <td data-sort-value="{{ vm.abiertoEnIso }}">{{ vm.abiertoEnIso | fecha }}</td>
    <td>{{ slaBadge(vm) }}</td>
    <td class="col-acciones" data-no-ordenar>
      <a class="btn btn--ghost btn--sm" href="/app/tickets/{{ vm.id }}" title="Ver">👁</a>
      {% if puedeEditar %}<a class="btn btn--ghost btn--sm" href="/app/tickets/{{ vm.id }}/editar" title="Editar">✏️</a>{% endif %}
      {% if puedeEliminar %}
        <form method="post" action="/app/tickets/{{ vm.id }}/archivar" style="display:inline" data-confirm="¿Enviar este ticket a la papelera?">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <input type="hidden" name="archivar" value="true" />
          <button class="btn btn--ghost btn--sm" type="submit" title="Enviar a la papelera">🗑️</button>
        </form>
      {% endif %}
    </td>
  </tr>
{% endmacro %}

{#
  Sección de adjuntos de un ticket. `base` = prefijo de ruta ("/app/tickets/<id>" o
  "/portal/tickets/<id>"). `puedeEditar` habilita subir/quitar.
#}
{% macro adjuntosTicket(adjuntos, base, csrfToken, puedeEditar, puedeFijar=false) %}
  <div class="card" data-adjuntos data-adjuntos-base="{{ base }}">
    <p><strong>Adjuntos</strong> <span class="muted">— imágenes, PDF y XML, máx 700 KB c/u</span></p>
    <ul class="adjuntos-lista">
      {% for a in adjuntos %}
        <li>
          {% if a.contentType.startsWith('image/') %}
            <a href="{{ base }}/adjuntos/{{ a.id }}" target="_blank" rel="noopener">
              <img src="{{ base }}/adjuntos/{{ a.id }}" alt="{{ a.nombre }}" class="adjunto-thumb" loading="lazy" />
            </a>
          {% else %}
            📄 <a href="{{ base }}/adjuntos/{{ a.id }}" target="_blank" rel="noopener">{{ a.nombre }}</a>
          {% endif %}
          <span class="muted">{{ (a.tamano / 1024) | round }} KB{% if a.subidoPorNombre %} · {{ a.subidoPorNombre }}{% endif %}</span>
          {% if puedeFijar %}
            <form method="post" action="{{ base }}/adjuntos/{{ a.id }}/permanente" style="display:inline">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <input type="hidden" name="permanente" value="{{ '0' if a.permanente else '1' }}" />
              <button class="btn btn--ghost btn--sm" type="submit" style="opacity:{{ '1' if a.permanente else '.4' }}"
                      title="{{ 'Marcado como permanente — clic para desmarcar y poder eliminarlo' if a.permanente else 'Marcar como permanente (no se puede quitar y la limpieza de adjuntos no lo toca)' }}">{{ '📌' if a.permanente else '📍' }}</button>
            </form>
          {% elif a.permanente %}<span title="Permanente">📌</span>{% endif %}
          {% if puedeEditar %}
            {% if a.permanente %}
              <button class="btn btn--ghost btn--sm" type="button" disabled title="Desmarca 📌 permanente antes de poder eliminarlo" style="opacity:.3">✕</button>
            {% else %}
              <form method="post" action="{{ base }}/adjuntos/{{ a.id }}/eliminar" style="display:inline" data-confirm="¿Quitar este adjunto?">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <button class="btn btn--ghost btn--sm" type="submit" title="Quitar">✕</button>
              </form>
            {% endif %}
          {% endif %}
        </li>
      {% else %}
        <li class="muted">Sin adjuntos.</li>
      {% endfor %}
    </ul>
    {% if puedeEditar %}
      <label class="field">
        <span>Agregar archivo (o pega una imagen con Ctrl+V)</span>
        <input type="file" accept="image/png,image/jpeg,image/gif,image/webp,application/pdf,.xml,application/xml,text/xml" multiple data-adjunto-file />
      </label>
      <span class="muted" data-adjunto-resultado></span>
    {% endif %}
  </div>
{% endmacro %}

{#
  Barra de botones para el editor de descripción/nota de un ticket. Inserta el encabezado
  (plantilla del usuario o la por defecto, con [fecha]), la firma del usuario, o una imagen
  (que se sube como adjunto). `destino` = selector CSS del textarea.
#}
{% macro editorToolbar(user, destino, respuestas) %}
  <div class="editor-toolbar">
    {# Formato (como la barra del viejo). Solo aparece si el destino es el editor enriquecido. #}
    <span class="editor-toolbar__formato" data-formato-grupo data-destino="{{ destino }}" hidden>
      <button type="button" class="btn btn--ghost btn--sm" data-formato="bold" title="Negrita (Ctrl+B)"><b>B</b></button>
      <button type="button" class="btn btn--ghost btn--sm" data-formato="italic" title="Cursiva (Ctrl+I)"><i>I</i></button>
      <button type="button" class="btn btn--ghost btn--sm" data-formato="underline" title="Subrayado (Ctrl+U)"><u>U</u></button>
      <button type="button" class="btn btn--ghost btn--sm" data-formato="insertUnorderedList" title="Lista">• Lista</button>
      <button type="button" class="btn btn--ghost btn--sm" data-formato="insertOrderedList" title="Lista numerada">1. Lista</button>
      <button type="button" class="btn btn--ghost btn--sm" data-formato="fontSize" data-valor="5" title="Texto grande">A+</button>
      <button type="button" class="btn btn--ghost btn--sm" data-formato="fontSize" data-valor="2" title="Texto pequeño">A−</button>
    </span>
    <button type="button" class="btn btn--ghost btn--sm"
      data-insertar="encabezado" data-destino="{{ destino }}" data-texto="{{ user.encabezado or '' }}"
      title="Inserta tu encabezado (configúralo en Mi perfil) o la plantilla por defecto">📋 Encabezado</button>
    <button type="button" class="btn btn--ghost btn--sm"
      data-insertar="firma" data-destino="{{ destino }}" data-texto="{{ user.firma or '' }}"
      title="Inserta tu firma (configúrala en Mi perfil)">🖊️ Firma</button>
    <button type="button" class="btn btn--ghost btn--sm" data-insertar-imagen data-destino="{{ destino }}" title="Insertar/adjuntar una imagen">🖼️ Imagen</button>
    {% if respuestas and respuestas | length %}
      <select class="btn btn--ghost btn--sm" data-insertar-respuesta data-destino="{{ destino }}" aria-label="Insertar respuesta guardada">
        <option value="">💬 Respuesta…</option>
        {% for r in respuestas %}<option value="{{ r.texto }}">{{ r.titulo }}</option>{% endfor %}
      </select>
    {% endif %}
  </div>
{% endmacro %}

{% macro tablaTickets(tickets, csrfToken, puedeEliminar, puedeEditar) %}
  <table class="data-table">
    <thead>
      <tr>
        <th>#</th><th>Asunto</th><th>Empresa</th><th>Tipo</th><th>Prioridad</th><th>Estado</th>
        <th>Facturación</th><th>Agente</th><th>Creado</th><th>SLA</th><th data-no-ordenar></th>
      </tr>
    </thead>
    {# `preload` = al pasar el mouse sobre una fila se va cargando su detalle, para que
       el click abra al instante. Requiere el `Cache-Control` corto de `detalleView`. #}
    <tbody preload="mouseover">
      {% for vm in tickets %}{{ filaTicket(vm, csrfToken, puedeEliminar, puedeEditar) }}{% else %}
        <tr><td colspan="11" class="muted">📭 No hay tickets que mostrar.</td></tr>
      {% endfor %}
    </tbody>
  </table>
{% endmacro %}

{#
  Casillas de a quién del equipo le llega el recordatorio por WhatsApp (como el CRM viejo).
  `elegidos` = nombres ya marcados. Sin ninguna marcada se avisa a todo el equipo.
#}
{% macro destinatariosRecordatorio(equipo, elegidos) %}
  {% if equipo and equipo.length %}
    <div class="filterbar" style="margin-left:1.6rem">
      <span class="muted">Avisar a:</span>
      {% for n in equipo %}
        <label class="field--check"><input type="checkbox" name="agendaDestinatarios" value="{{ n }}" {{ 'checked' if elegidos and n in elegidos }} /> <span>{{ n }}</span></label>
      {% endfor %}
      <span class="muted">(ninguno marcado = todo el equipo)</span>
    </div>
  {% else %}
    <p class="muted" style="margin-left:1.6rem">Sin números de WhatsApp del equipo — configúralos en Configuración → Integraciones.</p>
  {% endif %}
{% endmacro %}
