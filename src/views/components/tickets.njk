{% macro slaBadge(vm) %}
  {% if vm.slaEstado == 'vencido' %}<span class="badge badge--danger">{{ vm.slaTexto }}</span>
  {% elif vm.slaEstado == 'por-vencer' %}<span class="badge badge--warning">{{ vm.slaTexto }}</span>
  {% elif vm.slaEstado == 'na' %}<span class="badge">{{ vm.slaTexto }}</span>
  {% else %}<span class="badge badge--ok">{{ vm.slaTexto }}</span>{% endif %}
{% endmacro %}

{% macro agendaBadge(vm) %}
  {% if vm.agenda %}<span class="badge {{ 'badge--danger' if vm.agenda.vencida else 'badge--ok' }}" title="Atención programada">📅 {{ vm.agenda.texto }}</span>{% endif %}
{% endmacro %}

{% macro filaTicket(vm) %}
  <tr>
    <td><a href="/app/tickets/{{ vm.id }}">#{{ vm.numero }}</a></td>
    <td>{{ vm.asunto }}{% if vm.agenda %}<br>{{ agendaBadge(vm) }}{% endif %}</td>
    <td><span class="badge badge--estado">{{ vm.estado }}</span></td>
    <td>{{ vm.prioridad }}</td>
    <td>{{ vm.empresaNombre or '—' }}</td>
    <td>{{ vm.agenteAsignadoNombre or 'Sin asignar' }}</td>
    <td>{{ slaBadge(vm) }}</td>
  </tr>
{% endmacro %}

{#
  Sección de adjuntos de un ticket. `base` = prefijo de ruta ("/app/tickets/<id>" o
  "/portal/tickets/<id>"). `puedeEditar` habilita subir/quitar.
#}
{% macro adjuntosTicket(adjuntos, base, csrfToken, puedeEditar) %}
  <div class="card" data-adjuntos data-adjuntos-base="{{ base }}">
    <p><strong>Adjuntos</strong> <span class="muted">— imágenes y PDF, máx 700 KB c/u</span></p>
    <ul class="adjuntos-lista">
      {% for a in adjuntos %}
        <li>
          {% if a.contentType.startsWith('image/') %}
            <a href="{{ base }}/adjuntos/{{ a.id }}" target="_blank" rel="noopener">
              <img src="{{ base }}/adjuntos/{{ a.id }}" alt="{{ a.nombre }}" class="adjunto-thumb" loading="lazy" />
            </a>
          {% else %}
            📄 <a href="{{ base }}/adjuntos/{{ a.id }}" target="_blank" rel="noopener">{{ a.nombre }}</a>
          {% endif %}
          <span class="muted">{{ (a.tamano / 1024) | round }} KB{% if a.subidoPorNombre %} · {{ a.subidoPorNombre }}{% endif %}</span>
          {% if puedeEditar %}
            <form method="post" action="{{ base }}/adjuntos/{{ a.id }}/eliminar" style="display:inline" data-confirm="¿Quitar este adjunto?">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <button class="btn btn--ghost btn--sm" type="submit" title="Quitar">✕</button>
            </form>
          {% endif %}
        </li>
      {% else %}
        <li class="muted">Sin adjuntos.</li>
      {% endfor %}
    </ul>
    {% if puedeEditar %}
      <label class="field">
        <span>Agregar archivo (o pega una imagen con Ctrl+V)</span>
        <input type="file" accept="image/png,image/jpeg,image/gif,image/webp,application/pdf" multiple data-adjunto-file />
      </label>
      <span class="muted" data-adjunto-resultado></span>
    {% endif %}
  </div>
{% endmacro %}

{#
  Barra de botones para el editor de descripción/nota de un ticket. Inserta el encabezado
  (plantilla del usuario o la por defecto, con [fecha]), la firma del usuario, o una imagen
  (que se sube como adjunto). `destino` = selector CSS del textarea.
#}
{% macro editorToolbar(user, destino) %}
  <div class="editor-toolbar">
    <button type="button" class="btn btn--ghost btn--sm"
      data-insertar="encabezado" data-destino="{{ destino }}" data-texto="{{ user.encabezado or '' }}"
      title="Inserta tu encabezado (configúralo en Mi perfil) o la plantilla por defecto">📋 Encabezado</button>
    <button type="button" class="btn btn--ghost btn--sm"
      data-insertar="firma" data-destino="{{ destino }}" data-texto="{{ user.firma or '' }}"
      title="Inserta tu firma (configúrala en Mi perfil)">🖊️ Firma</button>
    <button type="button" class="btn btn--ghost btn--sm" data-insertar-imagen title="Adjuntar una imagen">🖼️ Imagen</button>
  </div>
{% endmacro %}

{% macro tablaTickets(tickets) %}
  <table class="data-table">
    <thead>
      <tr><th>#</th><th>Asunto</th><th>Estado</th><th>Prioridad</th><th>Empresa</th><th>Agente</th><th>SLA</th></tr>
    </thead>
    <tbody>
      {% for vm in tickets %}{{ filaTicket(vm) }}{% else %}
        <tr><td colspan="7" class="muted">Sin tickets.</td></tr>
      {% endfor %}
    </tbody>
  </table>
{% endmacro %}
