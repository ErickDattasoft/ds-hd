{% macro _activo(href) %}
  {%- if href == '/app' or href == '/portal' -%}
    {{ 'is-active' if currentPath == href }}
  {%- else -%}
    {{ 'is-active' if currentPath.startsWith(href) }}
  {%- endif -%}
{% endmacro %}
<nav class="sidebar" aria-label="Navegación principal" id="menu-lateral">
  <div class="sidebar__brand">
    <button type="button" class="sidebar__logo-btn" data-logo-agrandar title="Ver logo en grande" aria-label="Ver logo en grande">
      <img data-logo-img src="/logo" alt="" />
    </button>
    <a class="sidebar__text" href="{{ '/portal' if area == 'portal' else '/app' }}">{{ appNombre }}</a>
  </div>
  {% for seccion in navSecciones %}
    <ul class="sidebar__list" aria-label="{{ seccion.etiqueta }}">
      {% if navSecciones.length > 1 %}
        <li class="sidebar__section" aria-hidden="true">{{ seccion.etiqueta }}</li>
      {% endif %}
      {% for item in seccion.items %}
        {% set cls = _activo(item.href) | trim %}
        <li>
          <a class="sidebar__link {{ cls }}" href="{{ item.href }}" title="{{ item.etiqueta }}"{% if cls %} aria-current="page"{% endif %}>
            <span class="sidebar__icon" aria-hidden="true">{{ item.icono }}</span><span class="sidebar__text">{{ item.etiqueta }}</span>
            {% if item.contador %}<span class="badge sidebar__badge">{{ item.contador }}</span>{% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endfor %}
  {% if area == 'backoffice' or area == 'portal' %}
    {% set manualHref = '/app/manual' if area == 'backoffice' else '/portal/manual' %}
    <ul class="sidebar__list sidebar__list--footer">
      <li>
        <a class="sidebar__link {{ 'is-active' if currentPath == manualHref }}" href="{{ manualHref }}">
          <span class="sidebar__icon" aria-hidden="true">📖</span><span class="sidebar__text">Manual de uso</span>
        </a>
      </li>
      {% if area == 'backoffice' %}
        <li>
          <a class="sidebar__link {{ 'is-active' if currentPath == '/app/acerca-de' }}" href="/app/acerca-de">
            <span class="sidebar__icon" aria-hidden="true">ℹ️</span><span class="sidebar__text">Acerca de</span>
          </a>
        </li>
      {% endif %}
    </ul>
  {% endif %}
</nav>
