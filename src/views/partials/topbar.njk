<header class="topbar">
  <div class="topbar__user" style="gap: var(--space-2)">
    <button type="button" class="btn btn--ghost btn--sm nav-toggle" data-nav-toggle aria-label="Abrir menú" aria-controls="menu-lateral">☰</button>
    <span class="topbar__title">{{ titulo }}</span>
  </div>
  <div class="topbar__user">
    {% if area == 'backoffice' %}
      <button type="button" class="btn btn--ghost btn--sm" data-busqueda-abrir title="Buscar (Ctrl/Cmd+K)">🔎 <span class="busqueda-global__atajo">Ctrl K</span></button>
    {% endif %}
    {% if can('tickets:crear') %}<a class="btn btn--sm" href="/app/tickets/nuevo" title="Crear un ticket nuevo — funciona desde cualquier sección">➕ Ticket</a>{% endif %}
    {% if can('configuracion:integraciones') %}<a class="btn btn--ghost btn--sm" href="/app/configuracion/backup/descargar" title="Descargar backup completo — funciona desde cualquier sección">🛡️ Respaldar</a>{% endif %}
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Cambiar tema">◐</button>
    {% if user %}
      {% if area == 'backoffice' %}
        <a class="topbar__name" href="/app/mi-perfil" title="Mi perfil (firma)">{{ user.nombre }}</a>
      {% else %}
        <span class="topbar__name">{{ user.nombre }}</span>
      {% endif %}
      <span class="badge badge--rol">{{ user.rol }}</span>
      <form method="post" action="/logout" class="inline">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <button type="submit" class="btn btn--ghost btn--sm">Salir</button>
      </form>
    {% endif %}
  </div>
</header>

{% if area == 'backoffice' %}
  <dialog id="busqueda-global" class="busqueda-global">
    <form method="dialog" class="busqueda-global__form">
      <input
        type="search"
        name="q"
        placeholder="Buscar empresas, contactos, tickets, base de conocimiento…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Buscar"
        hx-get="/app/buscar"
        hx-trigger="input changed delay:300ms, search"
        hx-target="#busqueda-global-resultados"
        hx-swap="innerHTML"
      />
    </form>
    <div id="busqueda-global-resultados" class="busqueda-global__resultados"></div>
  </dialog>
{% endif %}
