# ─── Aplicación ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Secreto para firmar/validar la cookie de sesión y el token CSRF (>= 32 caracteres).
SESSION_COOKIE_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# ─── Firebase (proyecto NUEVO, aislado del CRM actual) ─────────────────────────
FIREBASE_PROJECT_ID=ds-hd-xxxxx
# API key web — solo se usa para el sign-in por REST (Identity Toolkit).
FIREBASE_API_KEY=
# Service account del proyecto nuevo, JSON completo codificado en base64.
# Alternativa: GOOGLE_APPLICATION_CREDENTIALS apuntando a /run/secrets/firebase-sa.json
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_STORAGE_BUCKET=ds-hd-xxxxx.appspot.com

# Emuladores de Firebase para desarrollo/tests (déjalos vacíos en producción).
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# ─── Correo ───────────────────────────────────────────────────────────────────
# Prioridad: SMTP_HOST (si se define) > BREVO_API_KEY > log (no envía nada).
# Dev: SMTP_HOST=mailhog SMTP_PORT=1025 (ver docker-compose).
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=
BREVO_SENDER_NAME=Soporte DATTASOFT
BREVO_SENDER_EMAIL=soporte@dattasoft.mx

# ─── Automatización (n8n) ─────────────────────────────────────────────────────
N8N_WEBHOOK_TICKETS=
N8N_WEBHOOK_COTIZACIONES=

# ─── Anti-bot (Cloudflare Turnstile) para formularios públicos ────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ─── Jobs / cron (bearer que protege /jobs/*) ────────────────────────────────
JOBS_SECRET=cambia-esto
